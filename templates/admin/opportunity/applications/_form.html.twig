    </style>
    
    <div class="form-group">
        {{ form_label(form.type_request) }}
        {{ form_widget(form.type_request, {'attr': {'class': 'form-control'}}) }}
        <div class="error-feedback" id="error-{{ form.type_request.vars.id }}"></div>
    </div>

    <div class="form-group">
        {{ form_label(form.titre) }}
        {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
        <div class="error-feedback" id="error-{{ form.titre.vars.id }}"></div>
    </div>
    
    <div class="form-group">
        {{ form_label(form.domaine) }}
        {{ form_widget(form.domaine, {'attr': {'class': 'form-control'}}) }}
        <div class="error-feedback" id="error-{{ form.domaine.vars.id }}"></div>
    </div>
    
    <div class="form-group">
        {{ form_label(form.description) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
        <div class="error-feedback" id="error-{{ form.description.vars.id }}"></div>
    </div>

    <div class="form-group">
        {{ form_label(form.competences) }}
        {{ form_widget(form.competences, {'attr': {'class': 'form-control'}}) }}
