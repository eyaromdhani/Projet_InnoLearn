        /* Custom File Upload Styles */
        .file-upload-wrapper { position: relative; cursor: pointer; }
        .file-upload-surrogate {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 1rem;
            background: #f8fafc;
            border: 2px dashed #e2e8f0;
            border-radius: 8px;
