{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier Quiz{% endblock %}

{% block admin_content %}
<div class="card animate-fade-in-up">
    <div class="card-header">
        <h3 class="card-title">Modifier le quiz : {{ formulaire.titre }}</h3>
    </div>
    <div class="card-body">
        {{ include('admin/quiz/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>
</div>

<div style="display: flex; gap: 1rem; margin-top: 1rem;">
    <a href="{{ path('admin_quiz_index') }}" class="btn-secondary" style="text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px;">
        Retour à la liste
    </a>
    {{ include('admin/quiz/_delete_form.html.twig') }}
</div>
{% endblock %}
