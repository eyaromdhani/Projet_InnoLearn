/* Waves */
.hero-waves {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 5;
    overflow: hidden;
}

.hero-waves .wave {
    position: relative;
    display: block;
    width: 200%;
    height: 70px;
    animation: waveMove 15s cubic-bezier(.55,.5,.45,.5) infinite;
}

.hero-waves .wave-1 {
    height: 90px;
    margin-bottom: -70px;
    opacity: 0.3;
    animation-duration: 7s;
    animation-direction: reverse;
}

.hero-waves .wave-2 {
    height: 80px;
    margin-bottom: -50px;
    opacity: 0.5;
    animation-duration: 10s;
}

.hero-waves .wave-3 { 
    fill: #f8fafc; 
    height: 60px;
    animation-duration: 13s;
}

