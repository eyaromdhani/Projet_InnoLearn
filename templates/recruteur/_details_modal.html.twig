<div class="modal-details-header" style="margin-bottom: 2rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 1.5rem;">
    <h2 style="font-size: 1.8rem; font-weight: 800; color: #1e293b; margin-bottom: 0.5rem;">{{ condidature.titre|upper }}</h2>
    <p style="color: #64748b; font-weight: 600; margin-bottom: 1rem;">
        <i class="fas fa-user-graduate" style="color: #a855f7;"></i> {{ condidature.idEtudiant.name }} (ID: {{ condidature.idEtudiant.id }})
    </p>
    <div style="display: flex; gap: 1.5rem; color: #64748b; font-size: 0.95rem;">
        <span><i class="fas fa-tag" style="color: #6366f1;"></i> {{ condidature.domaine }}</span>
        <span><i class="fas fa-calendar-alt" style="color: #6366f1;"></i> {{ condidature.datePublication|date('d/m/Y') }}</span>
        <span class="badge" style="background: rgba(99, 102, 241, 0.1); color: #6366f1; padding: 0.25rem 0.75rem; border-radius: 20px; font-weight: 700;">{{ condidature.statut }}</span>
    </div>
</div>

<div class="modal-details-body" style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
    <div class="details-section">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #334155; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-align-left" style="color: #a855f7;"></i> Description
        </h3>
        <p style="color: #475569; line-height: 1.6; font-size: 0.95rem;">{{ condidature.description }}</p>
    </div>

    <div class="details-section">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #334155; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-tools" style="color: #a855f7;"></i> Compétences
        </h3>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            {% for skill in condidature.competences|split(',') %}
                <span style="background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; padding: 0.4rem 0.8rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">{{ skill|trim }}</span>
            {% endfor %}
        </div>
    </div>

    <div class="details-section" style="grid-column: span 2;">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #334155; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-brain" style="color: #6366f1;"></i> Analyse de Matching IA
        </h3>
        <div id="aiMatchContainer" style="background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%); border-radius: 20px; padding: 1.5rem; border: 1px solid #e2e8f0; position: relative; overflow: hidden;">
            <div id="aiMatchInitial">
                <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1rem;">Analysez la compatibilité de ce candidat avec l'offre sélectionnée.</p>
                {% if condidature.idOffre %}
                    <button class="btn-primary-gradient" style="margin-top: 0; font-size: 0.9rem;" onclick="runAiMatch({{ condidature.id }})">
                        <i class="fas fa-magic"></i> Lancer l'analyse IA
                    </button>
                {% else %}
                    <p style="color: #ef4444; font-size: 0.85rem; font-weight: 600;"><i class="fas fa-exclamation-triangle"></i> Veuillez d'abord associer cette candidature à une offre.</p>
                {% endif %}
            </div>
            <div id="aiMatchLoading" style="display: none; text-align: center; padding: 1rem;">
                <i class="fas fa-spinner fa-spin" style="font-size: 1.5rem; color: #6366f1;"></i>
                <p style="margin-top: 0.5rem; color: #64748b; font-size: 0.9rem;">Calcul du score en cours...</p>
            </div>
            <div id="aiMatchResult" style="display: none;">
                <div style="display: flex; align-items: center; gap: 2rem; margin-bottom: 1rem;">
                    <div style="position: relative; width: 80px; height: 80px;">
                        <svg viewBox="0 0 36 36" style="width: 100%; height: 100%;">
                            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e2e8f0" stroke-width="3" />
                            <path id="matchCircle" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#6366f1" stroke-width="3" stroke-dasharray="0, 100" />
                        </svg>
                        <div id="matchScoreValue" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1.25rem; font-weight: 800; color: #1e293b;">0%</div>
                    </div>
                    <div>
                        <h4 id="matchTitle" style="font-size: 1.1rem; font-weight: 700; color: #1e293b; margin-bottom: 0.25rem;">Excellente correspondance</h4>
                        <p id="matchExplanation" style="color: #64748b; font-size: 0.9rem; line-height: 1.4;"></p>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div style="background: rgba(16, 185, 129, 0.1); padding: 0.75rem; border-radius: 12px;">
                        <span style="font-size: 0.75rem; font-weight: 800; color: #059669; text-transform: uppercase;">Points Forts</span>
                        <ul id="matchStrengths" style="margin: 0.5rem 0 0; padding-left: 1.25rem; font-size: 0.85rem; color: #065f46;"></ul>
                    </div>
                    <div style="background: rgba(245, 158, 11, 0.1); padding: 0.75rem; border-radius: 12px;">
                        <span style="font-size: 0.75rem; font-weight: 800; color: #d97706; text-transform: uppercase;">Points à Vérifier</span>
                        <ul id="matchWeaknesses" style="margin: 0.5rem 0 0; padding-left: 1.25rem; font-size: 0.85rem; color: #92400e;"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="details-section" style="grid-column: span 2;">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #334155; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-envelope-open-text" style="color: #a855f7;"></i> Lettre de Motivation
        </h3>
        <div style="background: #f8fafc; border-radius: 15px; padding: 1.5rem; border: 1px dashed #cbd5e1; color: #475569; line-height: 1.6; font-style: italic;">
            "{{ condidature.lettreMotivation }}"
        </div>
    </div>
</div>

<div class="modal-details-footer" style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 2px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 1rem; flex-wrap: wrap;">
    <button class="btn-primary-gradient" style="margin-top: 0; background: #f1f5f9; color: #475569; box-shadow: none;" onclick="closeDetailsModal()">Fermer</button>
    
    {% if condidature.statut == 'en_attente' %}
        {% if condidature.typeRequest == 'demande' %}
            <div style="display: flex; gap: 0.5rem; align-items: center; background: #f1f5f9; padding: 0.5rem 1rem; border-radius: 12px; margin-right: auto;">
                <select id="associateOfferSelect" style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.4rem; font-size: 0.85rem; background: white; outline: none;">
                    <option value="">Sélectionner une offre...</option>
                    {% for offer in my_offers %}
                        <option value="{{ offer.id }}">{{ offer.titre }}</option>
                    {% endfor %}
                </select>
                <button class="btn-primary-gradient" style="margin-top: 0; padding: 0.5rem 1rem; font-size: 0.85rem;" onclick="associateToOffer({{ condidature.id }})">
                    <i class="fas fa-link"></i> Associer
                </button>
            </div>
        {% endif %}

        <button class="btn-primary-gradient" style="margin-top: 0; background: #ef4444; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);" onclick="updateCandidatureStatus({{ condidature.id }}, 'refusée')">
            <i class="fas fa-times-circle"></i> Refuser
        </button>
        <button class="btn-primary-gradient" style="margin-top: 0; background: linear-gradient(135deg, #10b981 0%, #059669 100%);" onclick="updateCandidatureStatus({{ condidature.id }}, 'acceptée')">
            <i class="fas fa-check-circle"></i> Accepter
        </button>
    {% endif %}

    <a href="{{ asset('uploads/cv/' ~ condidature.cv) }}" target="_blank" class="btn-primary-gradient" style="margin-top: 0; text-decoration: none;">
        <i class="fas fa-file-pdf"></i> Voir CV
    </a>
</div>
