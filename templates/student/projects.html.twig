async function suggestAI(type) {
    const keywordsInput = document.getElementById('aiKeywords');
    const keywords = keywordsInput.value.trim();
    
    if (!keywords) {
        alert('Veuillez entrer quelques mots-clés pour aider l\'IA.');
        return;
