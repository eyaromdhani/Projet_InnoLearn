{% block page_javascripts %}
<script>
window.applyFilters = function() {
    const search = document.getElementById('backendSearch').value;
    const domaine = document.querySelector('#pageDomaineDropdown .active')?.getAttribute('data-value') || 'all';
    const sort = document.querySelector('#pageSortDropdown .active')?.getAttribute('data-value') || 'desc';
    const typeRequest = document.querySelector('input[name="type_request"]:checked')?.value || 'all';
    const idOffre = document.querySelector('#pageOfferDropdown .active')?.getAttribute('data-value') || '';
    const minDate = document.getElementById('minDateSlider').value;
    const maxDate = document.getElementById('maxDateSlider').value;
    
    const params = new URLSearchParams();
    if (search) params.set('searchbar', search);
    if (domaine !== 'all') params.set('domaine', domaine);
    if (sort !== 'desc') params.set('sort', sort);
    if (typeRequest !== 'all') params.set('type_request', typeRequest);
    if (idOffre) params.set('id_offre', idOffre);
    params.set('min_date', minDate);
    params.set('max_date', maxDate);
    
    const url = `${window.location.pathname}?${params.toString()}`;
    
    // Update URL without refresh
    window.history.pushState({path: url}, '', url);
    
    // Smooth transition
    const grid = document.getElementById('jobGrid');
    if (grid) grid.style.opacity = '0.5';

    fetch(url, {
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.text())
    .then(html => {
        if (grid) {
            grid.innerHTML = html;
            grid.style.opacity = '1';
        }
    });
};

// Debounce function
window.debounce = function(func, wait) {
    let timeout;
    return function() {
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(this, arguments), wait);
    };
};

window.debouncedFilter = window.debounce(window.applyFilters, 300);

document.addEventListener('DOMContentLoaded', function() {
    // Add dynamic listeners
    const searchInput = document.getElementById('backendSearch');
    if (searchInput) searchInput.addEventListener('input', window.debouncedFilter);
    
    // Dropdown Logic
    document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
        toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const parent = toggle.closest('.custom-dropdown');
            document.querySelectorAll('.custom-dropdown').forEach(d => { if(d !== parent) d.classList.remove('active'); });
            parent.classList.toggle('active');
        });
    });

    document.querySelectorAll('.dropdown-opt').forEach(opt => {
        opt.addEventListener('click', () => {
            const parent = opt.closest('.custom-dropdown');
            parent.querySelectorAll('.dropdown-opt').forEach(o => o.classList.remove('active'));
            opt.classList.add('active');
            const span = parent.querySelector('.dropdown-toggle span:not(.fas)');
            if (span) span.textContent = opt.textContent;
            parent.classList.remove('active');
            window.applyFilters();
        });
    });

    document.addEventListener('click', () => { 
        document.querySelectorAll('.custom-dropdown').forEach(d => d.classList.remove('active')); 
    });

    // Slider Logic
    const minSlider = document.getElementById('minDateSlider');
    const maxSlider = document.getElementById('maxDateSlider');
    const minLabel = document.getElementById('minDateLabel');
    const maxLabel = document.getElementById('maxDateLabel');

    function formatDate(timestamp) {
        const d = new Date(timestamp * 1000);
        return d.toLocaleDateString('fr-FR');
    }

    if (minSlider && maxSlider) {
        minSlider.oninput = () => {
            if (parseInt(minSlider.value) > parseInt(maxSlider.value)) minSlider.value = maxSlider.value;
            if (minLabel) minLabel.textContent = formatDate(minSlider.value);
            minSlider.style.zIndex = "3";
            maxSlider.style.zIndex = "2";
            window.debouncedFilter();
        };

        maxSlider.oninput = () => {
            if (parseInt(maxSlider.value) < parseInt(minSlider.value)) maxSlider.value = minSlider.value;
            if (maxLabel) maxLabel.textContent = formatDate(maxSlider.value);
            maxSlider.style.zIndex = "3";
            minSlider.style.zIndex = "2";
            window.debouncedFilter();
        };
    }
});

function showDetails(id) {
    const modal = document.getElementById('detailsModal');
    const body = document.getElementById('detailsModalBody');
    if (modal) modal.style.display = 'block';
    
    fetch(`/recruteur/candidature/${id}/details`)
        .then(response => response.text())
        .then(html => {
            if (body) body.innerHTML = html;
        })
        .catch(err => {
            if (body) body.innerHTML = '<p style="color: red; padding: 2rem; text-align: center;">Erreur lors du chargement des détails.</p>';
        });
}

function closeDetailsModal() {
    const modal = document.getElementById('detailsModal');
    if (modal) modal.style.display = 'none';
}

// Close on click outside
window.onclick = function(event) {
    const modal = document.getElementById('detailsModal');
    if (event.target == modal) {
        closeDetailsModal();
    }
}

function updateCandidatureStatus(id, status) {
    if (!confirm(`Voulez-vous vraiment marquer cette candidature comme ${status} ?`)) return;

    fetch(`/recruteur/candidature/${id}/status/${status}`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            closeDetailsModal();
            window.applyFilters(); // Refresh the grid
        } else {
            alert('Erreur: ' + data.message);
        }
    })
    .catch(err => {
        alert('Une erreur est survenue lors de la mise à jour du statut.');
    });
}

function associateToOffer(id) {
    const offerId = document.getElementById('associateOfferSelect').value;
    if (!offerId) {
        alert('Veuillez sélectionner une offre.');
        return;
    }

    if (!confirm('Voulez-vous associer cette demande à l\'offre sélectionnée ?')) return;

    fetch(`/recruteur/candidature/${id}/associate/${offerId}`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            // Refresh details instead of closing to show AI Matching possible now
            showDetails(id);
            window.applyFilters(); // Refresh the grid
        } else {
            alert('Erreur: ' + data.message);
        }
    })
    .catch(err => {
        alert('Une erreur est survenue lors de l\'association.');
    });
}

window.runAiMatch = function(candidatureId) {
    const initial = document.getElementById('aiMatchInitial');
    const loading = document.getElementById('aiMatchLoading');
    const result = document.getElementById('aiMatchResult');
    
    initial.style.display = 'none';
    loading.style.display = 'block';
    result.style.display = 'none';
    
    fetch(`/recruteur/candidature/${candidatureId}/ai-match`)
        .then(res => res.json())
        .then(data => {
            if (data.score !== undefined) {
                // Update Score Circle and Values
                const score = data.score;
                document.getElementById('matchScoreValue').textContent = score + '%';
                document.getElementById('matchCircle').setAttribute('stroke-dasharray', `${score}, 100`);
                
                // Color mapping
                let color = '#ef4444'; // Red
                if (score >= 80) color = '#10b981'; // Green
                else if (score >= 50) color = '#6366f1'; // Blue/Indigo
                else if (score >= 30) color = '#f59e0b'; // Orange
                
                document.getElementById('matchCircle').setAttribute('stroke', color);
                
                // Update Title & Explanation
                document.getElementById('matchTitle').textContent = 
                    score >= 80 ? 'Excellente correspondance' : 
                    score >= 60 ? 'Bonne correspondance' : 
                    score >= 40 ? 'Correspondance moyenne' : 'Faible correspondance';
                
                document.getElementById('matchExplanation').textContent = data.explanation;
                
                // Update Strengths & Weaknesses
                const strengthsList = document.getElementById('matchStrengths');
                const weaknessesList = document.getElementById('matchWeaknesses');
                
                strengthsList.innerHTML = '';
                if (Array.isArray(data.strengths)) {
                    data.strengths.forEach(s => {
                        strengthsList.innerHTML += `<li>${s}</li>`;
                    });
                }
                
                weaknessesList.innerHTML = '';
                if (Array.isArray(data.weaknesses)) {
                    data.weaknesses.forEach(w => {
                        weaknessesList.innerHTML += `<li>${w}</li>`;
                    });
                }
                
                result.style.display = 'block';
            } else {
                alert('Erreur: ' + (data.message || 'Le service AI a retourné un format invalide.'));
                initial.style.display = 'block';
            }
        })
        .catch(err => {
            console.error(err);
            alert('Une erreur est survenue lors de l\'analyse IA.');
            initial.style.display = 'block';
        })
        .finally(() => {
            loading.style.display = 'none';
        });
};
</script>
{% endblock %}
