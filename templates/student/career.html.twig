    <!-- Details Modal (Offers) -->
    <div id="offerDetailsModal" style="display: none; position: fixed; z-index: 3000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(15, 23, 42, 0.8); backdrop-filter: blur(8px);">
        <div class="modal-content" style="background-color: #fff; margin: 5% auto; padding: 2.5rem; border-radius: 30px; width: 70%; max-width: 1000px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); position: relative; animation: slideIn 0.4s ease-out;">
            <div id="offerDetailsBody">
                <!-- Loaded via AJAX -->
            </div>
        </div>
    </div>

    <!-- Details Modal (Candidatures) -->
    <div id="candidatureDetailsModal" style="display: none; position: fixed; z-index: 3000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(15, 23, 42, 0.8); backdrop-filter: blur(8px);">
        <div class="modal-content" style="background-color: #fff; margin: 5% auto; padding: 2.5rem; border-radius: 30px; width: 70%; max-width: 1000px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); position: relative; animation: slideIn 0.4s ease-out;">
            <div id="candidatureDetailsBody">
                <!-- Loaded via AJAX -->
            </div>
        </div>
    </div>

    <!-- Create Candidature Modal -->
    <div id="createCandidatureModal" class="create-modal">
        <div class="create-modal-content">
            <div class="create-modal-header">
                <h2><i class="fas fa-plus-circle"></i> Créer une Demande</h2>
                <button class="close-btn" onclick="closeCreateCandidatureModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="createCandidatureForm">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label for="candidature_titre">Titre de la demande *</label>
                        <input type="text" id="candidature_titre" name="titre" placeholder="Ex: Stage en développement web" required>
                        <span class="form-error" id="error_titre"></span>
                    </div>
                    
                    <div class="form-group">
                        <label for="candidature_domaine">Domaine *</label>
                        <input type="text" id="candidature_domaine" name="domaine" placeholder="Ex: Informatique, Marketing..." required>
                        <span class="form-error" id="error_domaine"></span>
                    </div>
                    
                    <div class="form-group full-width">
                        <label>Votre CV (PDF) *</label>
                        <div class="cv-upload-container" id="cvUploadBox">
                            <input type="file" id="candidature_cv" name="cv" accept=".pdf" class="cv-file-input">
                            <div class="cv-upload-content">
                                <i class="fas fa-file-upload"></i>
                                <span id="cvFileName">Choisir un fichier PDF</span>
                                <small>Taille max: 5 Mo</small>
                            </div>
                            <button type="button" class="btn-remove-cv" onclick="removeCvFile(event)">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div id="profileCvStatus" style="display: none; margin-top: 0.5rem;">
                            <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #10b981; cursor: pointer;">
                                <input type="checkbox" id="useProfileCv" name="use_profile_cv" value="1">
                                <i class="fas fa-check-circle"></i> Utiliser le CV de mon profil
                            </label>
                        </div>
                        <span class="form-error" id="error_cv"></span>
                    </div>
                    
                    <div class="form-group full-width">
                        <label for="candidature_competences">Compétences *</label>
                        <textarea id="candidature_competences" name="competences" placeholder="Listez vos compétences clés séparées par des virgules..." required></textarea>
                        <span class="form-error" id="error_competences"></span>
                    </div>
                    
                    <div class="form-group full-width">
                        <label for="candidature_description">Description de votre profil *</label>
                        <textarea id="candidature_description" name="description" class="large" placeholder="Décrivez votre profil, vos motivations et ce que vous recherchez (min 20 caractères)..." required></textarea>
                        <span class="form-error" id="error_description"></span>
                    </div>
                    
                    <div class="form-group full-width">
                        <label for="candidature_lettre">Lettre de motivation *</label>
                        <textarea id="candidature_lettre" name="lettre_motivation" class="large" placeholder="Rédigez votre lettre de motivation (min 50 caractères)..." required></textarea>
                        <span class="form-error" id="error_lettre"></span>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn-cancel" onclick="closeCreateCandidatureModal()">Annuler</button>
                    <button type="submit" class="btn-submit" id="submitCandidatureBtn">
                        <i class="fas fa-paper-plane"></i> Soumettre la demande
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- CANDIDATURES Tab Content -->
    <section class="content-section tab-content {{ current_filters.tab == 'candidatures' ? 'active' : '' }}" id="candidatures-content">
