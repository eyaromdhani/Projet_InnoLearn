{% extends 'enseignant/layout.html.twig' %}

{% block title %}Nouveau Quiz - InnoLearn{% endblock %}

{% block page_stylesheets %}
<style>
.form-container {
    max-width: 800px;
    margin: 4rem auto;
    padding: 0 2rem;
}

.premium-card {
    background: white;
    border-radius: 30px;
    padding: 3rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
}

.form-title {
    font-size: 2rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
}

.form-title i {
    color: #6366f1;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-label {
    display: block;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
}

.form-control {
    width: 100%;
    padding: 0.8rem 1.2rem;
    border-radius: 12px;
    border: 2px solid #f1f5f9;
    background: #f8fafc;
    transition: all 0.3s;
    font-weight: 600;
}

.form-control:focus {
    border-color: #6366f1;
    background: white;
    outline: none;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
}

.btn-primary-gradient {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    border: none;
    padding: 1rem 2.5rem;
    border-radius: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-top: 1rem;
}

.btn-primary-gradient:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(99, 102, 241, 0.3);
}

.btn-secondary {
    background: #f1f5f9;
    color: #475569;
    text-decoration: none;
    padding: 1rem 2rem;
    border-radius: 15px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s;
}

.btn-secondary:hover {
    background: #e2e8f0;
}
</style>
{% endblock %}

{% block student_content %}
<div class="form-container">
    <div class="premium-card">
        <h1 class="form-title">
            <i class="fas fa-plus-circle"></i>
            Créer un Nouveau Quiz
        </h1>

        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Introduction au Design UI'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Décrivez les objectifs de ce quiz...'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.tempsLimite, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.tempsLimite, {'attr': {'class': 'form-control', 'placeholder': 'En minutes'}}) }}
                        {{ form_errors(form.tempsLimite) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.category, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.category, {'attr': {'class': 'form-control', 'placeholder': 'Ex: UI/UX, Backend...'}}) }}
                        {{ form_errors(form.category) }}
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a href="{{ path('app_enseignant_quizzes') }}" class="btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
                <button type="submit" class="btn-primary-gradient">
                    <i class="fas fa-check-circle"></i> Enregistrer le Quiz
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
