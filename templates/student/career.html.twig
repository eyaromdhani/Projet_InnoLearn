{% extends 'student/layout.html.twig' %}

{% block title %}Opportunités de Stage - InnoLearn{% endblock %}

{% block page_stylesheets %}
<style>
/* Make header transparent on this page */
.dashboard-header {
    position: absolute;
    width: 100%;
    background: transparent !important;
    backdrop-filter: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
    z-index: 1000;
}

.dashboard-header .header-brand,
.dashboard-header .nav-item,
.dashboard-header .icon-btn,
.dashboard-header .search-bar-compact i {
    color: white !important;
}

.dashboard-header .nav-item:hover,
.dashboard-header .nav-item.active {
    color: rgba(255,255,255,0.8) !important;
}

.dashboard-header .nav-item.active::after {
    background: white !important;
    box-shadow: 0 2px 4px rgba(255, 255, 255, 0.3) !important;
}

.dashboard-header .search-bar-compact {
    background: rgba(255, 255, 255, 0.15) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
}

.dashboard-header .search-bar-compact input {
    color: white !important;
}

.dashboard-header .search-bar-compact input::placeholder {
    color: rgba(255, 255, 255, 0.7) !important;
}


.dashboard-header .user-profile-toggle:hover {
    background: rgba(255, 255, 255, 0.1) !important;
}

/* Hero Section */
.career-hero {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    min-height: 550px;
    background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #6d28d9 100%);
    position: relative;
    display: flex;
    align-items: center;
    overflow: visible;
    padding-top: 100px;
    margin-bottom: 0;

}

.hero-content-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 10;
}

.hero-label {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    color: white;
    line-height: 1.1;
    margin-bottom: 1.5rem;
}

.hero-title span {
    background: linear-gradient(135deg, #ffb82b 0%, #f97316 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    display: inline-block;
}

/* Tab Navigation */
.tab-navigation {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.5rem;
    border-radius: 20px;
    width: fit-content;
    backdrop-filter: blur(10px);
}

.tab-btn {
    padding: 0.85rem 1.75rem;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 15px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.3s ease;
}

.tab-btn:hover {
    color: white;
    background: rgba(255, 255, 255, 0.1);
}

.tab-btn.active {
    background: white;
    color: #6366f1;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.tab-btn i {
    font-size: 1rem;
}


/* Waves */
.hero-waves {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 5;
    overflow: hidden;
}

.hero-waves .wave {
    position: relative;
    display: block;
    width: 200%;
    height: 70px;
    animation: waveMove 15s cubic-bezier(.55,.5,.45,.5) infinite;
}

.hero-waves .wave-1 {
    height: 90px;
    margin-bottom: -70px;
    opacity: 0.3;
    animation-duration: 7s;
    animation-direction: reverse;
}

.hero-waves .wave-2 {
    height: 80px;
    margin-bottom: -50px;
    opacity: 0.5;
    animation-duration: 10s;
}

.hero-waves .wave-3 { 
    fill: #f8fafc; 
    height: 60px;
    animation-duration: 13s;
}

@keyframes waveMove {
    0% { transform: translate3d(-50%, 0, 0); }
    50% { transform: translate3d(-25%, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
}

/* Visual Side */
.hero-visual { position: relative; display: flex; justify-content: center; align-items: center; }
.hero-illustration-wrapper {
    width: 450px;
    height: 450px;
    background: #3b3898;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    animation: float 6s ease-in-out infinite;
}
.hero-illustration { width: 100%; height: 100%; object-fit: cover; }

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}

.hero-frame { position: absolute; z-index: 15; opacity: 0.6; animation: float-around 20s ease-in-out infinite; }
.frame-1 { width: 180px; height: 180px; background: radial-gradient(circle, #fbbf24 0%, transparent 70%); top: -5%; left: -5%; border-radius: 50%; filter: blur(15px); }
.frame-2 { width: 70px; height: 70px; background: radial-gradient(circle, #ddd6fe 0%, transparent 75%); top: 25%; left: 30%; border-radius: 50%; opacity: 0.8; }
.frame-3 { width: 140px; height: 140px; background: radial-gradient(circle, #a855f7 0%, transparent 70%); bottom: 5%; right: 5%; border-radius: 50%; filter: blur(15px); animation-delay: -5s; }
.frame-4 { width: 120px; height: 60px; background: #06b6d4; bottom: 15%; left: 5%; border-radius: 30px; filter: blur(20px); opacity: 0.5; animation-delay: -10s; }
.frame-5 { width: 45px; height: 45px; background: #fff; bottom: 20%; left: 40%; border-radius: 50%; filter: blur(8px); opacity: 0.7; }
.frame-6 { width: 100px; height: 100px; background: radial-gradient(circle, #0ea5e9 0%, transparent 70%); top: 10%; right: -10%; border-radius: 50%; filter: blur(10px); }

@keyframes float-around {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -40px) scale(1.05); }
    66% { transform: translate(-20px, 20px) scale(0.95); }
}

/* Grid Adjustment */
.dashboard-main { padding: 0 !important; background: #f8fafc; min-height: 100vh; }


/* Content Sections */
.content-section {
    padding: 3rem 10% 5rem;
    background: #f8fafc;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.section-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.section-title i {
    color: #6366f1;
}

/* Filter Bar */
.filter-bar {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    background: white;
    padding: 1rem 1.5rem;
    border-radius: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    margin-bottom: 2rem;
}

.filter-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    transition: all 0.2s;
}

.filter-item:focus-within {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

.filter-item i {
    color: #6366f1;
}

.filter-item input, .filter-item select {
    border: none;
    background: transparent;
    outline: none;
    font-weight: 600;
    color: #1e293b;
    min-width: 150px;
}

.filter-item input::placeholder {
    color: #94a3b8;
}

/* Custom Dropdown */
.custom-dropdown {
    position: relative;
}

.dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.75rem 1.25rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    font-weight: 600;
    color: #1e293b;
    transition: all 0.2s;
}

.dropdown-toggle:hover {
    border-color: #6366f1;
}

.dropdown-toggle i.arrow {
    margin-left: auto;
    color: #94a3b8;
    transition: transform 0.3s;
}

.custom-dropdown.active .arrow {
    transform: rotate(180deg);
}

.dropdown-options {
    display: none;
    position: absolute;
    top: calc(100% + 5px);
    left: 0;
    min-width: 200px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    padding: 0.6rem;
    z-index: 2000;
    max-height: 300px;
    overflow-y: auto;
}

.custom-dropdown.active .dropdown-options {
    display: block;
    animation: dropdownAnim 0.3s ease;
}

@keyframes dropdownAnim {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

.dropdown-opt {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    color: #64748b;
    transition: all 0.2s;
}

.dropdown-opt:hover {
    background: #f8fafc;
    color: #6366f1;
}

.dropdown-opt.active {
    background: rgba(99, 102, 241, 0.08);
    color: #6366f1;
}

/* Job Card Styling */
.job-listings-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.job-card, .candidature-card {
    background: white; 
    border-radius: 24px; 
    padding: 2rem; 
    border: 1px solid #e2e8f0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: grid; 
    grid-template-columns: 80px 1fr auto; 
    gap: 2rem;
    min-width: 0;
    align-items: center;
}

.job-card:hover, .candidature-card:hover { 
    transform: translateY(-5px); 
    box-shadow: 0 20px 40px rgba(0,0,0,0.05); 
    border-color: #6366f1; 
}

.job-company-logo, .candidature-icon { 
    width: 80px; 
    height: 80px; 
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); 
    border-radius: 20px; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    font-size: 1.5rem; 
    color: white;
}

.candidature-icon {
    background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
}

.job-info h2, .candidature-info h2 { 
    font-size: 1.25rem; 
    font-weight: 700; 
    color: #1e293b; 
    margin-bottom: 0.5rem; 
}

.job-meta, .candidature-meta { 
    display: flex; 
    gap: 1.5rem; 
    color: #64748b; 
    font-size: 0.9rem; 
    font-weight: 500; 
    flex-wrap: wrap;
}

.job-meta span, .candidature-meta span { 
    display: flex; 
    align-items: center; 
    gap: 0.5rem; 
}

.job-tags { 
    display: flex; 
    gap: 0.75rem; 
    margin-top: 1rem;
}

.job-tag { 
    padding: 0.5rem 1rem; 
    border-radius: 50px; 
    font-size: 0.75rem; 
    font-weight: 700; 
    background: #eef2ff; 
    color: #6366f1;
}

.tag-domain {
    background: #f0fdf4;
    color: #16a34a;
}

.candidature-desc {
    margin-top: 0.75rem;
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.5;
}

/* Status Badges */
.status-badge {
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.status-badge i {
    font-size: 0.5rem;
}

.status-en_attente {
    background: #fef3c7;
    color: #f59e0b;
}

.status-acceptee, .status-accepté {
    background: #d1fae5;
    color: #10b981;
}

.status-refusee, .status-refusé {
    background: #fee2e2;
    color: #ef4444;
}

.btn-apply, .btn-view {
    background: #f1f5f9; 
    color: #1e293b; 
    border: none; 
    padding: 0.85rem 1.5rem;
    border-radius: 12px; 
    font-weight: 700; 
    cursor: pointer; 
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
}

.btn-apply:hover, .btn-view:hover { 
    background: #6366f1; 
    color: white; 
}

.btn-primary-gradient {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white !important;
    border: none;
    padding: 0.8rem 1.5rem;
    border-radius: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
    text-decoration: none;
    border: none !important;
    outline: none !important;
}

.btn-primary-gradient:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(99, 102, 241, 0.35);
    filter: brightness(1.1);
}

.btn-primary-gradient:active {
    transform: translateY(0);
}

/* Tab Content */
.tab-content {
    display: none;
}

.tab-content.active {
    display: block;
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 4rem 2rem;
}

.empty-state i {
    font-size: 4rem;
    color: #e2e8f0;
    margin-bottom: 1rem;
}

.empty-state h3 {
    color: #64748b;
    font-weight: 700;
}

.empty-state p {
    color: #94a3b8;
}

/* Create Candidature Modal */
.create-modal {
    display: none;
    position: fixed;
    z-index: 3000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
}

.create-modal-content {
    background-color: #fff;
    margin: 3% auto;
    padding: 2.5rem;
    border-radius: 30px;
    width: 60%;
    max-width: 700px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    position: relative;
    animation: slideIn 0.4s ease-out;
}

.create-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
}

.create-modal-header h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.create-modal-header h2 i {
    color: #6366f1;
}

.close-btn {
    background: #f1f5f9;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: #64748b;
    transition: all 0.2s;
}

.close-btn:hover {
    background: #fee2e2;
    color: #ef4444;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-group.full-width {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.form-group input,
.form-group textarea,
.form-group select {
    padding: 0.85rem 1rem;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 500;
    color: #1e293b;
    background: #f8fafc;
    transition: all 0.2s;
    resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    outline: none;
    border-color: #6366f1;
    background: white;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
}

.form-group textarea {
    min-height: 100px;
}

.form-group textarea.large {
    min-height: 150px;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
}

.btn-cancel {
    background: #f1f5f9;
    color: #64748b;
    border: none;
    padding: 0.85rem 1.5rem;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-cancel:hover {
    background: #e2e8f0;
    color: #475569;
}

.btn-submit {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    border: none;
    padding: 0.85rem 2rem;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s;
    box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
}

.btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(99, 102, 241, 0.35);
}

.btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

.form-error {
    color: #ef4444;
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 0.25rem;
    display: none;
}

/* File Upload Styling */
.file-upload-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.file-upload-input {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 10;
}

.file-upload-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: #f8fafc;
    border: 2px dashed #e2e8f0;
    border-radius: 12px;
    transition: all 0.2s;
    cursor: pointer;
}

.file-upload-box:hover {
    border-color: #6366f1;
    background: #f1f5f9;
}

.file-upload-box.has-file {
    border-style: solid;
    border-color: #10b981;
    background: #ecfdf5;
}

.file-upload-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1rem;
}

.file-upload-box.has-file .file-upload-icon {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.file-upload-text {
    flex: 1;
}

.file-upload-title {
    font-weight: 700;
    color: #1e293b;
    font-size: 0.9rem;
}

.file-upload-subtitle {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-top: 0.15rem;
}

.file-upload-box.has-file .file-upload-title {
    color: #10b981;
}

.file-remove-btn {
    background: #fee2e2;
    border: none;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: #ef4444;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    z-index: 15;
    position: relative;
}

.file-remove-btn:hover {
    background: #fecaca;
}

.file-upload-box.has-file .file-remove-btn {
    display: flex;
}

/* Range Slider Styling */
.date-filter-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    min-width: 280px;
}

.date-slider-wrapper {
    position: relative;
    height: 20px;
    margin-top: 5px;
}

input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    outline: none;
    background: transparent;
    pointer-events: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
}

input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    background: #6366f1;
    border: 3px solid white;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
    z-index: 10;
    position: relative;
    transition: all 0.2s ease;
}

input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    background: #4f46e5;
}

input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    background: #6366f1;
    border: 3px solid white;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
    z-index: 10;
    transition: all 0.2s ease;
}

.slider-track {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    height: 6px;
    background: #e2e8f0;
    border-radius: 10px;
    z-index: 1;
}

.slider-track-fill {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 6px;
    background: linear-gradient(90deg, #6366f1, #a855f7);
    border-radius: 10px;
    z-index: 2;
    transition: all 0.1s ease;
}

.date-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 0.25rem;
}

.date-label-box {
    background: white;
    padding: 0.25rem 0.6rem;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    font-size: 0.75rem;
    font-weight: 700;
    color: #6366f1;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}

.date-filter-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
@keyframes slideIn { from { transform: translateY(-30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
</style>
{% endblock %}

