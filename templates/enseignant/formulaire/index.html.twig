{% extends 'enseignant/layout.html.twig' %}

{% block title %}Gestion des Quiz - InnoLearn{% endblock %}

{% block page_stylesheets %}
<style>
/* Make header transparent on this page */
.dashboard-header {
    position: absolute;
    width: 100%;
    background: transparent !important;
    backdrop-filter: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
    z-index: 1000;
}

.dashboard-header .header-brand,
.dashboard-header .nav-item,
.dashboard-header .icon-btn,
.dashboard-header .search-bar-compact i {
    color: white !important;
}

/* Hero Section */
.courses-hero {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    min-height: 480px;
    background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #6d28d9 100%);
    position: relative;
    display: flex;
    align-items: center;
    overflow: visible;
    padding-top: 100px;
    margin-bottom: 4rem;
}

.hero-content-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 10;
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    color: white;
    line-height: 1.1;
    margin-bottom: 1.5rem;
}

.hero-title span {
    background: linear-gradient(135deg, #ffb82b 0%, #f97316 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
}

.hero-label {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Vertical Filter Bar */
.hero-filter-bar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    margin-top: 2rem;
    max-width: 350px;
    position: relative;
}

.custom-dropdown {
    position: relative;
    width: 100%;
}

.hero-filter-bar .dropdown-toggle, .hero-search-wrapper {
    padding: 1rem 1.25rem;
    border-radius: 25px;
    background: rgba(255, 255, 255, 0.95);
    border: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: all 0.2s;
    cursor: pointer;
    width: 100%;
}

.dropdown-options {
    display: none;
    position: absolute;
    top: calc(100% + 5px);
    left: 0;
    right: 0;
    background: white;
    border-radius: 18px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    padding: 0.6rem;
    z-index: 2000;
}

.custom-dropdown.active .dropdown-options {
    display: block;
    animation: dropdownAnim 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
}

@keyframes dropdownAnim {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

.dropdown-opt {
    padding: 0.8rem 1rem;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #64748b;
    transition: all 0.2s;
}

.dropdown-opt:hover, .dropdown-opt.active {
    background: #f8fafc;
    color: #6366f1;
}

.hero-search-wrapper input {
    border: none;
    background: transparent;
    outline: none;
    width: 100%;
    font-weight: 600;
    color: #1e293b;
}

.voice-btn {
    background: rgba(99, 102, 241, 0.05);
    border: 1px solid rgba(99, 102, 241, 0.1);
    color: #6366f1;
    cursor: pointer;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 50%;
    margin-left: 0.5rem;
    flex-shrink: 0;
}

.voice-btn:hover {
    background: #6366f1;
    color: white;
    transform: scale(1.1);
}

.voice-btn.recording {
    background: #ef4444;
    color: white;
    border-color: #ef4444;
    animation: pulse-red 1.5s infinite;
}

@keyframes pulse-red {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.7; }
    100% { transform: scale(1); opacity: 1; }
}

.chart-container-mini {
    width: 80px;
    height: 80px;
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    padding: 8px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: chartFadeIn 0.6s ease-out;
}

.chart-container-mini canvas {
    max-width: 100%;
    max-height: 100%;
}

@keyframes chartFadeIn {
    from { opacity: 0; transform: scale(0.8) rotate(-10deg); }
    to { opacity: 1; transform: scale(1) rotate(0deg); }
}

.course-card-premium:hover .chart-container-mini {
    transform: scale(1.1) translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.modal-analysis {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    border: 1px solid rgba(99, 102, 241, 0.2);
}

.ai-glow {
    animation: ai-glow 2s infinite alternate;
}

@keyframes ai-glow {
    from { color: #6366f1; text-shadow: 0 0 5px rgba(99, 102, 241, 0.4); }
    to { color: #a855f7; text-shadow: 0 0 15px rgba(168, 85, 247, 0.6); }
}

/* Grid Adjustment */
.dashboard-main { padding: 0 !important; background: #f8fafc; min-height: 100vh; }
.course-catalog-grid { padding: 0 10% 5rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2.5rem; }

/* Quiz Card */
.course-card-premium {
    background: white; border-radius: 24px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    transition: all 0.4s; border: 1px solid #e2e8f0; display: flex; flex-direction: column;
    position: relative;
}
.course-card-premium:hover { transform: translateY(-10px); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1); }
.course-image-wrapper { position: relative; height: 140px; overflow: hidden; background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); display: flex; align-items: center; justify-content: center; }
.course-image-wrapper i { font-size: 4rem; color: white; opacity: 0.8; }
.course-badge { position: absolute; top: 1rem; left: 1rem; padding: 0.5rem 1rem; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px); border-radius: 10px; font-size: 0.75rem; font-weight: 800; color: #1e293b; }
.course-content { padding: 2rem; flex: 1; display: flex; flex-direction: column; }
.course-content h3 { font-size: 1.25rem; margin-bottom: 0.5rem; color: #1e293b; font-weight: 700; }
.course-desc { font-size: 0.9rem; color: #64748b; margin-bottom: 1.5rem; height: 40px; overflow: hidden; }

.card-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #f1f5f9;
}

.card-stats-badges {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.stat-badge {
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.stat-pass { background: #dcfce7; color: #166534; }
.stat-fail { background: #fee2e2; color: #991b1b; }
.stat-total { background: #f1f5f9; color: #475569; }

.btn-action {
    flex: 1;
    padding: 0.6rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    transition: all 0.2s;
    text-decoration: none;
}

.btn-edit { background: #fef3c7; color: #92400e; }
.btn-edit:hover { background: #fde68a; }
.btn-questions { background: #dbeafe; color: #1e40af; }
.btn-questions:hover { background: #bfdbfe; }
.btn-delete { background: #fee2e2; color: #b91c1c; border: none; cursor: pointer; }
.btn-delete:hover { background: #fecaca; }

.btn-primary-gradient {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white; border: none; padding: 1rem 2rem; border-radius: 15px;
    font-weight: 700; display: flex; align-items: center; gap: 0.75rem; cursor: pointer;
    transition: all 0.3s; box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
    text-decoration: none; width: fit-content;
}
.btn-primary-gradient:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(99, 102, 241, 0.3);
}

.hero-waves {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 5;
}
.hero-waves svg { fill: #f8fafc; height: 60px; width: 100%; }
</style>
{% endblock %}

{% block student_content %}
<div class="dashboard-main">
    <!-- Hero Section -->
    <section class="courses-hero">
        <div class="hero-content-wrapper">
            <div class="hero-text-content">
                <span class="hero-label">Espace Enseignant</span>
                <h1 class="hero-title">
                    Gérez et<br>
                    <span>Optimisez Vos Quiz</span>
                </h1>
                
                <div class="hero-filter-bar">
                    <!-- Category Dropdown -->
                    <div class="custom-dropdown" id="pageCategoryDropdown">
                        <div class="dropdown-toggle">
                            <i class="bi bi-funnel"></i>
                            <span class="selected-category">Toutes les catégories</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </div>
                        <div class="dropdown-options">
                            <div class="dropdown-opt active" data-value="all">
                                <i class="bi bi-grid"></i> Toutes les catégories
                            </div>
                        </div>
                    </div>
                    
                    <!-- Search Wrapper -->
                    <div class="hero-search-wrapper">
                        <i class="bi bi-search" style="color: #6366f1;"></i>
                        <input type="text" id="localSearch" placeholder="Rechercher un quiz...">
                        <button id="voiceSearchBtn" class="voice-btn" title="Recherche vocale" type="button">
                            <i class="bi bi-mic"></i>
                        </button>
                    </div>

                    <a href="{{ path('app_enseignant_quiz_new') }}" class="btn-primary-gradient" style="margin-top: 1rem; width: fit-content;">
                        <i class="bi bi-plus-lg"></i>
                        Créer un Quiz
                    </a>
                </div>
            </div>
            
            <div class="hero-visual text-center">
                <i class="bi bi-cpu text-white opacity-10" style="font-size: 15rem;"></i>
            </div>
        </div>

        <div class="hero-waves">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" preserveAspectRatio="none">
                <path d="M0,96L48,90.7C96,85,192,75,288,69.3C384,64,480,64,576,69.3C672,75,768,85,864,85.3C960,85,1056,75,1152,64C1248,53,1344,43,1392,37.3L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"></path>
            </svg>
        </div>
    </section>

    <!-- Content Grid -->
    <div class="course-catalog-grid">
        {% for data in formulaires %}
        {% set formulaire = data.entity %}
        {% set stats = data.stats %}
        <div class="course-card-premium" data-title="{{ formulaire.titre|lower }}">
            <div class="course-image-wrapper">
                <div class="course-badge">{{ formulaire.category }}</div>
                <i class="bi bi-file-earmark-text"></i>
                <div class="chart-container-mini">
                    {{ render_chart(data.chart) }}
                </div>
            </div>
            <div class="course-content">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <h3>{{ formulaire.titre }}</h3>
                    <button class="btn-action btn-questions btn-ai-analyze" 
                            style="flex: 0 0 auto; background: rgba(99, 102, 241, 0.1); color: #6366f1; border-radius: 100px; padding: 4px 12px; border: none; cursor: pointer; display: flex; align-items: center; gap: 5px;"
                            onclick="openAnalysisModal({{ formulaire.id }}, '{{ formulaire.titre|escape('js') }}')"
                            title="Analyse par l'IA">
                        <i class="bi bi-robot ai-glow"></i> <span style="font-size: 0.75rem; font-weight: 700;">Analyse IA</span>
                    </button>
                </div>
                <p class="course-desc">{{ formulaire.description|u.truncate(100, '...') }}</p>
                
                <div class="card-stats-badges">
                    <div class="stat-badge stat-pass" title="Étudiants ayant réussi (>50%)">
                        <i class="bi bi-check-circle-fill"></i> {{ stats.pass }} Réussis
                    </div>
                    <div class="stat-badge stat-fail" title="Étudiants ayant échoué (<50%)">
                        <i class="bi bi-x-circle-fill"></i> {{ stats.fail }} Échecs
                    </div>
                </div>

                <div class="d-flex justify-content-between text-muted small mb-3">
                    <span><i class="bi bi-clock me-1"></i> {{ formulaire.tempsLimite }} min</span>
                    <span><i class="bi bi-list-ol me-1"></i> {{ formulaire.questions|length }} questions</span>
                </div>

                <div class="card-actions">
                    <a href="{{ path('app_enseignant_quiz_edit', {id: formulaire.id}) }}" class="btn-action btn-edit" title="Modifier">
                        <i class="bi bi-pencil"></i> Modifier
                    </a>
                    <a href="{{ path('app_enseignant_quiz_questions', {id: formulaire.id}) }}" class="btn-action btn-questions" title="Questions">
                        <i class="bi bi-list-check"></i> Questions
                    </a>
                    <form method="post" action="{{ path('app_enseignant_quiz_delete', {id: formulaire.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce quiz ?');" style="flex: 1;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ formulaire.id) }}">
                        <button type="submit" class="btn-action btn-delete w-100" style="border: none; cursor: pointer;">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<!-- AI Analysis Modal -->
<div class="modal fade" id="analysisModal" tabindex="-1" aria-hidden="true" style="z-index: 2000;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content p-2 border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h4 class="modal-title fw-bold" id="analysisQuizTitle">Analyse du Quiz</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0" id="analysisContent">
                <!-- Data loaded via JS -->
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_javascripts %}
<script>
console.log("Teacher dashboard JS loading...");

// Chart.js Plugin for Center Text in Doughnut Charts
if (typeof Chart !== 'undefined') {
    Chart.register({
        id: 'centerTextPlugin',
        beforeDraw: function(chart) {
            if (chart.config.type === 'doughnut') {
                const width = chart.width;
                const height = chart.height;
                const ctx = chart.ctx;
                ctx.restore();
                
                // Calculate total
                const dataset = chart.data.datasets[0];
                const total = dataset.data.reduce((a, b) => a + b, 0);
                
                // Set font and style
                const fontSize = (height / 150).toFixed(2);
                ctx.font = `bold ${fontSize}em 'Inter', sans-serif`;
                ctx.textBaseline = 'middle';
                ctx.fillStyle = '#1e293b';
                
                // Draw total number
                const text = total.toString();
                const textX = Math.round((width - ctx.measureText(text).width) / 2);
                const textY = height / 2 - 5;
                ctx.fillText(text, textX, textY);
                
                // Draw label
                ctx.font = `${fontSize * 0.5}em 'Inter', sans-serif`;
                ctx.fillStyle = '#64748b';
                const labelText = 'Total';
                const labelX = Math.round((width - ctx.measureText(labelText).width) / 2);
                const labelY = height / 2 + 15;
                ctx.fillText(labelText, labelX, labelY);
                
                ctx.save();
            }
        }
    });
}

document.addEventListener('DOMContentLoaded', function() {
    console.log("Teacher dashboard DOM ready");
    const grid = document.querySelector('.course-catalog-grid');
    
    // Unified Dropdown Logic
    function setupDropdown(dropdownId, onSelect) {
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;
        
        const toggle = dropdown.querySelector('.dropdown-toggle');
        const options = dropdown.querySelectorAll('.dropdown-opt');
        const selectedSpan = dropdown.querySelector('.selected-category');

        toggle?.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('active');
        });

        options.forEach(opt => {
            opt.addEventListener('click', (e) => {
                e.stopPropagation();
                const val = opt.getAttribute('data-value');
                selectedSpan.textContent = opt.textContent.trim();
                options.forEach(o => o.classList.remove('active'));
                opt.classList.add('active');
                dropdown.classList.remove('active');
                onSelect(val);
            });
        });
    }

    window.onclick = (e) => { 
        if (!e.target.closest('.custom-dropdown')) {
            document.querySelectorAll('.custom-dropdown').forEach(d => d.classList.remove('active'));
        }
    };

    // Filtering Logic
    let currentCategory = 'all';
    let currentSearchQuery = '';

    function updateGrid() {
        if (!grid) return;
        let cards = Array.from(grid.querySelectorAll('.course-card-premium'));
        
        cards.forEach(card => {
            const title = (card.getAttribute('data-title') || '').toLowerCase();
            const badge = card.querySelector('.course-badge');
            const cat = badge ? badge.textContent.toLowerCase() : '';
            
            const matchesSearch = title.includes(currentSearchQuery.toLowerCase());
            const matchesCat = currentCategory === 'all' || cat.includes(currentCategory.toLowerCase());
            
            card.style.display = (matchesSearch && matchesCat) ? 'flex' : 'none';
        });
    }

    setupDropdown('pageCategoryDropdown', (val) => {
        currentCategory = val;
        updateGrid();
    });

    const searchInput = document.getElementById('localSearch');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            currentSearchQuery = e.target.value;
            updateGrid();
        });
    }

    // Voice Search
    const voiceBtn = document.getElementById('voiceSearchBtn');
    if (voiceBtn && searchInput) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (SpeechRecognition) {
            const recognition = new SpeechRecognition();
            recognition.lang = 'fr-FR';
            recognition.onresult = (event) => {
                const text = event.results[0][0].transcript;
                searchInput.value = text;
                searchInput.dispatchEvent(new Event('input', { bubbles: true }));
            };
            voiceBtn.addEventListener('click', () => {
                try {
                    recognition.start();
                } catch (e) {
                    console.error("Speech recognition error:", e);
                }
            });
        }
    }
});

function openAnalysisModal(quizId, quizTitle) {
    console.log("Opening analysis modal for quiz:", quizId);
    const modalElement = document.getElementById('analysisModal');
    if (!modalElement) {
        console.error("Modal element not found!");
        return;
    }
    
    // Check for bootstrap
    if (typeof bootstrap === 'undefined') {
        alert("Erreur: Bibliothèque Bootstrap non chargée. Impossible d'ouvrir le modal.");
        return;
    }

    const modal = new bootstrap.Modal(modalElement);
    document.getElementById('analysisQuizTitle').textContent = quizTitle;
    document.getElementById('analysisContent').innerHTML = `
        <div class="text-center py-5">
            <div class="ai-loader mb-4">
                <i class="bi bi-cpu fs-1 ai-glow-pulse" style="color: #6366f1;"></i>
            </div>
            <p class="text-muted fw-bold">L'IA InnoLearn analyse les performances...</p>
        </div>
    `;
    modal.show();

    fetch(`/enseignant/quizzes/${quizId}/analysis`)
        .then(response => {
            if (!response.ok) throw new Error("Erreur réseau (HTTP " + response.status + ")");
            return response.json();
        })
        .then(data => {
            document.getElementById('analysisContent').innerHTML = `
                <div class="p-4">
                    <div class="d-flex align-items-center gap-4 mb-5 p-4 rounded-4" style="background: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.1);">
                        <div class="bg-white p-3 rounded-circle shadow-sm" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-robot fs-1" style="color: #6366f1;"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold" style="color: #1e1b4b;">Analyse Pédagogique</h4>
                            <span class="badge rounded-pill bg-primary px-3 py-2">InnoLearn AI</span>
                        </div>
                    </div>
                    <div class="ai-analysis-text fs-5 lh-lg text-dark p-4 rounded-4" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                         ${data.analysis ? data.analysis.replace(/\n/g, '<br>') : "Aucune analyse disponible."}
                    </div>
                </div>
            `;
        })
        .catch(err => {
            console.error("Analysis fetch error:", err);
            document.getElementById('analysisContent').innerHTML = `
                <div class="alert alert-danger m-3">
                    <strong>Erreur !</strong> Impossible de récupérer l'analyse.<br>
                    Détail : ${err.message}
                </div>
            `;
        });
}
</script>
{% endblock %}
