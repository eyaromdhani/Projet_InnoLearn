{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block navbar %}{% endblock %}
{% block footer_wave %}{% endblock %}

{% block body %}
    {# Robust error gathering #}
    {% set all_errors = [] %}
    
    {# 1. Native security error #}
    {% if error is defined and error %}
        {% set all_errors = all_errors|merge([error.messageKey|trans(error.messageData, 'security')]) %}
    {% endif %}
    
    {# 2. Flash errors #}
    {% for msg in app.flashes('error') %}
        {% set all_errors = all_errors|merge([msg]) %}
    {% endfor %}
    {% for msg in app.flashes('danger') %}
        {% set all_errors = all_errors|merge([msg]) %}
    {% endfor %}

    <style>
        @keyframes shake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }
    </style>

    <main class="auth-page" style="background: var(--bg-dark); min-height: 100vh; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
    <!-- Organic Background Blobs -->
    <div style="position: absolute; top: -10%; left: -10%; width: 40%; height: 60%; background: var(--gradient-hero); border-radius: 50%; filter: blur(100px); opacity: 0.4;"></div>
    <div style="position: absolute; bottom: -10%; right: -10%; width: 30%; height: 50%; background: var(--secondary); border-radius: 50%; filter: blur(100px); opacity: 0.3;"></div>

    <!-- Back to Home Button -->
    <a href="{{ path('app_home') }}" style="position: absolute; top: 2rem; left: 2rem; z-index: 100; display: flex; align-items: center; gap: 0.5rem; color: white; text-decoration: none; font-weight: 500; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); padding: 0.75rem 1.25rem; border-radius: 100px; border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.3s;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Home
    </a>

    <div class="auth-frame" style="position: relative; z-index: 1; max-width: 1000px; width: 90%; background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(25px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 40px; overflow: hidden; display: flex; box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4);">
        <!-- Left Side: Original Lock Animation -->
        <div class="lock-side" style="flex: 1; padding: 4rem; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.02); border-right: 1px solid rgba(255, 255, 255, 0.05); position: relative;">
            <div class="lock-scene" style="position: relative; width: 280px; height: 320px; display: flex; flex-direction: column; align-items: center;">
                <!-- SVG Lock Assembly -->
                <svg id="lock-assembly" viewBox="0 0 200 240" style="width: 100%; height: 100%; overflow: visible;">
                    <defs>
                        <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:var(--bg-dark);stop-opacity:1" />
                            <stop offset="45%" style="stop-color:var(--primary);stop-opacity:1" />
                            <stop offset="100%" style="stop-color:var(--primary-dark);stop-opacity:1" />
                        </linearGradient>
                    </defs>

                    <!-- SHACKLE -->
                    <path class="shackle"
                      d="M130 93 V73 Q130 48 100 48 Q70 48 70 73 V118"
                      stroke="var(--primary)"
                      stroke-width="14"
                      stroke-linecap="round"
                      fill="none" />

                    <!-- BODY -->
                    <rect x="50" y="98" width="100" height="85" rx="15"
                      fill="var(--bg-dark)"
                      stroke="var(--primary)"
                      stroke-width="3" />

                    <!-- OUTER CYLINDER -->
                    <circle cx="100" cy="140" r="26"
                        fill="rgba(0,0,0,0.5)"
                        stroke="var(--primary)"
                        stroke-width="1.5" />

                    <!-- ROTATING MECHANISM -->
                    <g class="lock-mechanism">
                        <!-- PLUG -->
                        <circle cx="100" cy="140" r="22"
                                fill="var(--bg-dark)"
                                stroke="var(--primary-light)"
                                stroke-width="1.5" />

                        <!-- SLOT -->
                        <rect x="88" y="137" width="24" height="6" rx="1.5" fill="black" />

                        <!-- KEY -->
                        <g class="key-object">
                            <circle cx="-40" cy="140" r="18"
                                    stroke="white"
                                    stroke-width="8"
                                    fill="none"/>
                            <line x1="-22" y1="140" x2="65" y2="140"
                                  stroke="white"
                                  stroke-width="8"
                                  stroke-linecap="round" />
                            <line x1="38" y1="140" x2="38" y2="160"
                                  stroke="white"
                                  stroke-width="8"
                                  stroke-linecap="round" />
                            <line x1="52" y1="140" x2="52" y2="160"
                                  stroke="white"
                                  stroke-width="8"
                                  stroke-linecap="round" />
                        </g>
                    </g>
                </svg>
            </div>
            
            <div style="margin-top: 1rem; text-align: center;">
                <h2 style="color: white; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">Secure Access</h2>
                <p style="color: rgba(255, 255, 255, 0.5); font-size: 0.9rem;">Experience the precision of high-grade security.</p>
            </div>
        </div>

        <!-- Right Side: Form with Book Format -->
        <div class="form-side" style="flex: 1.2; position: relative; display: flex; align-items: center; justify-content: center; padding: 3rem;">
            
            <!-- THE BOOK BACKGROUND -->
            <div class="form-book-bg" style="position: absolute; inset: 1.5rem; background: #fff; border-radius: 5px 20px 20px 5px; box-shadow: -10px 10px 30px rgba(0,0,0,0.3); transform: rotateY(-3deg); transform-style: preserve-3d; transition: 0.5s;">
                <!-- Pages effect -->
                <div style="position: absolute; inset: 0; background: linear-gradient(to right, #eee 2%, #fff 5%); border-radius: inherit;"></div>
                <div style="position: absolute; top: 0; left: 0; width: 30px; height: 100%; background: linear-gradient(to right, rgba(0,0,0,0.1), transparent); border-radius: 5px 0 0 5px;"></div>
                <!-- Bookmark -->
                <div style="position: absolute; top: -10px; right: 40px; width: 25px; height: 60px; background: var(--primary); border-radius: 0 0 5px 5px; clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 50% 85%, 0% 100%);"></div>
            </div>

            <!-- Form Content (On the "Page") -->
            <div style="position: relative; z-index: 10; width: 100%; max-width: 400px;">
                <div style="text-align: center; margin-bottom: 2rem;">
                    <h1 style="color: #1e1b4b; font-size: 2.25rem; font-weight: 900; margin-bottom: 0.5rem; font-family: 'serif';">Login</h1>
                    <p style="color: #64748b; font-family: 'Georgia', serif; font-style: italic;">Welcome back! Please enter your details.</p>
                </div>

                {% if all_errors|length > 0 %}
                    <div class="error-box" style="background: #fee2e2; border: 2px solid #ef4444; color: #b91c1c; padding: 1.25rem; border-radius: 16px; margin-bottom: 2rem; text-align: center; box-shadow: 0 10px 20px rgba(239,68,68,0.1); position: relative; z-index: 100; animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;">
                        <div style="font-weight: 800; text-transform: uppercase; font-size: 0.75rem; margin-bottom: 0.5rem; letter-spacing: 1px;">Access Denied</div>
                        {% for message in all_errors %}
                            <p style="margin: 0; font-weight: 600;">{{ message }}</p>
                        {% endfor %}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" id="premium-auth-form" style="margin-top: 2rem;">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    
                    <div style="margin-bottom: 1.5rem;">
                        <input type="text" name="identifier" id="p-identifier" value="{{ last_username }}"
                               style="width: 100%; background: #f8fafc; border: 4px solid #e2e8f0; border-radius: 9999px; padding: 1.1rem 2rem; color: #1e293b; outline: none; transition: all 0.3s; text-align: center; font-weight: 800; font-size: 1.1rem;" 
                               placeholder="Email or Username" required>
                    </div>
                    <div style="margin-bottom: 1.5rem;">
                        <input type="password" name="password" id="p-password" 
                               style="width: 100%; background: #f8fafc; border: 4px solid #e2e8f0; border-radius: 9999px; padding: 1.1rem 2rem; color: #1e293b; outline: none; transition: all 0.3s; text-align: center; font-weight: 800; font-size: 1.1rem;" 
                               placeholder="ACCESS KEY" required>
                    </div>

                    <div style="margin-bottom: 1.5rem; display: flex; justify-content: flex-end;">
                        <a href="#" style="color: var(--primary); font-size: 0.8rem; font-weight: 600; text-decoration: none;">Forgot password?</a>
                    </div>

                    <button type="submit" id="p-login-btn"
                            onclick="if(document.getElementById('p-identifier').value && document.getElementById('p-password').value) { this.innerHTML='<span class=\'pulse\'>Authenticating...</span>'; this.style.opacity='0.7'; }"
                            style="width: 100%; justify-content: center; padding: 1.1rem; font-size: 1.3rem; font-weight: 900; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.1em; background: var(--gradient-organic); border: none; box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2); cursor: pointer; color: white;">
                        Login
                    </button>
                </form>

                <div style="text-align: center; margin-top: 1.5rem;">
                    <p style="color: #64748b; font-size: 0.95rem;">New? <a href="{{ path('app_signup') }}" style="color: var(--primary); font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--primary);">Sign up here</a></p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const u = document.getElementById('p-identifier');
            const p = document.getElementById('p-password');
            const key = document.querySelector('.key-object');
            const mechanism = document.querySelector('.lock-mechanism');
            const scene = document.querySelector('.lock-scene');
            const bookBg = document.querySelector('.form-book-bg');

            gsap.set(key, { x: -10 });

            const update = () => {
                const combined = u.value.length + p.value.length;
                const progress = Math.min(combined / 15, 1);
                gsap.to(key, { x: -10 + (progress * 65), duration: 0.3 });
                gsap.to(bookBg, { rotationY: -3 + (progress * 2), duration: 0.5 });
            };

            [u, p].forEach(i => i.addEventListener("input", update));

            {% if all_errors|length > 0 %}
            // Rejection Animation
            gsap.timeline()
                .to(scene, { x: -10, duration: 0.1, repeat: 7, yoyo: true })
                .to("#lock-assembly", { filter: "drop-shadow(0 0 25px rgba(239, 68, 68, 0.8))", duration: 0.3 }, 0);
            {% endif %}
        });
    </script>
</main>
{% endblock %}
