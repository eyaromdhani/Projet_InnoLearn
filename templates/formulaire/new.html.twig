{% extends 'admin/layout.html.twig' %}

{% block title %}Nouveau Quiz{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/formulaire.css') }}?v={{ 'now'|date('YmdHi') }}">
    <style>
        /* 2-column professional layout */
        .form-row {
            display: flex;
            align-items: center;
            margin-bottom: 1.8rem;
        }

        .form-row label {
            width: 180px;
            margin: 0;
            font-weight: 600;
        }

        .form-row .form-control {
            width: 100%;
            max-width: 500px;
            height: 48px;
            border-radius: 8px;
        }

        textarea.form-control {
            height: 130px !important;
        }

        .input-group {
            max-width: 500px;
        }

        .input-group-text {
            height: 48px;
            border-radius: 0 8px 8px 0;
        }

        .action-buttons {
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid #e5e7eb;
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
        }
    </style>
{% endblock %}

{% block admin_content %}

<div class="quiz-page-header animate-fade-in-up">
    <h1 class="quiz-page-title">Créer un <span>Nouveau Quiz</span></h1>
    <a href="{{ path('app_formulaire_index') }}" class="btn btn-light border-0 shadow-sm text-secondary">
        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="quiz-card">
            <div class="quiz-card-header">
                <h3><i class="bi bi-pencil-square me-2"></i>Détails du Quiz</h3>
            </div>

            <div class="p-4">

                {{ form_start(form) }}

                    <!-- Titre -->
                    <div class="form-row">
                        <label>Titre du Quiz</label>
                        <div class="flex-grow-1">
                            {{ form_widget(form.titre, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Ex: Introduction à Symfony'
                                }
                            }) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.titre) }}
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-row">
                        <label>Description</label>
                        <div class="flex-grow-1">
                            {{ form_widget(form.description, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Brève description du quiz...'
                                }
                            }) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.description) }}
                            </div>
                        </div>
                    </div>

                    <!-- Temps limite -->
                    <div class="form-row">
                        <label>Temps Limite</label>
                        <div class="flex-grow-1">
                            <div class="input-group">
                                {{ form_widget(form.tempsLimite, {
                                    'attr': { 'class': 'form-control' }
                                }) }}
                                <span class="input-group-text bg-light text-muted">minutes</span>
                            </div>
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.tempsLimite) }}
                            </div>
                        </div>
                    </div>

                    <!-- Catégorie -->
                    <div class="form-row">
                        <label>Catégorie</label>
                        <div class="flex-grow-1">
                            {{ form_widget(form.category, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Ex: Développement Web'
                                }
                            }) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.category) }}
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="action-buttons">
                        <a href="{{ path('app_formulaire_index') }}" class="btn btn-light px-4">
                            Annuler
                        </a>

                        <button type="submit" class="btn btn-primary px-4 fw-bold"
                                style="background: linear-gradient(135deg, #6366f1, #8b5cf6); border: none;">
                            <i class="bi bi-save me-2"></i> Enregistrer le Quiz
                        </button>
                    </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>

{% endblock %}