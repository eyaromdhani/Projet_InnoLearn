    // Contextual keywords that boost difficulty
    const contextBoost = [
        { pattern: /syst[eè]me|architecture|compilateur|noyau/i, boost: 1 },
        { pattern: /distribu[eé]|parall[eè]le|concurrent/i, boost: 1 },
        { pattern: /intelligence artificielle|r[eé]seau.*(neuron|profond)/i, boost: 1 },
        { pattern: /optimisation|performance|scalab/i, boost: 0.5 },
        { pattern: /s[eé]curit[eé]|exploit|vuln[eé]rabilit/i, boost: 0.5 },
        { pattern: /temps r[eé]el|real.?time|embarqu[eé]/i, boost: 0.5 },
        { pattern: /big data|donn[eé]es massives/i, boost: 0.5 },
        { pattern: /portfolio|d[eé]butant|apprendre|tutoriel|initiation/i, boost: -0.5 },
        { pattern: /basique|simple|introduction|premier/i, boost: -0.5 }
    ];

    const levels = {
        1: { label: 'Débutant', icon: 'fa-leaf', bg: '#ecfdf5', color: '#047857' },
        2: { label: 'Intermédiaire', icon: 'fa-bolt', bg: '#eff6ff', color: '#1d4ed8' },
        3: { label: 'Avancé', icon: 'fa-trophy', bg: '#f5f3ff', color: '#7c3aed' },
        4: { label: 'Expert', icon: 'fa-gem', bg: '#fef2f2', color: '#dc2626' }
    };

    function analyzeComplexity(title) {
        title = title.toLowerCase().trim();

        // 1. Exact match — highest priority, return immediately
        if (techDifficulty[title] !== undefined) {
            return techDifficulty[title];
        }

        let score = 0;
        let matches = 0;

        // 2. Partial matching with word-boundary safety
        for (const [tech, diff] of Object.entries(techDifficulty)) {
            if (tech.length <= 2) {
                // Short names (c, r, go, v) — require word boundary match
                const regex = new RegExp('(?:^|[\\s,;:/\\-_+.()\\[\\]])' + tech.replace(/[+]/g, '\\+') + '(?:$|[\\s,;:/\\-_+.()\\[\\]])', 'i');
                if (regex.test(title)) {
                    score += diff;
                    matches++;
                }
            } else {
                // Longer names — safe to use includes
                if (title.includes(tech)) {
                    score += diff;
                    matches++;
                }
            }
        }

        // 3. Apply context boosts
        let contextScore = 0;
        contextBoost.forEach(({ pattern, boost }) => {
            if (pattern.test(title)) contextScore += boost;
        });

        let finalScore;
        if (matches > 0) {
            finalScore = Math.round(score / matches + contextScore);
        } else {
            // Unknown title: default to Intermédiaire + context
            finalScore = Math.round(2 + contextScore);
        }

        // Clamp between 1 and 4
        return Math.max(1, Math.min(4, finalScore));
    }

    // Apply AI complexity to all badges after a brief delay (simulate AI)
    setTimeout(() => {
        document.querySelectorAll('.ai-difficulty-badge').forEach(badge => {
            const title = badge.getAttribute('data-project-title');
            if (!title) return;

            const level = analyzeComplexity(title);
            const info = levels[level];

            badge.style.background = info.bg;
            badge.style.color = info.color;
            badge.innerHTML = `<i class="fas ${info.icon}"></i> ${info.label}`;
            badge.title = `Complexité IA: ${info.label} (basé sur "${title}")`;

            // Smooth reveal animation
            badge.style.transition = 'all 0.4s ease-out';
            badge.style.transform = 'scale(1.15)';
            setTimeout(() => { badge.style.transform = 'scale(1)'; }, 300);
        });
    }, 800);
})();
