.ai-panel-header h2{font-size:1.2rem;font-weight:900;margin-bottom:.2rem;display:flex;align-items:center;gap:.6rem}
.ai-beta-tag{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);padding:.15rem .6rem;border-radius:20px;font-size:.65rem;font-weight:800;letter-spacing:.5px;text-transform:uppercase}
.ai-panel-header p{font-size:.8rem;color:#c7d2fe;font-weight:500}
.ai-panel-close{position:absolute;top:1.25rem;right:1.25rem;background:rgba(255,255,255,.15);border:none;width:34px;height:34px;border-radius:10px;color:#fff;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;transition:background .2s}
.ai-panel-close:hover{background:rgba(255,255,255,.3)}
.ai-panel-body{flex:1;overflow-y:auto;padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem}
.ai-label{font-size:.75rem;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.8px;margin-bottom:.5rem}
.ai-textarea{width:100%;min-height:110px;padding:1rem;border:2px solid #e2e8f0;border-radius:16px;font-size:.9rem;font-weight:500;color:#1e293b;resize:vertical;outline:none;transition:border-color .2s,box-shadow .2s;font-family:inherit;line-height:1.6}
.ai-textarea:focus{border-color:#6366f1;box-shadow:0 0 0 4px rgba(99,102,241,.1)}
.ai-chips{display:flex;flex-wrap:wrap;gap:.5rem}
.ai-chip{background:#f1f5f9;border:1px solid #e2e8f0;border-radius:20px;padding:.35rem .9rem;font-size:.75rem;font-weight:600;color:#475569;cursor:pointer;transition:all .2s}
.ai-chip:hover{background:#ede9fe;border-color:#6366f1;color:#6366f1}
.ai-btn-generate{width:100%;padding:.9rem;background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff;border:none;border-radius:16px;font-size:.95rem;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.6rem;transition:all .3s;box-shadow:0 4px 15px rgba(99,102,241,.3)}
.ai-btn-generate:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 8px 25px rgba(99,102,241,.45)}
.ai-btn-generate:disabled{opacity:.7;cursor:not-allowed;transform:none}
.ai-spinner{width:18px;height:18px;border:3px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:none}
@keyframes spin{to{transform:rotate(360deg)}}
.ai-result-box{display:none;flex-direction:column;gap:1rem;animation:fadeUp .4s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.ai-result-box img{width:100%;border-radius:16px;box-shadow:0 8px 30px rgba(0,0,0,.12);border:2px solid #f1f5f9}
.ai-result-meta{font-size:.72rem;color:#94a3b8;font-weight:500;text-align:center;font-style:italic}
.ai-btn-download{display:flex;align-items:center;justify-content:center;gap:.5rem;padding:.75rem;background:#f8fafc;border:2px solid #e2e8f0;border-radius:14px;font-size:.85rem;font-weight:700;color:#475569;cursor:pointer;text-decoration:none;transition:all .2s}
.ai-btn-download:hover{background:#ede9fe;border-color:#6366f1;color:#6366f1}
.ai-error-box{display:none;background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:.9rem 1rem;font-size:.85rem;color:#dc2626;font-weight:600}
.ai-skeleton{display:none;width:100%;aspect-ratio:3/2;border-radius:16px;background:linear-gradient(90deg,#f1f5f9 25%,#e2e8f0 50%,#f1f5f9 75%);background-size:200% 100%;animation:shimmer 1.5s infinite}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
</style>

{# ── Floating Button ── #}
<button class="ai-fab" id="aiOpenBtn"><i class="fas fa-magic"></i></button>
<div class="ai-fab-tooltip">Générer une image avec l'IA</div>

{# ── Overlay ── #}
<div class="ai-overlay" id="aiOverlay"></div>

{# ── Side Panel ── #}
<div class="ai-panel" id="aiPanel">
    <div class="ai-panel-header">
        <button class="ai-panel-close" id="aiCloseBtn"><i class="fas fa-times"></i></button>
        <h2><i class="fas fa-magic"></i> AI Image Generator <span class="ai-beta-tag">BETA</span></h2>
        <p>Décrivez votre idée, l'IA la visualise pour vous ✨</p>
    </div>

    <div class="ai-panel-body">
        <div>
            <div class="ai-label">Votre description</div>
            <textarea class="ai-textarea" id="aiPrompt" placeholder="Ex : a futuristic classroom in space, digital art, vibrant colors..." maxlength="500"></textarea>
            <div style="text-align:right;font-size:.72rem;color:#94a3b8;margin-top:.25rem;"><span id="aiCharCount">0</span> / 500</div>
        </div>

        <div>
            <div class="ai-label">Suggestions rapides</div>
            <div class="ai-chips">
                <span class="ai-chip" data-prompt="a futuristic AI classroom, neon lights, digital art">🤖 Classe IA</span>
                <span class="ai-chip" data-prompt="a student studying under stars in a magical library, fantasy art">📚 Bibliothèque</span>
                <span class="ai-chip" data-prompt="a modern tech campus with holographic screens and green trees">🏫 Campus tech</span>
                <span class="ai-chip" data-prompt="abstract visualization of mathematics and code, colorful 3D">💻 Code & Maths</span>
                <span class="ai-chip" data-prompt="a brain made of circuits and light beams, neuroscience art">🧠 IA & Cerveau</span>
            </div>
        </div>

        <button class="ai-btn-generate" id="aiGenerateBtn">
            <span class="ai-spinner" id="aiSpinner"></span>
            <i class="fas fa-wand-magic-sparkles" id="aiWandIcon"></i>
            <span id="aiGenerateBtnText">G&eacute;n&eacute;rer l'image</span>
        </button>

        <div class="ai-error-box" id="aiErrorBox"></div>
        <div class="ai-skeleton" id="aiSkeleton"></div>

        <div class="ai-result-box" id="aiResultBox">
            <img id="aiResultImg" src="" alt="Image générée par IA">
            <div class="ai-result-meta" id="aiResultMeta"></div>
            <a class="ai-btn-download" id="aiDownloadBtn" href="#" target="_blank">
                <i class="fas fa-download"></i> Télécharger l'image
            </a>
        </div>
    </div>
</div>

<script>
(function(){
    const openBtn     = document.getElementById('aiOpenBtn');
    const closeBtn    = document.getElementById('aiCloseBtn');
    const overlay     = document.getElementById('aiOverlay');
    const panel       = document.getElementById('aiPanel');
    const promptEl    = document.getElementById('aiPrompt');
    const charCount   = document.getElementById('aiCharCount');
    const genBtn      = document.getElementById('aiGenerateBtn');
    const spinner     = document.getElementById('aiSpinner');
    const wandIcon    = document.getElementById('aiWandIcon');
    const btnText     = document.getElementById('aiGenerateBtnText');
    const errorBox    = document.getElementById('aiErrorBox');
    const skeleton    = document.getElementById('aiSkeleton');
    const resultBox   = document.getElementById('aiResultBox');
    const resultImg   = document.getElementById('aiResultImg');
    const resultMeta  = document.getElementById('aiResultMeta');
    const downloadBtn = document.getElementById('aiDownloadBtn');
    const endpoint    = '{{ path("app_student_ai_text_to_image") }}';

    const open  = () => { panel.classList.add('open'); overlay.classList.add('open'); document.body.style.overflow='hidden'; };
    const close = () => { panel.classList.remove('open'); overlay.classList.remove('open'); document.body.style.overflow=''; };

    if(openBtn) openBtn.addEventListener('click', open);
    if(closeBtn) closeBtn.addEventListener('click', close);
    if(overlay) overlay.addEventListener('click', close);

    if(promptEl) promptEl.addEventListener('input', () => charCount.textContent = promptEl.value.length);

    document.querySelectorAll('.ai-chip').forEach(c => {
        c.addEventListener('click', () => { promptEl.value = c.dataset.prompt; charCount.textContent = promptEl.value.length; promptEl.focus(); });
    });

    if(genBtn) {
        genBtn.addEventListener('click', async () => {
            const prompt = promptEl.value.trim();
            if (!prompt) { showError('Veuillez saisir une description.'); return; }
            
            setLoading(true); hideResult(); hideError();
            
            // Dynamic status updates during long generation
            const statuses = [
                "Initialisation des mod&egrave;les...",
                "Scan du serveur principal (Pollinations)...",
                "Tentative de mod&egrave;les rapides (Flux/Turbo)...",
                "Surcharge d&eacute;tect&eacute;e, rotation des mod&egrave;les...",
                "Passage sur le serveur de secours (Hercai AI)...",
                "Finalisation de l'image..."
            ];
            let statusIdx = 0;
            const statusInterval = setInterval(() => {
                if (statusIdx < statuses.length - 1) {
                    statusIdx++;
                    btnText.textContent = statuses[statusIdx];
                }
            }, 5000);

            try {
                const resp = await fetch(endpoint, { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ prompt }) 
                });
                
                clearInterval(statusInterval);
                const data = await resp.json();
                
                if (!resp.ok || data.error) { 
                    showError(data.error || 'Désolé, tous les serveurs sont saturés actuellement.'); 
                    setLoading(false); 
                    return; 
                }

                if (data.fallback) {
                    // All backend providers failed, try direct load
                    resultImg.onload = () => {
                        downloadBtn.href = data.imageUrl;
                        resultMeta.innerHTML = `<span style="color:#f59e0b"><i class="fas fa-life-ring"></i> Mode Secours Direct Activé</span><br>"${prompt.slice(0,50)}..."`;
                        setLoading(false); showResult();
                    };
                    resultImg.onerror = () => {
                        showError('<i class="fas fa-plug"></i> Échec critique : tous les services AI sont inaccessibles. <button onclick="document.getElementById(\'aiGenerateBtn\').click()" style="background:none;border:none;color:#dc2626;font-weight:800;cursor:pointer;text-decoration:underline;padding:0;margin-left:5px;">Réessayer</button>');
                        setLoading(false);
                    };
                    resultImg.src = data.imageUrl;
                } else {
                    // Success via one of our backend providers
                    resultImg.src = data.dataUri;
                    downloadBtn.href = data.dataUri;
                    resultMeta.innerHTML = `<span style="color:#10b981"><i class="fas fa-check-double"></i> ${data.info || 'Généré par IA'}</span><br>"${prompt.slice(0,50)}..."`;
                    setLoading(false); showResult();
                }
            } catch(e) { 
                clearInterval(statusInterval);
                showError('Erreur réseau. Vérifiez votre connexion.'); 
                setLoading(false); 
            }
        });
    }

    function setLoading(on){
        if(genBtn) genBtn.disabled = on;
        if(spinner) spinner.style.display   = on ? 'block' : 'none';
        if(wandIcon) wandIcon.style.display  = on ? 'none'  : 'inline';
        if(btnText) btnText.textContent     = on ? 'G&eacute;n&eacute;ration en cours&hellip;' : "G&eacute;n&eacute;rer l'image";
        if(skeleton) skeleton.style.display  = on ? 'block' : 'none';
    }
    function showResult(){ if(resultBox) resultBox.style.display='flex'; }
    function hideResult(){ if(resultBox) resultBox.style.display='none'; }
    function showError(m){ if(errorBox) { errorBox.innerHTML=m; errorBox.style.display='block'; } }
    function hideError() { if(errorBox) errorBox.style.display='none'; }

})();
</script>
{% endblock %}
