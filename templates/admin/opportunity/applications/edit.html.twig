{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier la Candidature{% endblock %}

{% block admin_content %}
<div class="animate-fade-in-up">
    <div class="mb-4">
        <h2 style="font-size: 1.875rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem;">Opportunités</h2>
        <p style="color: #64748b;">Modifier une candidature de stage existante.</p>
    </div>

    <div class="card" style="max-width: 800px; margin: 0 auto;">
        <div class="card-header">
            <h3 class="card-title">Modifier la Candidature #{{ application.id }}</h3>
        </div>
        <div class="card-body" style="padding: 2rem;">
            {{ include('admin/opportunity/applications/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            
            <div style="margin-top: 1.5rem; text-align: center;">
                <a href="{{ path('admin_opportunity_applications_index') }}" style="color: #64748b; text-decoration: none;">Retour à la liste</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
