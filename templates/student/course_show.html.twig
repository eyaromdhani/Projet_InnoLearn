{% extends 'student/layout.html.twig' %}

{% block title %}{{ course.nom }} - InnoLearn{% endblock %}

{% block page_stylesheets %}
<style>
/* Hero Section */
.course-detail-hero {
    background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #6d28d9 100%);
    padding: 5rem 2rem;
    color: white;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.hero-background {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(124, 58, 237, 0.4) 0%, transparent 70%);
    opacity: 0.5;
    pointer-events: none;
}

.hero-content {
    max-width: 1300px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
}

.breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    font-weight: 500;
}

.breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.breadcrumb a:hover {
    color: white;
    transform: translateX(-3px);
}

.breadcrumb span {
    color: rgba(255, 255, 255, 0.3);
}

.course-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
}

.course-title-section h1 {
    font-size: 3.5rem;
    font-weight: 900;
    margin-bottom: 1.25rem;
    color: white;
    letter-spacing: -0.025em;
    line-height: 1;
}

.course-meta-badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.course-badge {
    padding: 0.6rem 1.25rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.3s;
}

.badge-category {
    background: rgba(255, 255, 255, 0.15);
    color: white;
}

.badge-level {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    border-color: rgba(52, 211, 153, 0.2);
}

.badge-duration {
    background: rgba(99, 102, 241, 0.2);
    color: #a5b4fc;
}

.course-actions-header {
    display: flex;
    gap: 1rem;
}

.btn-back-hero {
    background: rgba(255, 255, 255, 0.05);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.85rem 1.75rem;
    border-radius: 14px;
    font-weight: 600;
    transition: all 0.3s;
    backdrop-filter: blur(10px);
}

.btn-back-hero:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: white;
}

.btn-enroll-hero {
    background: white;
    color: #4338ca;
    border: none;
    padding: 0.85rem 2rem;
    border-radius: 14px;
    font-weight: 800;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.btn-enroll-hero:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(67, 56, 202, 0.4);
}

/* Page Layout */
.course-detail-container {
    max-width: 1300px;
    margin: -3rem auto 4rem;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 2.5rem;
    position: relative;
    z-index: 20;
}

.card-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.course-info-card {
    background: white;
    border-radius: 24px;
    padding: 2.5rem;
    border: 1px solid #f1f5f9;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.04);
    transition: all 0.3s;
}

.course-info-card:hover {
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.07);
}

.section-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

.section-title i {
    width: 40px;
    height: 40px;
    background: #f1f5f9;
    color: #4338ca;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 1.1rem;
}

.course-description {
    color: #64748b;
    line-height: 1.8;
    font-size: 1.1rem;
    white-space: pre-line;
}

/* Timeline Modern */
.timeline-modern {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.timeline-modern-item {
    display: flex;
    gap: 1.5rem;
    position: relative;
}

.timeline-modern-item::after {
    content: '';
    position: absolute;
    left: 17px;
    top: 35px;
    bottom: -20px;
    width: 2px;
    background: #f1f5f9;
}

.timeline-modern-item:last-child::after {
    display: none;
}

.timeline-icon {
    width: 36px;
    height: 36px;
    background: white;
    border: 2px solid #e2e8f0;
    border-radius: 50%;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    transition: all 0.3s;
}

.timeline-modern-item.active .timeline-icon {
    border-color: #4338ca;
    color: #4338ca;
    box-shadow: 0 0 0 6px rgba(67, 56, 202, 0.05);
}

.timeline-content {
    flex: 1;
}

.timeline-content h4 {
    margin: 0 0 0.5rem;
    color: #334155;
    font-size: 1rem;
    font-weight: 700;
}

.timeline-content p {
    margin: 0;
    color: #94a3b8;
    font-size: 0.85rem;
}

/* Learning objectives grid */
.objectives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
}

.objective-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background: #f8fafc;
    border-radius: 16px;
    font-weight: 600;
    color: #475569;
    border: 1px solid #f1f5f9;
    transition: all 0.3s;
}

.objective-item:hover {
    background: white;
    border-color: #e2e8f0;
    transform: translateY(-2px);
}

.objective-item i {
    color: #10b981;
    margin-top: 3px;
}

/* Sidebar Styling */
.sidebar-sticky {
    position: sticky;
    top: 2rem;
}

.stat-box {
    text-align: center;
    padding: 2.5rem;
    background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
    border-radius: 24px;
    color: white;
    margin-bottom: 2rem;
    box-shadow: 0 20px 40px rgba(67, 56, 202, 0.2);
}

.stat-number {
    font-size: 3rem;
    font-weight: 800;
    display: block;
    line-height: 1;
    margin-bottom: 0.5rem;
}

.stat-label {
    font-size: 0.9rem;
    opacity: 0.8;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.info-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.info-row {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid #f1f5f9;
}

.info-row:last-child {
    border-bottom: none;
}

.row-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #64748b;
    font-weight: 500;
}

.row-value {
    color: #0f172a;
    font-weight: 700;
}

/* Quiz Premium CTA */
.quiz-cta-card {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    color: white;
    padding: 3rem;
    border-radius: 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.quiz-cta-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');
    opacity: 0.1;
}

.btn-start-quiz {
    background: white;
    color: #4f46e5;
    padding: 1rem 2.5rem;
    border-radius: 14px;
    font-weight: 800;
    text-decoration: none;
    display: inline-block;
    margin-top: 1.5rem;
    transition: all 0.3s;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}

.btn-start-quiz:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.2);
}

/* Animations */
@keyframes slideUp {
    from { transform: translateY(30px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

.course-info-card {
    animation: slideUp 0.6s ease-out forwards;
}

@media (max-width: 1024px) {
    .course-detail-container {
        grid-template-columns: 1fr;
        margin-top: -2rem;
    }
    .course-header {
        flex-direction: column;
        align-items: flex-start;
    }
    .course-title-section h1 {
        font-size: 2.5rem;
    }
}

/* Transparent Navbar Over Hero */
.dashboard-header {
    background: transparent !important;
    backdrop-filter: none !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    position: absolute !important;
    width: 100% !important;
    box-shadow: none !important;
    z-index: 1000 !important;
}

.dashboard-header .header-brand span,
.dashboard-header .nav-item,
.dashboard-header .icon-btn,
.dashboard-header .user-profile-toggle,
.dashboard-header #eye-nav-toggle,
.dashboard-header .toggle-arrow,
.dashboard-header .header-brand {
    color: white !important;
}

.dashboard-header .icon-btn i {
    color: white !important;
}

.dashboard-header .nav-item:hover,
.dashboard-header .nav-item.active {
    color: white !important;
}

.dashboard-header .nav-item.active::after {
    background: white !important;
    box-shadow: 0 2px 4px rgba(255, 255, 255, 0.3) !important;
}

.dashboard-header .search-bar-compact {
    background: rgba(255, 255, 255, 0.1) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
}

.dashboard-header .search-bar-compact i,
.dashboard-header .search-bar-compact input {
    color: white !important;
}

.dashboard-header .search-bar-compact input::placeholder {
    color: rgba(255, 255, 255, 0.6) !important;
}
</style>
{% endblock %}

{% block student_content %}
<!-- Hero Section -->
<section class="course-detail-hero" style="padding-top: 130px;">
    <div class="hero-background"></div>
    <div class="hero-content">
        <div class="breadcrumb">
            <a href="{{ path('app_student_courses') }}"><i class="fas fa-chevron-left"></i> Retour</a>
            <span>/</span>
            <a href="{{ path('app_student_courses') }}">Cours</a>
            <span>/</span>
            <a href="{{ path('app_student_category_show', {'id': course.categorieCours.id}) }}">{{ course.categorieCours.titre }}</a>
            <span>/</span>
            <span>{{ course.nom }}</span>
        </div>
        
        <div class="course-header">
            <div class="course-title-section">
                <div class="course-meta-badges" style="margin-bottom: 1rem;">
                    <span class="course-badge badge-category">
                        <i class="fas fa-folder-open"></i> {{ course.categorieCours.titre }}
                    </span>
                    <span class="course-badge badge-level">
                        <i class="fas fa-layer-group"></i> {{ course.niveau }}
                    </span>
                    <span class="course-badge badge-duration">
                        <i class="fas fa-clock"></i> {{ course.duree }}h de contenu
                    </span>
                </div>
                <h1>{{ course.nom }}</h1>
            </div>
            
            <div class="course-actions-header">
                <a href="{{ path('app_student_category_show', {'id': course.categorieCours.id}) }}" class="btn-back-hero">
                    <i class="fas fa-th-large"></i> Catalogue
                </a>
                {% if course.quiz %}
                    <a href="{{ path('app_student_take_formulaire', {'id': course.quiz.id}) }}" class="btn-enroll-hero">
                        <i class="fas fa-graduation-cap"></i> Passer le Quiz
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<div class="course-detail-container">
    <!-- Left Column -->
    <div class="card-stack">
        <!-- Media Card (Replacing Hero Image with Video if available) -->
        <div class="course-info-card" style="padding: 0; overflow: hidden; background: #000; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            <div style="aspect-ratio: 21/9; width: 100%;">
                {% if course.typeMedia == 'video_intro' %}
                    {% if 'youtube.com' in course.mediaUrl or 'youtu.be' in course.mediaUrl %}
                        {% set videoId = '' %}
                        {% if 'v=' in course.mediaUrl %}{% set videoId = course.mediaUrl|split('v=')|last|split('&')|first %}
                        {% elseif 'youtu.be/' in course.mediaUrl %}{% set videoId = course.mediaUrl|split('youtu.be/')|last|split('?')|first %}
                        {% elseif 'embed/' in course.mediaUrl %}{% set videoId = course.mediaUrl|split('embed/')|last|split('?')|first %}
                        {% endif %}
                        <iframe width="100%" height="100%" src="https://www.youtube.com/embed/{{ videoId }}?autoplay=0&rel=0&modestbranding=1" frameborder="0" allow="encrypted-media" allowfullscreen></iframe>
                    {% else %}
                        <video controls style="width: 100%; height: 100%; object-fit: contain;">
                            <source src="{{ course.mediaUrl }}" type="video/mp4">
                        </video>
                    {% endif %}
                {% else %}
                    {% set isValidUrl = course.mediaUrl and (course.mediaUrl starts with 'http' or course.mediaUrl starts with '/' or course.mediaUrl starts with 'data:') %}
                    <img src="{{ isValidUrl ? course.mediaUrl : 'https://placehold.co/1200x514/1e1b4b/ffffff?text=' ~ course.nom|url_encode }}" style="width:100%; height:100%; object-fit:cover;">
                {% endif %}
            </div>
        </div>

        <!-- Objectives Card -->
        <div class="course-info-card">
            <h2 class="section-title"><i class="fas fa-sparkles"></i> Essence du cours</h2>
            <div class="objectives-grid">
                <div class="objective-item">
                    <i class="far fa-check-circle"></i> <span>Maîtriser les concepts fondamentaux de {{ course.nom }}</span>
                </div>
                <div class="objective-item">
                    <i class="far fa-check-circle"></i> <span>Mettre en œuvre des solutions pratiques et réelles</span>
                </div>
                <div class="objective-item">
                    <i class="far fa-check-circle"></i> <span>Comprendre les meilleures pratiques industrielles</span>
                </div>
                <div class="objective-item">
                    <i class="far fa-check-circle"></i> <span>Obtenir les compétences nécessaires pour vos projets</span>
                </div>
            </div>
        </div>

        <!-- Description Card -->
        <div class="course-info-card">
            <h2 class="section-title"><i class="fas fa-align-left"></i> À propos du cours</h2>
            <div class="course-description">
                {{ course.description }}
            </div>
        </div>

        <!-- Timeline / Curriculum Card -->
        <div class="course-info-card">
            <h2 class="section-title"><i class="fas fa-route"></i> Plan du Parcours</h2>
            <div class="timeline-modern">
                {% for otherCourse in course.categorieCours.cours %}
                    <div class="timeline-modern-item {{ otherCourse.id == course.id ? 'active' : '' }}">
                        <div class="timeline-icon">
                            <i class="fas {{ otherCourse.id == course.id ? 'fa-play' : 'fa-book-open' }}"></i>
                        </div>
                        <div class="timeline-content">
                            <div style="display: flex; justify-content: space-between; align-items: start;">
                                <div>
                                    <h4>
                                        {{ otherCourse.nom }}
                                        {% if otherCourse.id == course.id %}
                                            <span style="font-size: 0.65rem; background: #6366f1; color: white; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 8px; vertical-align: middle;">MODULE ACTUEL</span>
                                        {% endif %}
                                    </h4>
                                    <p>Module {{ loop.index }} • {{ otherCourse.duree }} Heures</p>
                                </div>
                                {% if otherCourse.id != course.id %}
                                    <a href="{{ path('app_student_course_show', {'id': otherCourse.id}) }}" style="color: #6366f1; text-decoration: none; font-weight: 700; font-size: 0.85rem;">Voir le cours</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Quiz CTA -->
        {% if course.quiz %}
        <div class="quiz-cta-card">
            <div style="font-size: 3rem; margin-bottom: 1rem;"><i class="fas fa-graduation-cap"></i></div>
            <h2 style="color: white; font-weight: 900; margin-bottom: 1rem;">Validez vos acquis</h2>
            <p style="opacity: 0.9; font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.6;">
                Êtes-vous prêt à tester vos connaissances ? Complétez le quiz de validation avec un score de plus de 50% pour valider ce module avec succès !
            </p>
            <a href="{{ path('app_student_take_formulaire', {'id': course.quiz.id}) }}" class="btn-start-quiz">
                Commencer le Quiz maintenant
            </a>
        </div>
        {% endif %}

        <!-- Recommendations Section -->
        {% if recommendations is defined and recommendations|length > 0 %}
            <div class="course-info-card">
                <h2 class="section-title"><i class="fas fa-lightbulb"></i> Suggestions pour la suite</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
                    {% for rec in recommendations %}
                        {% if rec.id != course.id %}
                            <a href="{{ path('app_student_course_show', {id: rec.id}) }}" style="text-decoration: none; color: inherit;">
                                <div style="background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 20px; padding: 1.25rem; transition: all 0.3s;" onmouseover="this.style.borderColor='#6366f1'; this.style.transform='translateY(-5px)'" onmouseout="this.style.borderColor='#f1f5f9'; this.style.transform='translateY(0)'">
                                    <img src="{{ rec.mediaUrl }}" alt="{{ rec.nom }}" onerror="this.src='https://placehold.co/600x400/6366f1/ffffff?text={{ rec.nom|url_encode }}'" style="width: 100%; height: 160px; object-fit: cover; border-radius: 12px; margin-bottom: 1rem;">
                                    <h4 style="font-weight: 800; color: #1e293b; margin-bottom: 0.5rem; font-size: 1rem;">{{ rec.nom }}</h4>
                                    <div style="display: flex; gap: 1rem; color: #94a3b8; font-size: 0.8rem; font-weight: 700;">
                                        <span><i class="far fa-user"></i> {{ rec.enseignant }}</span>
                                        <span><i class="far fa-clock"></i> {{ rec.duree }}h</span>
                                    </div>
                                </div>
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Right Column (Sidebar) -->
    <div class="course-sidebar">
        <div class="sidebar-sticky">
            <!-- Stats Box -->
            <div class="stat-box">
                <span class="stat-number">2.5k+</span>
                <span class="stat-label">Étudiants engagés</span>
            </div>

            <!-- Specs Box -->
            <div class="course-info-card" style="padding: 2rem;">
                <h3 class="section-title" style="font-size: 1.1rem; margin-bottom: 1.5rem;"><i class="fas fa-info-circle"></i> Spécifications</h3>
                <div class="info-list">
                    <div class="info-row">
                        <div class="row-label"><i class="fas fa-chalkboard-teacher"></i> Formateur</div>
                        <div class="row-value">{{ course.enseignant }}</div>
                    </div>
                    <div class="info-row">
                        <div class="row-label"><i class="fas fa-signal"></i> Niveau</div>
                        <div class="row-value">{{ course.niveau }}</div>
                    </div>
                    <div class="info-row">
                        <div class="row-label"><i class="far fa-calendar-alt"></i> Créé le</div>
                        <div class="row-value">Février 2026</div>
                    </div>
                    <div class="info-row">
                        <div class="row-label"><i class="fas fa-globe"></i> Langue</div>
                        <div class="row-value">Français</div>
                    </div>
                </div>

                <!-- Instructor Info -->
                <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid #f1f5f9;">
                    <h3 class="section-title" style="font-size: 1.1rem; margin-bottom: 1.5rem;"><i class="fas fa-user-circle"></i> L'Instructeur</h3>
                    <div style="display: flex; align-items: center; gap: 1.25rem;">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed={{ course.enseignant|url_encode }}&backgroundColor=b6e3f4" style="width: 50px; height: 50px; border-radius: 14px; border: 2px solid #6366f120;" alt="Formateur">
                        <div>
                            <div style="font-weight: 800; color: #1e293b; font-size: 1rem;">{{ course.enseignant }}</div>
                            <div style="font-size: 0.8rem; color: #6366f1; font-weight: 700;">Expert {{ course.categorieCours.titre }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Success Box -->
            <div class="course-info-card" style="margin-top: 2rem; background: #1e1b4b; color: white; border: none; padding: 2.5rem; text-align: center;">
                <div style="font-size: 2.5rem; margin-bottom: 1rem;"><i class="fas fa-award"></i></div>
                <h4 style="font-weight: 800; margin-bottom: 1rem;">Certification Incluse</h4>
                <p style="font-size: 0.85rem; opacity: 0.8; line-height: 1.6; margin-bottom: 0;">
                    Validez ce cours et obtenez votre certificat de réussite InnoLearn pour booster votre carrière et votre CV.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
