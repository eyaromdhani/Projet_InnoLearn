<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.EditQuizController"
      stylesheets="@modern_style.css"
      styleClass="main-bg"
      prefHeight="800.0" prefWidth="1200.0">

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" spacing="30" style="-fx-background-color: white; -fx-padding: 15 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
        <Label text="InnoLearn" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6366F1;"/>
        
        <HBox alignment="CENTER" spacing="20">
            <Hyperlink text="Accueil" style="-fx-text-fill: #64748B; -fx-underline: false;"/>
            <Hyperlink text="Mes Cours" style="-fx-text-fill: #64748B; -fx-underline: false;"/>
            <Hyperlink text="Événements" style="-fx-text-fill: #64748B; -fx-underline: false;"/>
            <Hyperlink text="Quiz" style="-fx-text-fill: #6366F1; -fx-underline: true; -fx-font-weight: bold;"/>
        </HBox>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <HBox alignment="CENTER" spacing="15">
            <Button text="Rechercher" style="-fx-background-color: transparent; -fx-text-fill: #64748B;"/>
            <Label text="InnoLearn Teacher" style="-fx-text-fill: #6366F1; -fx-font-weight: bold;"/>
            <Circle radius="15" fill="#E2E8F0"/>
        </HBox>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS" style="-fx-padding: 40;">
        <!-- The White Card -->
        <VBox maxWidth="600" spacing="20" styleClass="form-card" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <!-- Edit Icon Placeholder -->
                <Label text="🖊️" style="-fx-font-size: 20px; -fx-text-fill: #A36CFE; -fx-alignment: center;"/>
                <Label text="Modifier le Quiz" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            </HBox>

            <VBox spacing="8">
                <Label text="Titre du Quiz" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                <TextField fx:id="tfTitre" promptText="Ex: Introduction au Design UI" styleClass="text-field-custom" prefHeight="45"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                <TextArea fx:id="taDescription" promptText="Décrivez les objectifs de ce quiz..." styleClass="text-area-custom" prefHeight="120" wrapText="true"/>
            </VBox>

            <HBox spacing="20">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Temps Limite (minutes)" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <TextField fx:id="tfTempsLimite" promptText="En minutes" styleClass="text-field-custom" prefHeight="45"/>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Catégorie" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <TextField fx:id="tfCategory" promptText="Ex: UI/UX, Backend..." styleClass="text-field-custom" prefHeight="45"/>
                </VBox>
            </HBox>

            <!-- Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 20 0 0 0;">
                <Button text="← Retour" onAction="#handleRetour" styleClass="button-secondary" prefHeight="45" prefWidth="120"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="💾 Enregistrer les Modifications" onAction="#handleEnregistrer" styleClass="button-primary-purple" prefHeight="45" prefWidth="250"/>
            </HBox>

        </VBox>
    </StackPane>

</VBox>
