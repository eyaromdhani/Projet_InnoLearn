<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Ticket d'Inscription - {{ inscription.event.titre }}</title>
    <style>
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            color: #1e1b4b;
            margin: 0;
            padding: 40px;
            background-color: #f8fafc;
        }
        .ticket-container {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border: 1px solid #e2e8f0;
        }
        .header {
            background-color: #ffffff;
            padding: 30px;
            text-align: center;
            border-bottom: 2px dashed #e2e8f0;
        }
        .header p {
            margin: 0;
            color: #6366f1;
            font-weight: 700;
            letter-spacing: 2px;
            font-size: 14px;
        }
        .content {
            padding: 40px;
        }
        .event-info {
            margin-bottom: 30px;
        }
        .event-title {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 10px;
            color: #1e1b4b;
        }
        .event-type {
            display: inline-block;
            padding: 6px 12px;
            background-color: #e0e7ff;
            color: #4338ca;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .details-grid {
            display: table;
            width: 100%;
            margin-top: 30px;
        }
        .detail-item {
            display: table-cell;
            width: 50%;
            padding-bottom: 20px;
        }
        .detail-label {
            font-size: 12px;
            color: #64748b;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 5px;
        }
        .detail-value {
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
        }
        .qr-section {
            text-align: center;
            margin-top: 40px;
            padding-top: 30px;
            border-top: 1px solid #f1f5f9;
        }
        .qr-code {
            width: 150px;
            height: 150px;
            margin-bottom: 15px;
        }
        .footer {
            background-color: #1e1b4b;
            color: #ffffff;
            padding: 20px;
            text-align: center;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="ticket-container">
        <div class="header">
            <p>INNOLEARN - CONFIRMATION D'INSCRIPTION</p>
            <div style="font-size: 24px; font-weight: 800; color: #1e1b4b; margin: 10px 0;">{{ inscription.event.titre }}</div>
            <div style="font-size: 14px; color: #6366f1; font-weight: 600;">{{ inscription.event.typeEvenement.value|default(inscription.event.typeEvenement) }}</div>
        </div>

        <div class="content">
            <div class="event-info">
                <div class="event-title">Détails de votre participation</div>
                <div class="event-type">Confirmé</div>
            </div>

            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">Participant</div>
                    <div class="detail-value">{{ inscription.name }}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Email</div>
                    <div class="detail-value">{{ inscription.email }}</div>
                </div>
            </div>

            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">Date de l'événement</div>
                    <div class="detail-value">{{ inscription.event.dateDebut|date('d/m/Y H:i') }}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Lieu</div>
                    <div class="detail-value">{{ inscription.event.lieu ?: 'En ligne' }}</div>
                </div>
            </div>

            <div class="qr-section">
                {% if qrCodeSvg %}
                    <img src="{{ qrCodeSvg }}" class="qr-code" alt="QR Code">
                {% endif %}
                <p style="font-size: 12px; color: #94a3b8;">Scannez pour voir l'emplacement sur Google Maps</p>
                <a href="{{ mapsUrl }}" style="color: #6366f1; text-decoration: none; font-size: 11px;">{{ mapsUrl }}</a>
            </div>
        </div>

        <div class="footer">
            &copy; {{ "now"|date("Y") }} InnoLearn. Veuillez présenter ce ticket à l'entrée.
        </div>
    </div>
</body>
</html>
