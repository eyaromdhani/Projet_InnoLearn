<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="0.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AdminDashboardController">
    <children>
        <!-- Top Navbar -->
        <fx:include fx:id="navbar" source="Navbar.fxml" />

        <!-- Admin Dashboard Header -->
        <VBox styleClass="admin-header">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <Label styleClass="admin-title-main" text="Dashboard Overview" />
            </children>
        </VBox>

        <!-- Main Content (Tabbed) -->
        <VBox VBox.vgrow="ALWAYS">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
            <children>
                <VBox spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 8);">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
                    </padding>
                    <children>
                        <TabPane fx:id="mainTabPane" styleClass="admin-tab-pane" tabClosingPolicy="UNAVAILABLE">
                            <tabs>
                                <!-- TAB 1: OFFRES DE STAGE -->
                                <Tab text="Offres de Stage">
                                    <content>
                                        <VBox spacing="20.0">
                                            <padding>
                                                <Insets top="25.0" />
                                            </padding>
                                            <children>
                                                <!-- Action Bar -->
                                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                                    <children>
                                                        <VBox spacing="5.0">
                                                            <children>
                                                                <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;" text="Offres de Stage" />
                                                                <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;" text="Gérez les offres de stage et suivez les candidatures." />
                                                            </children>
                                                        </VBox>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <TextField fx:id="txtSearchOffres" prefWidth="250.0" promptText="Rechercher une offre..." styleClass="recruiter-search-field" />
                                                        <Button onAction="#handleExportPDF" style="-fx-background-color: #fee2e2; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-background-radius: 8px;" text="PDF" />
                                                        <Button onAction="#handleNewOffre" styleClass="btn-publish" text="+ Nouvelle Offre" />
                                                    </children>
                                                </HBox>

                                                <!-- List -->
                                                <ListView fx:id="listOffres" prefHeight="450.0" style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-padding: 10;" />
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                                <!-- TAB 2: CANDIDATURES -->
                                <Tab text="Candidatures">
                                    <content>
                                        <VBox spacing="20.0">
                                            <padding>
                                                <Insets top="25.0" />
                                            </padding>
                                            <children>
                                                <!-- Action Bar -->
                                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                                    <children>
                                                        <VBox spacing="5.0">
                                                            <children>
                                                                <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;" text="Candidatures Reçues" />
                                                                <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;" text="Suivi global des demandes de stage." />
                                                            </children>
                                                        </VBox>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <TextField fx:id="txtSearchCandidatures" prefWidth="250.0" promptText="Rechercher une candidature..." styleClass="recruiter-search-field" />
                                                        <Button onAction="#handleNewCandidature" styleClass="btn-publish" text="+ Ajouter Candidature" />
                                                    </children>
                                                </HBox>

                                                <!-- List -->
                                                <ListView fx:id="listCandidatures" prefHeight="450.0" style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-padding: 10;" />
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
