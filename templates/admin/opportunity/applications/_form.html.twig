            align-items: center;
            justify-content: center;
            color: #64748b;
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .file-upload-wrapper:hover .file-upload-icon {
            background: #4f46e5;
            color: white;
        }
        .file-upload-text { flex: 1; }
        .file-upload-filename { font-weight: 600; color: #1e293b; font-size: 0.85rem; }
        .file-upload-info { font-size: 0.75rem; color: #94a3b8; }
        
        .file-upload-surrogate.has-file {
            border-style: solid;
            border-color: #10b981;
            background: #ecfdf5;
        }
        .file-upload-surrogate.has-file .file-upload-icon {
            background: #10b981;
            color: white;
        }
        .file-upload-surrogate.has-file .file-upload-filename {
