// Helper function for depot status badges
function getDepotStatusClass(status) {
    const statusClasses = {
        'validé': 'status-complet',
        'en attente': 'status-recherche',
        'correction': 'status-encours',
        'rejeté': 'status-annule'
    };
    return statusClasses[status] || 'status-brouillon';
}

function getDepotTypeClass(type) {
    type = type.toLowerCase();
    if (type.includes('code')) return 'type-code';
    if (type.includes('rapport')) return 'type-rapport';
    if (type.includes('présentation') || type.includes('presentation')) return 'type-presentation';
    return 'type-document';
}

function getDepotIcon(type) {
    type = type.toLowerCase();
    if (type.includes('code')) return 'fa-code';
    if (type.includes('rapport')) return 'fa-file-medical';
    if (type.includes('présentation') || type.includes('presentation')) return 'fa-file-powerpoint';
    return 'fa-file-alt';
}

