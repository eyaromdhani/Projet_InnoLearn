<header class="dashboard-header">
    <div class="header-brand-wrapper">
        <a href="{{ path('app_home') }}" class="header-brand">
            <img src="{{ asset('images/logo_icon.png') }}" alt="InnoLearn">
            <span>InnoLearn</span>
        </a>
    </div>

    <nav class="header-nav">
        <a href="{{ path('app_student_home') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_student_home' ? 'active' : '' }}">
            Accueil
        </a>
        <a href="{{ path('app_student_courses') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_student_courses' ? 'active' : '' }}">
            Cours
        </a>
        <a href="{{ path('app_student_projects') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_student_projects' ? 'active' : '' }}">
            Projets
        </a>
        <a href="{{ path('app_student_events') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_student_events' ? 'active' : '' }}">
            &Eacute;v&eacute;nements
        </a>
        <a href="{{ path('app_student_career') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_student_career' ? 'active' : '' }}">
            Stages
        </a>
        <a href="{{ path('app_book_index') }}" class="nav-item {{ app.request.attributes.get('_route') starts with 'app_book' ? 'active' : '' }}">
            Livres
        </a>
        <a href="{{ path('app_student_quizzes') }}" class="nav-item {{ app.request.attributes.get('_route') == 'app_student_quizzes' ? 'active' : '' }}">
            Quiz
        </a>
    </nav>
    
    <div class="header-actions">
        <div class="search-bar-compact">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Rechercher&hellip;">
        </div>

        <!-- Eye Tracking Toggle -->
        <button id="eye-nav-toggle" class="eye-nav-btn" title="Activer la navigation par le regard">
            <i class="fas fa-eye"></i>
            <span class="status-dot"></span>
        </button>

        <!-- AI Page Reader -->
        <button id="read-page-btn" class="icon-btn ai-nav-btn" title="Analyser cette page avec l'IA">
            <i class="fas fa-magic" style="color: #6366f1;"></i>
        </button>

        <button class="icon-btn" title="Notifications">
            <i class="fas fa-bell"></i>
            <span class="badge-dot"></span>
        </button>
        
        <div class="user-profile-toggle" id="profileToggle">
            <div class="avatar-wrapper">
                <img src="https://ui-avatars.com/api/?name={{ app.user.name|url_encode }}&background=6366f1&color=fff&bold=true" alt="User Avatar">
                <span class="status-indicator online"></span>
            </div>
        </div>
    </div>
</header>

<script src="{{ asset('js/page-reader.js') }}"></script>
