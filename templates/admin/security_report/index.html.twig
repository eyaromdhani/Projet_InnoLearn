{% extends 'admin/layout.html.twig' %}

{% block title %}Security Report - Admin Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
{% endblock %}

{% block admin_content %}
<div class="container-fluid security-report-page px-3 px-md-4 py-3 py-md-4">
    <!-- Header Section -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-2 fw-bold text-dark d-flex align-items-center gap-2"><span class="icon-chip icon-chip-primary">🛡️</span>Security Report</h1>
                {% if last_scanned %}
                    <p class="text-muted mb-0 small">
                        <i class="fas fa-clock"></i>
                        Last scanned: <strong>{{ last_scanned }}</strong>
                    </p>
                {% endif %}
            </div>
            <form method="POST" action="{{ path('admin_security_report_refresh') }}" style="display: inline;">
                <button type="submit" class="btn btn-primary btn-sm rounded-2">
                    <i class="fas fa-sync-alt me-2"></i> Run Scan
                </button>
            </form>
        </div>
    </div>

    <!-- Alerts -->
    {% if app.flashes %}
        <div class="mb-4">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type === 'error' ? 'danger' : type }} alert-dismissible fade show rounded-2 border-0 shadow-sm mb-3" role="alert">
                        <i class="fas fa-{{ type === 'error' ? 'exclamation-circle' : 'check-circle' }} me-2"></i>
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}

    {% if report %}
        <!-- Score Cards -->
        <div class="row g-3 mb-4">
            <!-- Security Score Card -->
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 metric-card score-card">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h6 class="card-title text-uppercase text-muted mb-0 section-label">Security Score</h6>
                            <span class="icon-chip icon-chip-primary">🛡️</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <h2 class="fw-bold text-primary mb-0 metric-value">{{ report.security_score ?? 'N/A' }}</h2>
                            <span class="text-muted metric-max">/100</span>
                        </div>
                        {% if report.security_score >= 80 %}
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1 progress-thin">
                                    <div class="progress-bar bg-success" style="width: {{ report.security_score }}%;"></div>
                                </div>
                                <span class="badge bg-success-subtle text-success px-2 py-1 badge-pill">Excellent</span>
                            </div>
                        {% elseif report.security_score >= 60 %}
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1 progress-thin">
                                    <div class="progress-bar bg-warning" style="width: {{ report.security_score }}%;"></div>
                                </div>
                                <span class="badge bg-warning-subtle text-warning px-2 py-1 badge-pill">Good</span>
                            </div>
                        {% else %}
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1 progress-thin">
                                    <div class="progress-bar bg-danger" style="width: {{ report.security_score|default(0) }}%;"></div>
                                </div>
                                <span class="badge bg-danger-subtle text-danger px-2 py-1 badge-pill">Needs Attention</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Status Card -->
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 metric-card status-card">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h6 class="card-title text-uppercase text-muted mb-0 section-label">Status</h6>
                            <span class="icon-chip icon-chip-success">✓</span>
                        </div>
                        <div class="mb-3">
                            {% if report.status == 'good' %}
                                <span class="badge bg-success-subtle text-success px-3 py-2 badge-pill">
                                    <i class="fas fa-check-circle me-1"></i> {{ report.status|upper }}
                                </span>
                            {% else %}
                                <span class="badge bg-warning-subtle text-warning px-3 py-2 badge-pill">
                                    <i class="fas fa-exclamation-triangle me-1"></i> {{ report.status|upper }}
                                </span>
                            {% endif %}
                        </div>
                        <p class="text-muted small mb-0">{{ report.status == 'good' ? 'All security checks operational' : 'Some checks require attention' }}</p>
                    </div>
                </div>
            </div>

            <!-- Framework Card -->
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 metric-card framework-card">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h6 class="card-title text-uppercase text-muted mb-0 section-label">Framework</h6>
                            <span class="icon-chip icon-chip-info">{ }</span>
                        </div>
                        <h4 class="fw-bold text-info mb-2">{{ report.framework ?? 'N/A' }}</h4>
                        <p class="text-muted small mb-0">
                            Enterprise security framework
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Security Checks Table -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-light border-bottom px-4 py-3 rounded-top-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-list-ul text-primary"></i>
                            <h6 class="mb-0 fw-bold">Security Checks</h6>
                        </div>
                    </div>
                    <div class="table-responsive">
                        {% if report.security_checks %}
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light border-bottom">
                                    <tr>
                                        <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">CHECK</th>
                                        <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">STATUS</th>
                                        <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">DETAILS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for checkName, checkData in report.security_checks %}
                                        <tr>
                                            <td class="px-4 py-3">
                                                <div class="fw-600 text-dark text-nowrap">
                                                    {% if checkName == 'composer_audit' %}
                                                        <i class="fas fa-box text-primary me-2"></i>
                                                    {% elseif checkName == 'symfony_security' %}
                                                        <i class="fas fa-lock text-success me-2"></i>
                                                    {% elseif checkName == 'nelmio_security' %}
                                                        <i class="fas fa-shield-alt text-info me-2"></i>
                                                    {% elseif checkName == 'file_permissions' %}
                                                        <i class="fas fa-file-alt text-warning me-2"></i>
                                                    {% elseif checkName == 'database' %}
                                                        <i class="fas fa-database text-danger me-2"></i>
                                                    {% endif %}
                                                    {{ checkName|replace({'_': ' '})|title }}
                                                </div>
                                            </td>
                                            <td class="px-4 py-3">
                                                {% if checkData.status == 'pass' %}
                                                    <span class="badge bg-success-subtle text-success px-3 py-2" style="font-size: 0.75rem;">
                                                        <i class="fas fa-check-circle me-1"></i> PASS
                                                    </span>
                                                {% elseif checkData.status == 'warning' %}
                                                    <span class="badge bg-warning-subtle text-warning px-3 py-2" style="font-size: 0.75rem;">
                                                        <i class="fas fa-exclamation-triangle me-1"></i> WARNING
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-danger-subtle text-danger px-3 py-2" style="font-size: 0.75rem;">
                                                        <i class="fas fa-times-circle me-1"></i> ERROR
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td class="px-4 py-3">
                                                <small class="text-muted">
                                                    {% if checkName == 'composer_audit' %}
                                                        {{ checkData.vulns_found }} vulnerabilities
                                                    {% elseif checkName == 'symfony_security' %}
                                                        {{ checkData.issues }} issues
                                                    {% elseif checkName == 'nelmio_security' %}
                                                        {{ checkData.bundle_active ? 'Bundle Active' : 'Bundle Inactive' }}
                                                    {% elseif checkName == 'file_permissions' %}
                                                        {{ checkData.warnings|length }} warnings
                                                    {% elseif checkName == 'database' %}
                                                        {{ checkData.accessible ? 'Accessible' : 'Not Accessible' }}
                                                    {% endif %}
                                                </small>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <div class="p-4 text-muted text-center">No security checks available</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Frontend Login Alerts -->
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 alert-metric-card alert-admin-role-card">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="text-uppercase text-muted mb-0 section-label">Admin Role Blocks</h6>
                            <span class="icon-chip icon-chip-warning">👤</span>
                        </div>
                        <h3 class="fw-bold mb-1 metric-value-sm">{{ frontend_alert_summary.admin_role_frontend_block|default(0) }}</h3>
                        <p class="text-muted small mb-0">Blocked ROLE_ADMIN logins on frontend</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 alert-metric-card alert-weak-password-card">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="text-uppercase text-muted mb-0 section-label">Weak Password Alerts</h6>
                            <span class="icon-chip icon-chip-danger">🔑</span>
                        </div>
                        <h3 class="fw-bold mb-1 metric-value-sm">{{ frontend_alert_summary.weak_password_attempt|default(0) }}</h3>
                        <p class="text-muted small mb-0">Detected weak passwords in frontend login attempts</p>
                    </div>
                </div>
            </div>
            <div class="col-md-12 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 alert-metric-card alert-admin-pattern-card">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="text-uppercase text-muted mb-0 section-label">Admin Credential Patterns</h6>
                            <span class="icon-chip icon-chip-info">🕵️</span>
                        </div>
                        <h3 class="fw-bold mb-1 metric-value-sm">{{ frontend_alert_summary.admin_credential_pattern|default(0) }}</h3>
                        <p class="text-muted small mb-0">Suspicious admin-like usernames/emails detected</p>
                    </div>
                </div>
            </div>
        </div>

        {% if frontend_alerts is not empty %}
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-light border-bottom px-4 py-3 rounded-top-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-bell text-danger"></i>
                                <h6 class="mb-0 fw-bold">Recent Frontend Security Alerts</h6>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light border-bottom">
                                    <tr>
                                        <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">TIME</th>
                                        <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">TYPE</th>
                                        <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">SEVERITY</th>
                                        <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">MESSAGE</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for alert in frontend_alerts %}
                                        <tr>
                                            <td class="px-4 py-3"><small class="text-muted">{{ alert.timestamp|default('N/A') }}</small></td>
                                            <td class="px-4 py-3"><span class="fw-600">{{ alert.type|default('unknown')|replace({'_': ' '})|title }}</span></td>
                                            <td class="px-4 py-3">
                                                {% set severity = alert.severity|default('warning') %}
                                                {% if severity == 'urgent' %}
                                                    <span class="badge bg-danger-subtle text-danger px-3 py-2" style="font-size: 0.75rem;"><i class="fas fa-radiation me-1"></i> URGENT</span>
                                                {% else %}
                                                    <span class="badge bg-warning-subtle text-warning px-3 py-2" style="font-size: 0.75rem;"><i class="fas fa-exclamation-triangle me-1"></i> WARNING</span>
                                                {% endif %}
                                            </td>
                                            <td class="px-4 py-3"><small class="text-muted">{{ alert.message|default('No message') }}</small></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Dependencies -->
        {% if composer_audit %}
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-light border-bottom px-4 py-3 rounded-top-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-box-open text-primary"></i>
                                <h6 class="mb-0 fw-bold">Dependencies</h6>
                            </div>
                        </div>
                        <div class="table-responsive">
                            {% set advisories = composer_audit.advisories|default([]) %}
                            {% set abandoned = composer_audit.abandoned|default([]) %}
                            
                            {% if advisories|length > 0 or abandoned|length > 0 %}
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light border-bottom">
                                        <tr>
                                            <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">PACKAGE</th>
                                            <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">ISSUE</th>
                                            <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">DESCRIPTION</th>
                                            <th class="px-4 py-3 text-muted fw-600" style="font-size: 0.8rem;">TYPE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for pkg, issues in advisories %}
                                            {% for issue in issues %}
                                                <tr>
                                                    <td class="px-4 py-3"><code class="text-danger">{{ pkg }}</code></td>
                                                    <td class="px-4 py-3"><span class="fw-600">{{ issue.title ?? 'Vulnerability' }}</span></td>
                                                    <td class="px-4 py-3"><small class="text-muted">{{ issue.description ?? 'No description' }}</small></td>
                                                    <td class="px-4 py-3"><span class="badge bg-danger-subtle text-danger px-3 py-2" style="font-size: 0.75rem;"><i class="fas fa-exclamation-triangle me-1"></i> VULNERABILITY</span></td>
                                                </tr>
                                            {% endfor %}
                                        {% endfor %}
                                        
                                        {% for pkg, names in abandoned %}
                                            <tr>
                                                <td class="px-4 py-3"><code class="text-warning">{{ pkg }}</code></td>
                                                <td class="px-4 py-3"><span class="fw-600">Abandoned</span></td>
                                                <td class="px-4 py-3"><small class="text-muted">Package no longer maintained</small></td>
                                                <td class="px-4 py-3"><span class="badge bg-warning-subtle text-warning px-3 py-2" style="font-size: 0.75rem;"><i class="fas fa-circle-notch me-1"></i> ABANDONED</span></td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% else %}
                                <div class="p-4 text-center empty-state">
                                    <i class="fas fa-check-circle text-success" style="font-size: 2rem; margin-bottom: 0.75rem; display: block;"></i>
                                    <h6 class="fw-600 text-success mb-2">All Dependencies Secure</h6>
                                    <p class="text-muted small mb-0">No known vulnerabilities or abandoned packages found in your dependencies.</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

    {% else %}
        <div class="alert alert-info border-0 rounded-3 shadow-sm mb-0">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-info-circle" style="font-size: 1.3rem;"></i>
                <div>
                    <h6 class="mb-1">No Report Available</h6>
                    <p class="mb-0">Run a security scan to generate the report.</p>
                </div>
            </div>
        </div>
    {% endif %}

</div>

<style>
    .security-report-page {
        max-width: 1480px;
    }

    .security-report-page .card {
        background: #fff;
    }

    code {
        background-color: rgba(0, 0, 0, 0.05);
        padding: 0.3rem 0.5rem;
        border-radius: 4px;
        font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
        font-size: 0.85rem;
    }
    
    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }
    
    .bg-warning-subtle {
        background-color: rgba(255, 193, 7, 0.1) !important;
    }
    
    .bg-danger-subtle {
        background-color: rgba(220, 53, 69, 0.1) !important;
    }
    
    .text-success-subtle {
        color: #198754 !important;
    }
    
    .text-warning-subtle {
        color: #ffc107 !important;
    }
    
    .text-danger-subtle {
        color: #dc3545 !important;
    }
    
    .rounded-3 {
        border-radius: 12px !important;
    }
    
    .rounded-2 {
        border-radius: 8px !important;
    }
    
    .rounded-top-3 {
        border-top-left-radius: 12px !important;
        border-top-right-radius: 12px !important;
    }
    
    .card {
        transition: all 0.3s ease;
        min-height: 120px;
    }
    
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.02);
    }
    
    .fw-600 {
        font-weight: 600;
    }
    
    .btn-sm {
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
    }

    .section-label {
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        font-weight: 700;
    }

    .metric-value {
        font-size: 2.05rem;
        line-height: 1;
    }

    .metric-value-sm {
        font-size: 1.8rem;
        line-height: 1;
    }

    .metric-max {
        font-size: 0.9rem;
    }

    .progress-thin {
        height: 7px;
    }

    .badge-pill {
        font-size: 0.75rem;
        border-radius: 999px;
    }

    .metric-card .card-body,
    .alert-metric-card .card-body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.35rem;
    }

    .score-card {
        border-left: 4px solid #0d6efd !important;
        background: linear-gradient(180deg, rgba(13, 110, 253, 0.06), rgba(13, 110, 253, 0.01));
    }

    .status-card {
        border-left: 4px solid #198754 !important;
        background: linear-gradient(180deg, rgba(25, 135, 84, 0.06), rgba(25, 135, 84, 0.01));
    }

    .framework-card {
        border-left: 4px solid #0dcaf0 !important;
        background: linear-gradient(180deg, rgba(13, 202, 240, 0.06), rgba(13, 202, 240, 0.01));
    }

    .alert-admin-role-card {
        border-left: 4px solid #ffc107 !important;
        background: linear-gradient(180deg, rgba(255, 193, 7, 0.08), rgba(255, 193, 7, 0.02));
    }

    .alert-weak-password-card {
        border-left: 4px solid #dc3545 !important;
        background: linear-gradient(180deg, rgba(220, 53, 69, 0.08), rgba(220, 53, 69, 0.02));
    }

    .alert-admin-pattern-card {
        border-left: 4px solid #0dcaf0 !important;
        background: linear-gradient(180deg, rgba(13, 202, 240, 0.08), rgba(13, 202, 240, 0.02));
    }

    .icon-chip {
        width: 1.9rem;
        height: 1.9rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1;
    }

    .icon-chip-primary {
        background: rgba(13, 110, 253, 0.15);
        color: #0d6efd;
    }

    .icon-chip-success {
        background: rgba(25, 135, 84, 0.15);
        color: #198754;
    }

    .icon-chip-info {
        background: rgba(13, 202, 240, 0.17);
        color: #0b7285;
    }

    .icon-chip-warning {
        background: rgba(255, 193, 7, 0.2);
        color: #9a6700;
    }

    .icon-chip-danger {
        background: rgba(220, 53, 69, 0.16);
        color: #b42318;
    }

    .empty-state {
        min-height: 160px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
    }

    @media (max-width: 768px) {
        .metric-value {
            font-size: 1.7rem;
        }

        .metric-value-sm {
            font-size: 1.5rem;
        }

        .card {
            min-height: auto;
        }

        .icon-chip {
            width: 1.7rem;
            height: 1.7rem;
            font-size: 0.8rem;
        }
    }
</style>
{% endblock %}
