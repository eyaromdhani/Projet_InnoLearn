<script>
    document.addEventListener('DOMContentLoaded', function() {
        const input = document.getElementById('event_lieu');
        const suggestionsContainer = document.getElementById('suggestions-container');
        let timeout = null;

        input.addEventListener('input', function() {
            const query = this.value;
            
            // Clear previous timeout
            if (timeout) clearTimeout(timeout);
            
            // Hide if empty
            if (query.length < 3) {
                suggestionsContainer.style.display = 'none';
                return;
            }

            // Debounce api call
            timeout = setTimeout(() => {
                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5`)
                    .then(response => response.json())
                    .then(data => {
                        suggestionsContainer.innerHTML = '';
                        
                        if (data.length > 0) {
                            data.forEach(item => {
                                const div = document.createElement('div');
                                div.style.padding = '0.75rem 1rem';
                                div.style.cursor = 'pointer';
                                div.style.borderBottom = '1px solid #f1f5f9';
                                div.style.fontSize = '0.9rem';
                                div.style.color = '#1e293b';
                                div.style.transition = 'background 0.2s';
                                
                                div.onmouseover = () => div.style.background = '#f8fafc';
                                div.onmouseout = () => div.style.background = 'white';
                                
                                div.textContent = item.display_name;
                                
                                div.addEventListener('click', function() {
                                    input.value = item.display_name;
                                    suggestionsContainer.style.display = 'none';
                                });
                                
                                suggestionsContainer.appendChild(div);
                            });
                            suggestionsContainer.style.display = 'block';
                        } else {
                            suggestionsContainer.style.display = 'none';
                        }
                    })
                    .catch(error => console.error('Error fetching address:', error));
            }, 300); // Wait 300ms after user stops typing
        });

        // Close suggestions when clicking outside
        document.addEventListener('click', function(e) {
            if (e.target !== input && e.target !== suggestionsContainer) {
                suggestionsContainer.style.display = 'none';
            }
        });

        // Real-time validation
        const form = document.getElementById('eventForm');
        const titre = document.getElementById('event_titre');
        const description = document.getElementById('event_description');
        const capacite = document.getElementById('event_capacite');
        
        const titreError = document.getElementById('titre-error');
        const descriptionError = document.getElementById('description-error');
        const capaciteError = document.getElementById('capacite-error');

        function validateTitre() {
            if (titre.value.trim().length < 3) {
                titre.style.borderColor = '#ef4444';
                titreError.style.display = 'block';
                return false;
            } else {
                titre.style.borderColor = '#cbd5e1';
                titreError.style.display = 'none';
                return true;
            }
        }

        function validateDescription() {
            if (description.value.trim().length < 1) {
                description.style.borderColor = '#ef4444';
                descriptionError.style.display = 'block';
                return false;
            } else {
                description.style.borderColor = '#cbd5e1';
                descriptionError.style.display = 'none';
                return true;
            }
        }

        function validateCapacite() {
            if (parseInt(capacite.value) <= 0 || isNaN(parseInt(capacite.value))) {
                capacite.style.borderColor = '#ef4444';
                capaciteError.style.display = 'block';
                return false;
            } else {
                capacite.style.borderColor = '#cbd5e1';
                capaciteError.style.display = 'none';
                return true;
            }
        }

        titre.addEventListener('input', validateTitre);
        description.addEventListener('input', validateDescription);
        capacite.addEventListener('input', validateCapacite);

        form.addEventListener('submit', function(e) {
            const isTitreValid = validateTitre();
            const isDescriptionValid = validateDescription();
            const isCapaciteValid = validateCapacite();

            if (!isTitreValid || !isDescriptionValid || !isCapaciteValid) {
                e.preventDefault();
            }
        });
    });
</script>
