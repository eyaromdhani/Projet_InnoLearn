{% extends 'base.html.twig' %}

{% block title %}Admin Access Verification{% endblock %}

{% block navbar %}{% endblock %}
{% block footer_wave %}{% endblock %}

{% block body %}
<main style="background:#f8fafc; min-height:100vh; display:flex; align-items:center; justify-content:center; font-family:Inter,sans-serif;">
    <div style="width:100%; max-width:760px; padding:1.25rem;">
        <div style="background:#fff; border:1px solid #e2e8f0; border-radius:18px; padding:1.2rem; box-shadow:0 14px 30px rgba(15,23,42,.07);">
            <h1 style="margin:0 0 .4rem; font-size:1.25rem; color:#0f172a;">Admin Hardware + Face Verification</h1>
            <p style="margin:0 0 1rem; color:#475569; font-size:.9rem;">USB checks start automatically. Start camera when you are ready.</p>

            {% for message in app.flashes('danger') %}
                <div style="margin-bottom:.8rem; padding:.7rem .8rem; border-radius:8px; background:#fef2f2; color:#991b1b; border:1px solid #fecaca; font-weight:600;">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div style="margin-bottom:.8rem; padding:.7rem .8rem; border-radius:8px; background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; font-weight:600;">{{ message }}</div>
            {% endfor %}

            <form id="verify-form" method="post" style="margin:0;">
                <input type="hidden" name="_token" value="{{ csrf_token('admin-verify-access') }}">
                <input type="hidden" id="hardware-key-input" name="hardware_key_plain" required>
                <input type="hidden" id="face-reference-data" name="face_reference_data" required>

                <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <section style="border:1px solid #e2e8f0; border-radius:12px; padding:.9rem; background:#f8fafc;">
                        <h3 style="margin:0 0 .6rem; font-size:.9rem; color:#0f172a;"><i class="fas fa-usb"></i> USB Check</h3>
                        <p id="usb-status" style="margin:0; font-size:.82rem; color:#475569;">Detecting USB key...</p>
                        <button type="button" id="usb-retry" style="display:none; margin-top:.7rem; border:0; border-radius:8px; background:#334155; color:#fff; padding:.55rem .8rem; font-weight:700; cursor:pointer;">
                            Retry USB Detection
                        </button>
                    </section>

                    <section style="border:1px solid #e2e8f0; border-radius:12px; padding:.9rem; background:#f8fafc;">
                        <h3 style="margin:0 0 .6rem; font-size:.9rem; color:#0f172a;"><i class="fas fa-camera"></i> Face Check</h3>
                        <div style="position:relative; width:100%; aspect-ratio: 4/3; border-radius:10px; overflow:hidden; background:#000;">
                            <video id="face-video" autoplay playsinline muted style="width:100%; height:100%; object-fit:cover;"></video>
                            <canvas id="face-canvas" style="display:none;"></canvas>
                            <div id="scan-overlay" style="position:absolute; inset:0; pointer-events:none;">
                                <div style="position:absolute; top:12%; left:18%; width:64%; height:76%; border:2px dashed rgba(79, 172, 254, .85); border-radius:50%;"></div>
                                <div id="scan-line" style="position:absolute; left:20%; width:60%; height:2px; top:20%; background:rgba(79, 172, 254, .95); box-shadow:0 0 10px rgba(79, 172, 254, .95);"></div>
                            </div>
                        </div>
                        <p id="face-status" style="margin:.55rem 0 0; font-size:.82rem; color:#475569;">Starting camera...</p>
                        <button type="button" id="start-camera" style="margin-top:.7rem; border:0; border-radius:8px; background:#0f172a; color:#fff; padding:.55rem .8rem; font-weight:700; cursor:pointer;">
                            Start Camera Check
                        </button>
                        <button type="button" id="camera-retry" style="display:none; margin-top:.7rem; border:0; border-radius:8px; background:#334155; color:#fff; padding:.55rem .8rem; font-weight:700; cursor:pointer;">
                            Retry Camera
                        </button>
                    </section>
                </div>

                <div id="submit-status" style="margin-top:1rem; padding:.75rem .85rem; border-radius:10px; background:#e2e8f0; color:#334155; font-size:.86rem; font-weight:700;">
                    Waiting for automated checks...
                </div>
            </form>
        </div>
    </div>
</main>

<script>
(() => {
    const form = document.getElementById('verify-form');
    const usbEndpoint = '{{ path('admin_user_detect_usb') }}';

    const hardwareKeyInput = document.getElementById('hardware-key-input');
    const faceDataInput = document.getElementById('face-reference-data');
    const usbStatus = document.getElementById('usb-status');
    const faceStatus = document.getElementById('face-status');
    const submitStatus = document.getElementById('submit-status');
    const usbRetry = document.getElementById('usb-retry');
    const cameraRetry = document.getElementById('camera-retry');
    const startCameraBtn = document.getElementById('start-camera');
    const video = document.getElementById('face-video');
    const canvas = document.getElementById('face-canvas');
    const scanLine = document.getElementById('scan-line');

    let cameraStream = null;
    let usbReady = false;
    let faceReady = false;
    let submitted = false;
    let scanInterval = null;

    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    const stopCamera = () => {
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
        }
        if (scanInterval) {
            clearInterval(scanInterval);
            scanInterval = null;
        }
    };

    const setSubmitState = () => {
        const hasUsbData = hardwareKeyInput.value.trim().length > 0;
        const hasFaceData = faceDataInput.value.startsWith('data:image/') && faceDataInput.value.length > 120;

        if (usbReady && faceReady && hasUsbData && hasFaceData && !submitted) {
            submitted = true;
            submitStatus.style.background = '#dcfce7';
            submitStatus.style.color = '#166534';
            submitStatus.textContent = 'Both checks passed. Submitting...';
            setTimeout(() => form.submit(), 700);
            return;
        }

        if (!usbReady && !faceReady) {
            submitStatus.style.background = '#e2e8f0';
            submitStatus.style.color = '#334155';
            submitStatus.textContent = 'Waiting for automated checks...';
        } else if (usbReady) {
            submitStatus.style.background = '#e0f2fe';
            submitStatus.style.color = '#075985';
            submitStatus.textContent = 'USB verified. Waiting for face verification...';
        } else {
            submitStatus.style.background = '#e0f2fe';
            submitStatus.style.color = '#075985';
            submitStatus.textContent = 'Face verified. Waiting for USB verification...';
        }
    };

    const detectUsb = async () => {
        usbRetry.style.display = 'none';
        usbStatus.style.color = '#475569';
        usbStatus.textContent = 'Detecting USB key...';

        try {
            const response = await fetch(usbEndpoint, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const contentType = response.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                const html = await response.text();
                throw new Error(`Unexpected response (${response.status}): ${html.slice(0, 100)}`);
            }

            const data = await response.json();
            if (!response.ok || !data.success || !data.hardware_key) {
                throw new Error(data.error || `HTTP ${response.status}`);
            }

            hardwareKeyInput.value = data.hardware_key;
            usbReady = true;
            usbStatus.style.color = '#166534';
            usbStatus.textContent = 'USB detected and verified.';
            setSubmitState();
        } catch (error) {
            usbReady = false;
            hardwareKeyInput.value = '';
            usbStatus.style.color = '#991b1b';
            usbStatus.textContent = `USB check failed: ${error.message}`;
            usbRetry.style.display = 'inline-block';
            setSubmitState();
        }
    };

    const captureFrame = () => {
        const width = video.videoWidth || 640;
        const height = video.videoHeight || 480;
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0, width, height);
        return canvas.toDataURL('image/jpeg', 0.95);
    };

    const animateScan = () => {
        let progress = 20;
        scanInterval = setInterval(() => {
            progress += 4;
            if (progress > 86) progress = 20;
            scanLine.style.top = `${progress}%`;
        }, 110);
    };

    const runFaceCapture = async () => {
        startCameraBtn.disabled = true;
        startCameraBtn.style.opacity = '0.6';
        startCameraBtn.style.cursor = 'not-allowed';
        cameraRetry.style.display = 'none';
        faceStatus.style.color = '#475569';
        faceStatus.textContent = 'Starting camera...';

        try {
            stopCamera();
            cameraStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
                audio: false
            });
            video.srcObject = cameraStream;

            await new Promise((resolve) => {
                if (video.readyState >= 2) {
                    resolve();
                } else {
                    video.onloadedmetadata = () => resolve();
                }
            });

            animateScan();
            faceStatus.textContent = 'Camera active. Warming up...';
            await sleep(1400);

            let frameData = '';
            for (let i = 1; i <= 3; i++) {
                faceStatus.textContent = `Analyzing face... (${i}/3)`;
                frameData = captureFrame();
                await sleep(800);
            }

            faceDataInput.value = frameData;
            faceReady = true;
            faceStatus.style.color = '#166534';
            faceStatus.textContent = 'Face captured and verified.';
            startCameraBtn.style.display = 'none';
            stopCamera();
            setSubmitState();
        } catch (error) {
            faceReady = false;
            faceDataInput.value = '';
            faceStatus.style.color = '#991b1b';
            faceStatus.textContent = `Face check failed: ${error.message}`;
            cameraRetry.style.display = 'inline-block';
            startCameraBtn.disabled = false;
            startCameraBtn.style.opacity = '1';
            startCameraBtn.style.cursor = 'pointer';
            stopCamera();
            setSubmitState();
        }
    };

    usbRetry.addEventListener('click', detectUsb);
    cameraRetry.addEventListener('click', runFaceCapture);
    startCameraBtn.addEventListener('click', runFaceCapture);
    window.addEventListener('beforeunload', stopCamera);

    detectUsb();
    faceStatus.textContent = 'Camera is ready. Click "Start Camera Check" when you want.';
    setSubmitState();
})();
</script>
{% endblock %}
