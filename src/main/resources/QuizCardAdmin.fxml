<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.QuizCardAdminController"
      styleClass="quiz-card"
      prefWidth="320" spacing="15">

    <!-- Card Header (Purple) -->
    <HBox styleClass="card-header-purple" prefHeight="80" alignment="TOP_RIGHT">
        <padding>
            <Insets top="8" right="8"/>
        </padding>
        <StackPane fx:id="chartContainer" alignment="CENTER" prefWidth="45" prefHeight="45">
            <!-- Background circle (always visible) -->
            <javafx.scene.shape.Circle fx:id="bgCircle" radius="20" fill="white" opacity="0.3"/>
            <!-- Custom Arc Chart (on top) -->
            <Pane fx:id="chartPane" prefWidth="40" prefHeight="40" maxWidth="40" maxHeight="40" mouseTransparent="true"/>
            <!-- Donut hole -->
            <javafx.scene.shape.Circle radius="12" fill="#A36CFE" /> <!-- Match the header purple or white -->
        </StackPane>
    </HBox>

    <!-- Card Content -->
    <VBox spacing="10" style="-fx-padding: 0 20 20 20;">
        <Label fx:id="titleLabel" text="Quiz : Titre de l'exercice" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" wrapText="true"/>
        <Label fx:id="descriptionLabel" text="Petite description du quiz pour aider les étudiants..." styleClass="text-subtitle" wrapText="true"/>

        <!-- Stats -->
        <HBox spacing="10">
            <Label fx:id="passesLabel" text="0 réussis" style="-fx-background-color: #DCFCE7; -fx-text-fill: #166534; -fx-padding: 2 10; -fx-background-radius: 5; -fx-font-size: 11px;"/>
            <Label fx:id="failsLabel" text="0 échecs" style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B; -fx-padding: 2 10; -fx-background-radius: 5; -fx-font-size: 11px;"/>
        </HBox>

        <!-- Meta info -->
        <HBox spacing="20">
            <Label fx:id="timeLabel" text="10 min" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
            <Label fx:id="questionCountLabel" text="5 questions" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
        </HBox>

        <!-- Spacer -->
        <Region prefHeight="10" />

        <!-- Action Buttons -->
        <HBox spacing="8" alignment="CENTER">
            <Button text="Modifier" styleClass="button-modify" onAction="#handleEdit" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Questions" styleClass="button-questions" onAction="#handleViewQuestions" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Analyser" style="-fx-background-color: #A855F7; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" onAction="#handleAIAnalysis" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Supprimer" styleClass="button-delete" onAction="#handleDelete" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>

</VBox>
