{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block navbar %}{% endblock %}
{% block footer_wave %}{% endblock %}

{% block body %}
<main class="auth-page" style="background: var(--bg-dark); min-height: 100vh; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
    <!-- Organic Background Blobs -->
    <div style="position: absolute; top: -10%; left: -10%; width: 40%; height: 60%; background: var(--gradient-hero); border-radius: 50%; filter: blur(100px); opacity: 0.4;"></div>
    <div style="position: absolute; bottom: -10%; right: -10%; width: 30%; height: 50%; background: var(--secondary); border-radius: 50%; filter: blur(100px); opacity: 0.3;"></div>

    <!-- Back to Home Button -->
    <a href="{{ path('app_home') }}" style="position: absolute; top: 2rem; left: 2rem; z-index: 100; display: flex; align-items: center; gap: 0.5rem; color: white; text-decoration: none; font-weight: 500; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); padding: 0.75rem 1.25rem; border-radius: 100px; border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.3s;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Home
    </a>

    <div class="auth-frame" style="position: relative; z-index: 1; max-width: 1000px; width: 90%; background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(25px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 40px; overflow: hidden; display: flex; box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4);">
        <!-- Left Side: Lock Animation -->
        <div class="lock-side" style="flex: 1; padding: 4rem; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.02); border-right: 1px solid rgba(255, 255, 255, 0.05); position: relative;">
            <div class="lock-scene" style="position: relative; width: 280px; height: 320px; display: flex; flex-direction: column; align-items: center;">
                <!-- SVG Lock Assembly -->
                <svg id="lock-assembly" viewBox="0 0 200 240" style="width: 100%; height: 100%; overflow: visible;">
                    <defs>
                        <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:var(--bg-dark);stop-opacity:1" />
                            <stop offset="45%" style="stop-color:var(--primary);stop-opacity:1" />
                            <stop offset="100%" style="stop-color:var(--primary-dark);stop-opacity:1" />
                        </linearGradient>
                    </defs>

                    <!-- SHACKLE -->
                    <path class="shackle"
                      d="M130 93 V73 Q130 48 100 48 Q70 48 70 73 V118"
                      stroke="var(--primary)"
                      stroke-width="14"
                      stroke-linecap="round"
                      fill="none" />

                    <!-- BODY -->
                    <rect x="50" y="98" width="100" height="85" rx="15"
                      fill="var(--bg-dark)"
                      stroke="var(--primary)"
                      stroke-width="3" />

                    <!-- OUTER CYLINDER -->
                    <circle cx="100" cy="140" r="26"
                        fill="rgba(0,0,0,0.5)"
                        stroke="var(--primary)"
                        stroke-width="1.5" />

                    <!-- ROTATING MECHANISM -->
                    <g class="lock-mechanism">
                        <!-- PLUG -->
                        <circle cx="100" cy="140" r="22"
                                fill="var(--bg-dark)"
                                stroke="var(--primary-light)"
                                stroke-width="1.5" />

                        <!-- SLOT -->
                        <rect x="88" y="137" width="24" height="6" rx="1.5" fill="black" />

                        <!-- KEY -->
                        <g class="key-object">
                            <circle cx="-40" cy="140" r="18"
                                    stroke="white"
                                    stroke-width="8"
                                    fill="none"/>
                            <line x1="-22" y1="140" x2="65" y2="140"
                                  stroke="white"
                                  stroke-width="8"
                                  stroke-linecap="round" />
                            <line x1="38" y1="140" x2="38" y2="160"
                                  stroke="white"
                                  stroke-width="8"
                                  stroke-linecap="round" />
                            <line x1="52" y1="140" x2="52" y2="160"
                                  stroke="white"
                                  stroke-width="8"
                                  stroke-linecap="round" />
                        </g>
                    </g>
                </svg>
            </div>
            
            <div style="margin-top: 1rem; text-align: center;">
                <h2 style="color: white; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">Secure Access</h2>
                <p style="color: rgba(255, 255, 255, 0.5); font-size: 0.9rem;">Experience the precision of high-grade security.</p>
            </div>
        </div>

        <!-- Right Side: Form -->
        <div class="form-side" style="flex: 1.2; padding: 4rem;">
            <div style="text-align: center; margin-bottom: 2.5rem;">
                <h1 style="color: white; font-size: 2.25rem; font-weight: 800; margin-bottom: 0.75rem;">Login</h1>
                <p style="color: rgba(255, 255, 255, 0.6);">Welcome back! Please enter your details.</p>
            </div>

            {% if error %}
                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #ef4444; padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; text-align: center;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="auth-form" id="login-form" data-turbo="false">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                
                <div style="margin-bottom: 1.5rem;">
                    <input type="text" name="identifier" id="identifier" value="{{ last_username }}"
                           style="width: 100%; background: rgba(255, 255, 255, 0.05); border: 4px solid rgba(255, 255, 255, 0.1); border-radius: 9999px; padding: 1.25rem 2.5rem; color: white; outline: none; transition: all 0.3s; text-align: center; font-weight: 900; font-size: 1.25rem;" 
                           placeholder="Email or Username" required>
                </div>
                <div style="margin-bottom: 2rem;">
                    <input type="password" name="password" id="password" 
                           style="width: 100%; background: rgba(255, 255, 255, 0.05); border: 4px solid rgba(255, 255, 255, 0.1); border-radius: 9999px; padding: 1.25rem 2.5rem; color: white; outline: none; transition: all 0.3s; text-align: center; font-weight: 900; font-size: 1.25rem;" 
                           placeholder="ACCESS KEY" required>
                </div>

                <div style="margin-bottom: 1.5rem; display: flex; justify-content: flex-end;">
                    <a href="#" style="color: var(--primary-light); font-size: 0.8rem; text-decoration: none;">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-primary" 
                        style="width: 100%; justify-content: center; padding: 1.25rem; font-size: 1.5rem; font-weight: 900; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.1em; background: var(--gradient-organic); border: none; box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);">
                    Login
                </button>
            </form>

            <div style="text-align: center; margin-top: 1.5rem;">
                <p style="color: rgba(255, 255, 255, 0.5); font-size: 0.95rem;">New? <a href="{{ path('app_signup') }}" style="color: white; font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--primary);">Sign up here</a></p>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('login-form');
            const inputs = form.querySelectorAll('input:not([type="hidden"])');
            const key = document.querySelector('.key-object');
            const mechanism = document.querySelector('.lock-mechanism');
            const shackle = document.querySelector('.shackle');
            const scene = document.querySelector('.lock-scene');
            
            let unlocked = false;

            gsap.set(key, { x: -10 });
            gsap.set(mechanism, { rotation: 0, svgOrigin: "100 140" });
            gsap.set(shackle, { rotation: 0, y: 0, svgOrigin: "70 98" });

            const updateProgress = () => {
                if (unlocked) return;
                const chars = Array.from(inputs).reduce((s, i) => s + i.value.length, 0);
                const progress = Math.min(chars / 15, 1);

                gsap.to(key, { x: gsap.utils.interpolate(-10, 55, progress), duration: 0.3, ease: "power2.out" });
                gsap.to(mechanism, { filter: `drop-shadow(0 0 ${progress * 15}px rgba(99,102,241,${progress * 0.5}))`, duration: 0.3 });
            };

            inputs.forEach(i => i.addEventListener("input", updateProgress));

            form.addEventListener('submit', (e) => {
                const complete = Array.from(inputs).every(i => i.value.trim().length > 0);
                if (!complete || unlocked) {
                    if (!complete) {
                        e.preventDefault();
                        gsap.fromTo(".auth-form", { x: -6 }, { x: 6, duration: 0.05, repeat: 4, yoyo: true });
                    }
                    return;
                }

                unlocked = true;
                e.preventDefault();

                gsap.set(key, { svgOrigin: "100 140" });
                gsap.to(key, { x: 55, duration: 0.2, ease: "power2.out" });

                const tl = gsap.timeline();
                tl.to(mechanism, { rotation: -12, duration: 0.25, ease: "power1.out" })
                  .to(mechanism, { rotation: -72, duration: 0.45, ease: "power3.out" })
                  .to(mechanism, { rotation: -65, duration: 0.15, ease: "power2.inOut" })
                  .to(scene, { y: 10, duration: 0.1, repeat: 1, yoyo: true }, "-=0.2");

                setTimeout(() => { form.submit(); }, 1200);
            });

            {% if error %}
            // Error Animation
            const errorTl = gsap.timeline();
            errorTl.to(scene, { x: -10, duration: 0.1, repeat: 5, yoyo: true, ease: "power1.inOut" })
                   .to(".lock-assembly", { filter: "drop-shadow(0 0 20px rgba(239, 68, 68, 0.6))", duration: 0.3 }, 0)
                   .to(mechanism, { x: -2, y: 1, repeat: 10, yoyo: true, duration: 0.05 }, 0);
            {% endif %}
        });
    </script>
</main>
{% endblock %}