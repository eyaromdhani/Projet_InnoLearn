{% extends 'student/layout.html.twig' %}

{% block title %}Mon Profil de Stage — InnoLearn{% endblock %}

{% block page_stylesheets %}
<style>
    /* ===== PREMIUM COLOR PALETTE & VARIABLES ===== */
    :root {
        --primary: #4f46e5;
        --primary-dark: #1e1b4b;
        --accent: #8b5cf6;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --bg-slate: #f8fafc;
        --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        --input-focus: rgba(79, 70, 229, 0.1);
    }

    /* ===== HERO SECTION ===== */
    .profile-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #6d28d9 100%);
        padding: 5rem 2rem 5rem;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
        border-radius: 0 0 40px 40px;
    }
    .profile-hero::before {
        content: ''; position: absolute; inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%239C92AC' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .hero-content { position: relative; z-index: 1; }
    .hero-icon {
        width: 80px; height: 80px;
        background: rgba(255,255,255,0.15);
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem; color: white;
        margin: 0 auto 1.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
    }
    .profile-hero h1 { font-size: 2.75rem; font-weight: 800; margin-bottom: 1rem; letter-spacing: -1px; }
    .profile-hero p { font-size: 1.15rem; opacity: 0.9; max-width: 600px; margin: 0 auto; line-height: 1.6; }

    /* ===== LAYOUT & CONTAINERS ===== */
    .profile-wrapper {
        max-width: 1200px;
        margin: -3rem auto 5rem;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 2rem;
    }

    /* ===== CARDS ===== */
    .premium-card {
        background: white;
        border-radius: 24px;
        box-shadow: var(--card-shadow);
        border: 1px solid #f1f5f9;
        overflow: hidden;
        transition: transform 0.3s;
    }
    .card-header {
        padding: 1.75rem 2rem;
        background: #fff;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .card-title { display: flex; align-items: center; gap: 1rem; }
    .card-title i { color: var(--primary); font-size: 1.25rem; }
    .card-title h2 { font-size: 1.2rem; font-weight: 800; color: var(--primary-dark); margin: 0; }
    .card-body { padding: 2rem; }

    /* ===== FORM DESIGN ===== */
    .form-group { margin-bottom: 1.75rem; position: relative; }
    .form-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 0.6rem;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .input-wrapper { position: relative; display: flex; align-items: center; }
    .input-wrapper i {
        position: absolute;
        left: 1.25rem;
        color: #94a3b8;
        font-size: 1rem;
        transition: color 0.2s;
    }
    .premium-input {
        width: 100%;
        padding: 1.1rem 1.5rem 1.1rem 3.5rem;
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        font-size: 1rem;
        color: #1e293b;
        background: #f8fafc;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        font-family: inherit;
        line-height: 1.6;
    }
    .input-no-icon { padding-left: 1.5rem !important; }
    .premium-input:focus {
        outline: none;
        border-color: var(--primary);
        background: white;
        box-shadow: 0 0 0 4px var(--input-focus);
    }
    .premium-input:focus + i { color: var(--primary); }
    
    .form-error { color: var(--danger); font-size: 0.8rem; font-weight: 600; margin-top: 0.5rem; display: block; }

    /* ===== BUTTONS ===== */
    .btn-premium {
        padding: 1rem 2.5rem;
        border-radius: 16px;
        font-weight: 800;
        font-size: 1rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: none;
        text-decoration: none;
    }
    .btn-save {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: white;
        box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
    }
    .btn-save:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 20px 30px -10px rgba(79, 70, 229, 0.5); }

    .btn-download {
        background: white;
        color: var(--primary-dark);
        border: 2px solid #e2e8f0;
    }
    .btn-download:hover { background: #f8fafc; border-color: var(--primary); color: var(--primary); transform: translateY(-4px); }

    /* ===== RIGHT COLUMN CTA ===== */
    .cta-card {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
        color: white;
        text-align: center;
        padding: 2.5rem 2rem;
    }
    .cta-icon {
        font-size: 3rem; margin-bottom: 1.5rem;
        background: rgba(255,255,255,0.1);
        width: 80px; height: 80px;
        line-height: 80px; border-radius: 50%;
        margin: 0 auto 1.5rem;
    }

    /* ===== TIMELINE ITEMS ===== */
    .timeline-item {
        padding: 1.5rem;
        border-radius: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        margin-bottom: 1rem;
        position: relative;
        transition: all 0.3s;
    }
    .timeline-item:hover {
        background: white;
        border-color: var(--primary);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        transform: translateX(5px);
    }
    .type-badge {
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 1rem;
        display: inline-block;
    }
    .badge-formation { background: #dcfce7; color: #166534; }
    .badge-experience { background: #dbeafe; color: #1e40af; }

    .delete-btn {
        position: absolute;
        top: 1.5rem; right: 1.5rem;
        color: #cbd5e1;
        background: none; border: none;
        cursor: pointer; font-size: 1.1rem;
        transition: color 0.2s;
    }
    .delete-btn:hover { color: var(--danger); }

    /* ===== FLASH MESSAGES ===== */
    .flash-container { max-width: 1200px; margin: 1.5rem auto 0; padding: 0 1.5rem; }
    .flash-item {
        padding: 1.25rem 1.5rem;
        border-radius: 16px;
        margin-bottom: 1rem;
        display: flex; align-items: center; gap: 1rem;
        font-weight: 700;
        animation: slideIn 0.5s ease;
    }
    @keyframes slideIn { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    /* ===== DYNAMIC FORM ===== */
    #newExpBlock {
        display: none;
        animation: fadeIn 0.4s ease;
        margin-bottom: 2rem;
    }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

    /* Responsive */
    @media (max-width: 1024px) {
        .profile-wrapper { grid-template-columns: 1fr; }
        .profile-hero h1 { font-size: 2rem; }
    }
</style>
{% endblock %}

{% block student_content %}
<div class="profile-hero">
    <div class="hero-content">
        <div class="hero-icon"><i class="fas fa-user-graduate"></i></div>
        <h1>Ma Carrière InnoLearn</h1>
        <p>Centralisez vos succès académiques et professionnels pour générer un CV Premium optimisé pour le marché actuel.</p>
    </div>
</div>

<div class="flash-container">
    {% for message in app.flashes('success') %}
        <div class="flash-item" style="background: #ecfdf5; color: #064e3b; border-left: 5px solid #10b981;">
            <i class="fas fa-check-circle" style="font-size: 1.5rem; color: #10b981;"></i>
            {{ message }}
        </div>
    {% endfor %}
</div>

<div class="profile-wrapper">
    
    <!-- LEFT: FORM DATA -->
    <div class="main-column">
        <div class="premium-card">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-id-card-alt"></i>
                    <h2>Identité Professionnelle</h2>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    
                    <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 1.5rem;">
                        <div class="form-group">
                            {{ form_label(form.domaine, null, {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-wrapper">
                                {{ form_widget(form.domaine, {'attr': {'class': 'premium-input', 'placeholder': 'Ex: Intelligence Artificielle'}}) }}
                                <i class="fas fa-briefcase"></i>
                            </div>
                            {{ form_errors(form.domaine) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.niveauAcademique, null, {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-wrapper">
                                {{ form_widget(form.niveauAcademique, {'attr': {'class': 'premium-input', 'placeholder': 'Ex: Master 2'}}) }}
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            {{ form_errors(form.niveauAcademique) }}
                        </div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.competences, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            {{ form_widget(form.competences, {'attr': {'class': 'premium-input', 'rows': 3, 'placeholder': 'PHP, Symfony, Design UI (séparés par des virgules)'}}) }}
                            <i class="fas fa-star" style="top: 1.2rem;"></i>
                        </div>
                        <small style="color: #94a3b8; font-size: 0.75rem;">Listez vos compétences techniques clés.</small>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            {{ form_widget(form.description, {'attr': {'class': 'premium-input', 'rows': 3, 'placeholder': 'Un résumé accrocheur pour votre CV...'}}) }}
                            <i class="fas fa-bullseye" style="top: 1.2rem;"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.langues, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            {{ form_widget(form.langues, {'attr': {'class': 'premium-input', 'rows': 1, 'placeholder': 'Français (C2), Anglais (B2)...'}}) }}
                            <i class="fas fa-language"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.lettreMotivation, null, {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            {{ form_widget(form.lettreMotivation, {'attr': {'class': 'premium-input input-no-icon', 'rows': 6, 'placeholder': 'Rédigez ici votre message pour les recruteurs...'}}) }}
                        </div>
                    </div>

                    <div style="text-align: right; padding-top: 1rem;">
                        <button type="submit" class="btn-premium btn-save">
                            <i class="fas fa-cloud-upload-alt"></i> Mettre à jour mon profil
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- RIGHT: GENERATION & TIMELINE -->
    <div class="side-column">
        
        <!-- CV CTA -->
        <div class="premium-card cta-card">
            <div class="cta-icon"><i class="fas fa-file-pdf"></i></div>
            <h3 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 0.5rem;">Coup d'œil sur l'avenir</h3>
            <p style="opacity: 0.8; font-size: 0.9rem; margin-bottom: 2rem;">Votre CV est prêt. Téléchargez-le maintenant dans son nouveau format premium.</p>
            <a href="{{ path('app_stage_profile_cv_generate') }}" class="btn-premium" style="background: white; color: var(--primary-dark); width: 100%; justify-content: center;">
                Générer mon CV PDF 
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <!-- TIMELINE MANAGEMENT -->
        <div class="premium-card" style="margin-top: 2rem;">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-history"></i>
                    <h2>Parcours</h2>
                </div>
                <button id="toggleExpForm" style="background: var(--bg-slate); color: var(--primary); border: 1px solid #e2e8f0; width: 40px; height: 40px; border-radius: 12px; cursor: pointer;">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
            <div class="card-body">
                
                <!-- NEW ENTRY FORM -->
                <div id="newExpBlock" class="premium-card" style="background: #f8fafc; padding: 1.5rem; border: 2px dashed #cbd5e1; box-shadow: none;">
                    <h4 style="margin-bottom: 1.25rem; font-weight: 800; font-size: 0.9rem;">Ajouter au parcours</h4>
                    {{ form_start(expForm) }}
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div class="form-group">
                                {{ form_label(expForm.type, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(expForm.type, {'attr': {'class': 'premium-input input-no-icon', 'style': 'padding: 0.75rem;'}}) }}
                            </div>
                            <div class="form-group">
                                {{ form_label(expForm.annee, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(expForm.annee, {'attr': {'class': 'premium-input input-no-icon', 'style': 'padding: 0.75rem;', 'placeholder': '2023'}}) }}
                            </div>
                        </div>
                        <div class="form-group">
                            {{ form_label(expForm.etablissement, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(expForm.etablissement, {'attr': {'class': 'premium-input input-no-icon', 'style': 'padding: 0.75rem;', 'placeholder': 'Nom entité'}}) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(expForm.domaine, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(expForm.domaine, {'attr': {'class': 'premium-input input-no-icon', 'style': 'padding: 0.75rem;', 'placeholder': 'Poste / Diplôme'}}) }}
                        </div>
                        <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                            <button type="submit" class="btn-premium btn-save" style="padding: 0.75rem 1.5rem; font-size: 0.85rem;">Ajouter</button>
                            <button type="button" id="cancelExp" class="btn-premium btn-download" style="padding: 0.75rem 1.5rem; font-size: 0.85rem;">Annuler</button>
                        </div>
                    {{ form_end(expForm) }}
                </div>

                <!-- LIST -->
                {% for exp in experiences %}
                    <div class="timeline-item">
                        <span class="type-badge badge-{{ exp.type }}">
                            {{ exp.type == 'formation' ? 'Formation' : 'Expérience' }}
                        </span>
                        
                        <form action="{{ path('app_stage_profile_experience_delete', {id: exp.id}) }}" method="POST" onsubmit="return confirm('Supprimer cet élément ?');">
                            <button type="submit" class="delete-btn"><i class="fas fa-trash-alt"></i></button>
                        </form>

                        <h4 style="font-weight: 800; color: var(--primary-dark); margin: 0.5rem 0 0.25rem;">{{ exp.domaine }}</h4>
                        <div style="font-size: 0.85rem; color: #64748b; margin-bottom: 0.75rem;">
                            <i class="fas fa-building" style="margin-right: 5px;"></i> {{ exp.etablissement }} 
                            <span style="margin: 0 8px; color: #e2e8f0;">|</span>
                            <i class="far fa-calendar-alt" style="margin-right: 5px;"></i> {{ exp.annee }}
                        </div>
                        
                        {% if exp.description %}
                            <p style="font-size: 0.85rem; line-height: 1.5; color: #475569; border-top: 1px solid #f1f5f9; padding-top: 0.75rem; margin-top: 0.75rem; font-style: italic;">
                                {{ exp.description }}
                            </p>
                        {% endif %}
                    </div>
                {% else %}
                    <div style="text-align: center; padding: 3rem 1rem; color: #94a3b8;">
                        <i class="fas fa-route" style="font-size: 2.5rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                        <p style="font-size: 0.9rem;">Votre parcours est vide.<br>Commencez à ajouter vos expériences.</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- PLATFORM PROJECTS -->
        <div class="premium-card" style="margin-top: 2rem;">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-folder-open"></i>
                    <h2>Projets InnoLearn</h2>
                </div>
                <span style="background: var(--bg-slate); color: #64748b; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 800;">{{ depots|length }}</span>
            </div>
            <div class="card-body" style="padding: 1rem 1.5rem 2rem;">
                {% for depot in depots %}
                    <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid #f8fafc;">
                        <div style="width: 40px; height: 40px; background: #f1f5f9; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--primary);">
                            <i class="fas fa-code"></i>
                        </div>
                        <div>
                            <div style="font-size: 0.9rem; font-weight: 700; color: var(--primary-dark);">{{ depot.title }}</div>
                            <div style="font-size: 0.75rem; color: #94a3b8;">{{ depot.project.title }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnToggle = document.getElementById('toggleExpForm');
    const btnCancel = document.getElementById('cancelExp');
    const formBlock = document.getElementById('newExpBlock');

    if (btnToggle && formBlock) {
        btnToggle.addEventListener('click', function() {
            if (formBlock.style.display === 'none' || formBlock.style.display === '') {
                formBlock.style.display = 'block';
                formBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
                formBlock.style.display = 'none';
            }
        });
    }

    if (btnCancel && formBlock) {
        btnCancel.addEventListener('click', function() {
            formBlock.style.display = 'none';
        });
    }
});
</script>
{% endblock %}
