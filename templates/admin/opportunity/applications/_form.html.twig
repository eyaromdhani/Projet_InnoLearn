{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.validated-form');
    if (!form) return;

    const cvInput = document.getElementById('{{ form.cv.vars.id }}');
    const cvSurrogate = document.getElementById('cv-surrogate');
    const cvFilename = document.getElementById('cv-filename');

    if (cvInput) {
        cvInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const file = this.files[0];
                cvFilename.textContent = file.name;
                cvSurrogate.classList.add('has-file');
                
                // Optional validation check
                if (file.type !== 'application/pdf') {
                    alert('Seuls les fichiers PDF sont acceptés.');
                    this.value = '';
                    cvFilename.textContent = 'Choisir un fichier PDF...';
                    cvSurrogate.classList.remove('has-file');
                }
            } else {
                cvFilename.textContent = 'Choisir un fichier PDF...';
                cvSurrogate.classList.remove('has-file');
            }
        });
    }

    const inputs = form.querySelectorAll('input, textarea, select');

    const validationRules = {
        '{{ form.titre.vars.id }}': { required: true, minLength: 5, label: "Le titre" },
        '{{ form.description.vars.id }}': { required: true, minLength: 20, label: "La description" },
        '{{ form.domaine.vars.id }}': { required: true, label: "Le domaine" },
        '{{ form.competences.vars.id }}': { required: true, label: "Les compétences" },
        '{{ form.type_request.vars.id }}': { required: true, label: "Le type de requête" },
        '{{ form.cv.vars.id }}': { required: false, label: "Le CV" }, // Required false for edit, handled by server/html5 for new
        '{{ form.lettre_motivation.vars.id }}': { required: true, minLength: 50, label: "La lettre de motivation" }
    };

    function validateField(input) {
        const rules = validationRules[input.id];
        if (!rules) return true;

        const value = input.value.trim();
        const errorDiv = document.getElementById('error-' + input.id);
        let isValid = true;
        let message = "";

        if (rules.required && !value) {
            isValid = false;
            message = `${rules.label} est obligatoire.`;
        } else if (value) {
            if (rules.minLength && value.length < rules.minLength) {
                isValid = false;
                message = `${rules.label} doit faire au moins ${rules.minLength} caractères.`;
            }
        }

        if (!isValid) {
            input.classList.add('is-invalid');
            if (errorDiv) {
                errorDiv.textContent = message;
                errorDiv.style.display = 'block';
            }
        } else {
            input.classList.remove('is-invalid');
            if (errorDiv) {
                errorDiv.style.display = 'none';
            }
        }
        return isValid;
    }

    inputs.forEach(input => {
        ['input', 'blur'].forEach(evt => {
            input.addEventListener(evt, () => validateField(input));
        });
    });

    form.addEventListener('submit', function(e) {
        let isFormValid = true;
        inputs.forEach(input => {
            if (!validateField(input)) {
                isFormValid = false;
            }
        });

        if (!isFormValid) {
            e.preventDefault();
            alert('Veuillez remplir correctement tous les champs obligatoires.');
        }
    });
});
</script>
