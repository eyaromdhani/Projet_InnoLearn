<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.QuizCardStudentController"
      styleClass="quiz-card"
      prefWidth="320" spacing="15">

    <!-- Card Header (Purple) -->
    <HBox styleClass="card-header-purple" prefHeight="80" alignment="TOP_RIGHT">
        <padding>
            <Insets top="10" right="10"/>
        </padding>
        <Circle radius="15" fill="white" opacity="0.8"/>
    </HBox>

    <!-- Card Content -->
    <VBox spacing="10" style="-fx-padding: 0 20 20 20;">
        <Label fx:id="titleLabel" text="Quiz Title" style="-fx-font-size: 18px; -fx-font-weight: bold;" wrapText="true"/>
        <Label fx:id="descriptionLabel" text="Description..." styleClass="text-subtitle" wrapText="true"/>

        <HBox spacing="20">
            <Label fx:id="timeLabel" text="10 min" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
            <Label fx:id="questionCountLabel" text="0 questions" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
            <Label text="Disponible" style="-fx-text-fill: #10B981; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        </HBox>

        <Region prefHeight="10" />

        <Button text="Commencer le Quiz" styleClass="button-primary" onAction="#handleStartQuiz" maxWidth="Infinity"/>
    </VBox>

</VBox>
