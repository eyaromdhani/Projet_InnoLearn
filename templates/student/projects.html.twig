{% extends 'student/layout.html.twig' %}

{% block title %}Projets Collaboratifs - InnoLearn{% endblock %}

{% block page_stylesheets %}
<style>
/* Make header transparent on this page */
.dashboard-header {
    position: absolute;
    width: 100%;
    background: transparent !important;
    backdrop-filter: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
    z-index: 1000;
}

.dashboard-header .header-brand,
.dashboard-header .nav-item,
.dashboard-header .icon-btn,
.dashboard-header .search-bar-compact i {
    color: white !important;
}

.dashboard-header .nav-item:hover,
.dashboard-header .nav-item.active {
    color: rgba(255,255,255,0.8) !important;
}

.dashboard-header .nav-item.active::after {
    background: white !important;
    box-shadow: 0 2px 4px rgba(255, 255, 255, 0.3) !important;
}

.dashboard-header .search-bar-compact {
    background: rgba(255, 255, 255, 0.15) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
}

.dashboard-header .search-bar-compact input {
    color: white !important;
}

.dashboard-header .search-bar-compact input::placeholder {
    color: rgba(255, 255, 255, 0.7) !important;
}

.dashboard-header .icon-btn:hover {
    background: rgba(255, 255, 255, 0.1) !important;
}

.dashboard-header .user-profile-toggle:hover {
    background: rgba(255, 255, 255, 0.1) !important;
}

/* Hero Section */
.projects-hero {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    min-height: 550px;
    background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #6d28d9 100%);
    position: relative;
    display: flex;
    align-items: center;
    overflow: visible;
    padding-top: 100px;
    margin-bottom: 4rem;
}

.hero-content-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 10;
}

.hero-label {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    color: white;
    line-height: 1.1;
    margin-bottom: 1.5rem;
}

.hero-title span {
    background: linear-gradient(135deg, #ffb82b 0%, #f97316 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    display: inline-block;
}

/* Design Element - Floating Icons */
.hero-design-elements {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    max-width: 400px;
    flex-wrap: wrap;
}

.design-element {
    width: 70px;
    height: 70px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    animation: float-element 6s ease-in-out infinite;
}

.design-element:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
}

.design-element:nth-child(1) {
    animation-delay: 0s;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(99, 102, 241, 0.2) 100%);
    border: 1px solid rgba(99, 102, 241, 0.3);
}

.design-element:nth-child(2) {
    animation-delay: 1s;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(245, 158, 11, 0.2) 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.design-element:nth-child(3) {
    animation-delay: 2s;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(16, 185, 129, 0.2) 100%);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.design-element i {
    font-size: 1.8rem;
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.design-element:nth-child(1) i {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.design-element:nth-child(2) i {
    background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.design-element:nth-child(3) i {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

@keyframes float-element {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

/* Waves */
.hero-waves {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 5;
    overflow: hidden;
}

.hero-waves .wave {
    position: relative;
    display: block;
    width: 200%;
    height: 70px;
    animation: waveMove 15s cubic-bezier(.55,.5,.45,.5) infinite;
}

.hero-waves .wave-1 {
    height: 90px;
    margin-bottom: -70px;
    opacity: 0.3;
    animation-duration: 7s;
    animation-direction: reverse;
}

.hero-waves .wave-2 {
    height: 80px;
    margin-bottom: -50px;
    opacity: 0.5;
    animation-duration: 10s;
}

.hero-waves .wave-3 { 
    fill: #f8fafc; 
    height: 60px;
    animation-duration: 13s;
}

@keyframes waveMove {
    0% { transform: translate3d(-50%, 0, 0); }
    50% { transform: translate3d(-25%, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
}

/* Visual Side */
.hero-visual { position: relative; display: flex; justify-content: center; align-items: center; }
.hero-illustration-wrapper {
    width: 450px;
    height: 450px;
    background: #3b3898;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    animation: float 6s ease-in-out infinite;
}
.hero-illustration { width: 100%; height: 100%; object-fit: cover; }

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
}

.hero-frame { position: absolute; z-index: 15; opacity: 0.6; animation: float-around 20s ease-in-out infinite; }
.frame-1 { width: 180px; height: 180px; background: radial-gradient(circle, #fbbf24 0%, transparent 70%); top: -5%; left: -5%; border-radius: 50%; filter: blur(15px); }
.frame-2 { width: 70px; height: 70px; background: radial-gradient(circle, #ddd6fe 0%, transparent 75%); top: 25%; left: 30%; border-radius: 50%; opacity: 0.8; }
.frame-3 { width: 140px; height: 140px; background: radial-gradient(circle, #a855f7 0%, transparent 70%); bottom: 5%; right: 5%; border-radius: 50%; filter: blur(15px); animation-delay: -5s; }
.frame-4 { width: 120px; height: 60px; background: #06b6d4; bottom: 15%; left: 5%; border-radius: 30px; filter: blur(20px); opacity: 0.5; animation-delay: -10s; }
.frame-5 { width: 45px; height: 45px; background: #fff; bottom: 20%; left: 40%; border-radius: 50%; filter: blur(8px); opacity: 0.7; }
.frame-6 { width: 100px; height: 100px; background: radial-gradient(circle, #0ea5e9 0%, transparent 70%); top: 10%; right: -10%; border-radius: 50%; filter: blur(10px); }

@keyframes float-around {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -40px) scale(1.05); }
    66% { transform: translate(-20px, 20px) scale(0.95); }
}

/* Grid Adjustment */
.dashboard-main { padding: 0 !important; background: #f8fafc; min-height: 100vh; }
.project-grid { padding: 0 10% 5rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 2rem; }

/* Toolbar - Updated design to match hero */
.toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 2rem auto;
    padding: 1.5rem;
    background: white;
    border-radius: 24px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    align-items: center;
    max-width: 1400px;
    width: 90%;
    position: relative;
    z-index: 10;
}

.search-box {
    flex: 1;
    min-width: 250px;
    position: relative;
}

.search-box i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #6366f1;
}

.search-box input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 3rem;
    border: 2px solid #e5e7eb;
    border-radius: 14px;
    font-size: 0.95rem;
    background: #f8fafc;
    transition: all 0.3s;
}

.search-box input:focus {
    border-color: #6366f1;
    background: white;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

.sort-dropdown select {
    padding: 0.85rem 2rem 0.85rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 14px;
    background: #f8fafc;
    font-size: 0.95rem;
    min-width: 200px;
    font-weight: 600;
    color: #1e293b;
    cursor: pointer;
    transition: all 0.3s;
}

.sort-dropdown select:focus {
    border-color: #6366f1;
    background: white;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

.btn-stats, .btn-pdf {
    padding: 0.85rem 1.8rem;
    border: none;
    border-radius: 50px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 0.95rem;
    color: white;
}

.btn-stats {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.25);
}

.btn-stats:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.35);
    background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
}

.btn-pdf {
    background: linear-gradient(135deg, #a855f7 0%, #9333ea 100%);
    box-shadow: 0 4px 15px rgba(168, 85, 247, 0.25);
}

.btn-pdf:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(168, 85, 247, 0.35);
    background: linear-gradient(135deg, #9333ea 0%, #7e22ce 100%);
}

/* Statistiques Graphiques - Updated design */
.stats-graphique-container {
    margin: 2rem auto;
    padding: 2rem;
    background: white;
    border-radius: 24px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    max-width: 1400px;
    width: 90%;
    position: relative;
    z-index: 10;
}

.graphiques-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #e5e7eb;
}

.graphiques-header h2 {
    font-size: 1.75rem;
    color: #1f2937;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
}

.graphiques-header p {
    color: #6b7280;
    font-size: 1rem;
}

.graphiques-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
}

.graphique-card {
    background: #f8fafc;
    border-radius: 18px;
    padding: 1.75rem;
    border: 1px solid #e5e7eb;
    transition: all 0.3s;
}

.graphique-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.graphique-card h3 {
    font-size: 1.25rem;
    color: #374151;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
}

.graphique-wrapper {
    position: relative;
    height: 280px;
    margin-bottom: 1rem;
}

.graphique-legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.25rem;
    background: white;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: #4b5563;
}

.legend-color {
    width: 14px;
    height: 14px;
    border-radius: 50%;
}

.legend-details {
    display: flex;
    flex-direction: column;
}

.legend-count {
    font-weight: 700;
    color: #1f2937;
}

.legend-percentage {
    font-size: 0.85rem;
    color: #6b7280;
}

.graphique-info {
    display: flex;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
}

.info-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.info-label {
    font-size: 0.9rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
}

.info-value {
    font-size: 1.25rem;
    font-weight: 800;
    color: #1f2937;
}

/* Tableau récapitulatif */
.summary-table {
    margin-top: 2.5rem;
    padding: 1.75rem;
    background: #f8fafc;
    border-radius: 18px;
    border: 1px solid #e5e7eb;
}

.summary-table h3 {
    font-size: 1.25rem;
    color: #374151;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

#statusTable {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

#statusTable thead {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
}

#statusTable th {
    padding: 1.25rem;
    text-align: left;
    color: white;
    font-weight: 700;
    font-size: 0.95rem;
}

#statusTable tbody tr {
    border-bottom: 1px solid #e5e7eb;
    transition: background 0.2s;
}

#statusTable tbody tr:hover {
    background: #f3f4f6;
}

#statusTable td {
    padding: 1.25rem;
    font-size: 0.95rem;
    color: #4b5563;
}

.status-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
}

.status-recherche { background: #fce7f3; color: #be185d; }
.status-complet { background: #dcfce7; color: #166534; }
.status-encours { background: #dbeafe; color: #1d4ed8; }
.status-brouillon { background: #f3f4f6; color: #6b7280; }
.status-annule { background: #fee2e2; color: #dc2626; }

/* Premium Project Card */
.project-card {
    background: white;
    border-radius: 32px;
    padding: 2.2rem;
    border: 1px solid #f1f5f9;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    flex-direction: column;
    min-height: 440px;
}

.project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 60px rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.2);
}

.card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
}

.project-badge {
    padding: 0.5rem 1.1rem;
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge-tech { background: #f1f5f9; color: #64748b; }
.badge-status-recherche { background: #fff1f2; color: #e11d48; }
.badge-status-encours { background: #eff6ff; color: #2563eb; }
.badge-status-complet { background: #f8fafc; color: #94a3b8; }

.project-info h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 0.6rem;
    letter-spacing: -0.5px;
}

.project-description {
    font-size: 0.95rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.project-lead {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
}

.lead-avatar-wrap {
    width: 36px;
    height: 36px;
    background: #6366f1;
    color: white;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
}

.lead-avatar-wrap img { width: 100%; height: 100%; border-radius: 10px; object-fit: cover; }

.project-lead span {
    font-size: 0.9rem;
    font-weight: 600;
    color: #64748b;
}

.project-meta {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #94a3b8;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
}

.project-actions {
    display: flex;
    gap: 0.75rem;
}

.btn-card {
    padding: 0.9rem 1.25rem;
    border-radius: 15px;
    font-size: 0.9rem;
    font-weight: 700;
    transition: all 0.2s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.btn-details-light {
    flex: 1;
    background: #f8fafc;
    color: #1e293b;
}

.btn-details-light:hover { background: #f1f5f9; }

.btn-action-primary {
    flex: 1.5;
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    box-shadow: 0 8px 15px rgba(99, 102, 241, 0.2);
    border: none;
    cursor: pointer;
}

.btn-action-primary:hover:not(:disabled) {
    transform: scale(1.02);
    box-shadow: 0 12px 25px rgba(99, 102, 241, 0.3);
}

.btn-action-primary:disabled {
    background: #cbd5e1;
    box-shadow: none;
    cursor: not-allowed;
}

/* Pagination */
.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 3rem auto;
    padding: 1rem;
    max-width: 1400px;
    width: 90%;
}

.page-btn {
    width: 44px;
    height: 44px;
    border: 2px solid #e5e7eb;
    background: white;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
}

.page-btn:hover:not(:disabled) {
    background: #f3f4f6;
    border-color: #6366f1;
}

.page-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.page-numbers {
    display: flex;
    gap: 0.25rem;
}

.page-number {
    width: 44px;
    height: 44px;
    border: 2px solid #e5e7eb;
    background: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s;
}

.page-number.active {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    border-color: #6366f1;
}

.page-number:hover:not(.active) {
    background: #f3f4f6;
}

/* ===================== */
/* IMPROVED DETAILS MODAL */
/* ===================== */
.modal-overlay {
    position: fixed; 
    inset: 0; 
    background: rgba(15, 23, 42, 0.7); 
    backdrop-filter: blur(12px);
    display: flex; 
    align-items: center; 
    justify-content: center; 
    z-index: 2000;
    opacity: 0; 
    visibility: hidden; 
    transition: all 0.3s ease-out;
}

.modal-overlay.active { 
    opacity: 1; 
    visibility: visible; 
}

.modal-container {
    background: white; 
    width: 100%; 
    max-width: 700px; /* Increased width for better layout */
    border-radius: 28px;
    position: relative; 
    box-shadow: 0 32px 64px -12px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    transform: translateY(20px);
    transition: transform 0.3s ease-out;
}

.modal-overlay.active .modal-container {
    transform: translateY(0);
}

.modal-close { 
    position: absolute; 
    top: 1.5rem; 
    right: 1.5rem; 
    background: #f1f5f9; 
    border: none; 
    width: 44px; 
    height: 44px; 
    border-radius: 14px; 
    cursor: pointer; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    transition: all 0.2s; 
    z-index: 10;
    font-size: 1.2rem;
}

.modal-close:hover {
    background: #e5e7eb;
    transform: rotate(90deg);
}

/* Details Modal Content Styling */
.modal-header {
    padding: 2.5rem 2.5rem 1.5rem;
    border-bottom: 1px solid #e5e7eb;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
}

.modal-title {
    font-size: 2rem;
    font-weight: 800;
    color: #1f2937;
    margin-bottom: 1rem;
    line-height: 1.2;
}

.modal-badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
}

.modal-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge-primary { background: #eef2ff; color: #4f46e5; }
.badge-success { background: #dcfce7; color: #166534; }
.badge-warning { background: #fef3c7; color: #92400e; }
.badge-danger { background: #fee2e2; color: #dc2626; }

.modal-content {
    padding: 2rem 2.5rem;
    max-height: 70vh;
    overflow-y: auto;
}

.modal-section {
    margin-bottom: 2.5rem;
}

.modal-section:last-child {
    margin-bottom: 0;
}

.modal-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #374151;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #e5e7eb;
}

.modal-section-title i {
    color: #6366f1;
    font-size: 1.1rem;
}

.modal-description {
    color: #4b5563;
    line-height: 1.7;
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
}

/* Info Grid */
.info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
}

.info-item {
    background: #f8fafc;
    padding: 1.25rem;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    transition: all 0.3s;
}

.info-item:hover {
    background: #f1f5f9;
    transform: translateY(-2px);
}

.info-label {
    font-size: 0.9rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.info-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1f2937;
}

/* Technologies List */
.technologies-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
}

.tech-tag {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s;
}

.tech-tag:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

/* Timeline */
.timeline {
    position: relative;
    padding-left: 2rem;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e5e7eb;
}

.timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
    padding-left: 1rem;
}

.timeline-item:last-child {
    margin-bottom: 0;
}

.timeline-dot {
    position: absolute;
    left: -9px;
    top: 5px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #6366f1;
    border: 3px solid white;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.timeline-date {
    font-size: 0.9rem;
    color: #6b7280;
    margin-bottom: 0.25rem;
    font-weight: 600;
}

.timeline-text {
    font-size: 1rem;
    color: #374151;
    font-weight: 500;
}

/* Modal Footer */
.modal-footer {
    padding: 1.5rem 2.5rem 2.5rem;
    border-top: 1px solid #e5e7eb;
    display: flex;
    gap: 1rem;
}

.modal-footer .btn-details {
    flex: 1;
    padding: 1rem;
    border-radius: 14px;
    font-size: 1rem;
}

.modal-footer .btn-join {
    flex: 2;
    padding: 1rem;
    border-radius: 14px;
    font-size: 1rem;
}

/* Loading Spinner */
.loading-spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem;
}

/* No projects */
.no-projects {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem;
    color: #6b7280;
    font-size: 1.1rem;
    background: white;
    border-radius: 24px;
    border: 2px dashed #e5e7eb;
}

/* Responsive */
@media (max-width: 768px) {
    .hero-content-wrapper {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
    }
    
    .hero-title {
        font-size: 2.5rem;
    }
    
    .hero-design-elements {
        justify-content: center;
    }
    
    .hero-illustration-wrapper {
        width: 300px;
        height: 300px;
        margin: 0 auto;
    }
    
    .toolbar {
        flex-direction: column;
        align-items: stretch;
    }
    
    .search-box,
    .sort-dropdown select {
        min-width: 100%;
    }
    
    .graphiques-grid {
        grid-template-columns: 1fr;
    }
    
    .project-grid {
        grid-template-columns: 1fr;
        padding: 0 5% 3rem;
    }
    
    #statusTable {
        display: block;
        overflow-x: auto;
    }
    
    .modal-container {
        max-width: 95%;
        margin: 1rem;
        border-radius: 20px;
    }
    
    .modal-header,
    .modal-content,
    .modal-footer {
        padding: 1.5rem;
    }
    
    .modal-title {
        font-size: 1.5rem;
    }
    
    .info-grid {
        grid-template-columns: 1fr;
    }
    
    .modal-footer {
        flex-direction: column;
    }
}
</style>
{% endblock %}

