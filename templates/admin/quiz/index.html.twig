{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des Quiz{% endblock %}

{% block admin_content %}
<div class="card animate-fade-in-up">
    <div class="card-header" style="justify-content: space-between; display: flex; align-items: center;">
        <h3 class="card-title">Liste des Quiz</h3>
        <a href="{{ path('admin_quiz_new') }}" class="btn-primary" style="text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px; display: inline-block;">Ajouter un Quiz</a>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Difficulté</th>
                    <th>Durée</th>
                    <th>Créé le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for quiz in quizzes %}
                <tr>
                    <td>{{ quiz.id }}</td>
                    <td>
                        <div style="font-weight: 600;">{{ quiz.title }}</div>
                        <small style="color: #64748b;">{{ quiz.description|u.truncate(50, '...') }}</small>
                    </td>
                    <td>
                        <span class="badge {{ quiz.difficulty == 'Débutant' ? 'badge-success' : (quiz.difficulty == 'Intermédiaire' ? 'badge-warning' : 'badge-danger') }}">
                            {{ quiz.difficulty }}
                        </span>
                    </td>
                    <td>{{ quiz.duration }} min</td>
                    <td>{{ quiz.createdAt|date('Y-m-d H:i') }}</td>
                    <td>
                        <div style="display: flex; gap: 0.5rem;">
                            <a href="{{ path('admin_quiz_edit', {'id': quiz.id}) }}" style="color: #4f46e5;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                  <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                </svg>
                            </a>
                            {{ include('admin/quiz/_delete_form.html.twig') }}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align: center; padding: 2rem; color: #64748b;">
                        Aucun quiz trouvé
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
