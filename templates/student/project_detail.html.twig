        'swift': 'le langage moderne d\'Apple pour iOS et macOS',
        'kotlin': 'un langage moderne et concis pour le développement Android',
        'flutter': 'un framework cross-platform pour des apps mobiles natives',
        'react native': 'un framework pour créer des apps mobiles avec React',
        'docker': 'une plateforme de conteneurisation pour des déploiements reproductibles',
        'kubernetes': 'un orchestrateur de conteneurs pour la scalabilité',
        'mysql': 'un système de gestion de base de données relationnel populaire',
        'postgresql': 'une base de données relationnelle avancée et extensible',
        'mongodb': 'une base de données NoSQL flexible orientée documents',
        'redis': 'un stockage en mémoire ultra-rapide pour le caching',
        'tensorflow': 'une plateforme de machine learning de Google',
        'pytorch': 'un framework de deep learning flexible et intuitif',
        'django': 'un framework Python full-stack avec des fonctionnalités intégrées',
        'flask': 'un micro-framework Python léger et flexible',
        'git': 'un système de contrôle de version distribué',
        'html': 'le langage de structuration du web',
        'css': 'le langage de mise en forme et de design du web',
