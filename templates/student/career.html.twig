                           oninput="updateSliderLabels('Offre')">
                    <input type="range" id="maxDateSliderOffre" 
                           min="{{ offerDateRange.min }}" 
                           max="{{ offerDateRange.max }}" 
                           value="{{ current_filters.max_date ?: offerDateRange.max }}" 
