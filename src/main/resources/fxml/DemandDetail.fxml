<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Line?>

<ScrollPane fitToWidth="true" styleClass="main-scroll-pane" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DemandDetailController">
    <content>
        <VBox spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 30px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
            <padding>
                <Insets bottom="50.0" left="50.0" right="50.0" top="40.0" />
            </padding>
            <children>
                <!-- Close Button -->
                <HBox alignment="TOP_RIGHT">
                    <children>
                        <Button onAction="#handleBack" styleClass="btn-close-circle">
                            <graphic>
                                <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" fill="#7f8c8d" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <!-- Status & Title -->
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Circle fx:id="circleStatus" fill="#2c3e50" radius="4.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                                <Label fx:id="lblStatusTop" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="En_attente" />
                            </children>
                        </HBox>
                        <Label fx:id="lblFullTitle" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #1a1a3d;" text="Candidature : frre" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" fill="#6358ff" scaleX="0.8" scaleY="0.8" />
                                <Label fx:id="lblDomaine" style="-fx-text-fill: #95a5a6; -fx-font-size: 14px;" text="toooo" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" />
                    </padding>
                </VBox>

                <HBox spacing="40.0">
                    <children>
                        <!-- Left Column -->
                        <VBox spacing="40.0" HBox.hgrow="ALWAYS">
                            <children>
                                <!-- Presentation -->
                                <VBox spacing="15.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <SVGPath content="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" fill="#6358ff" scaleX="1.2" scaleY="1.2" />
                                                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a3d;" text="Ma Présentation" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblDescription" lineSpacing="5.0" style="-fx-text-fill: #5d6d7e; -fx-font-size: 15px;" text="Description content..." wrapText="true" />
                                    </children>
                                </VBox>

                                <!-- Skills -->
                                <VBox spacing="15.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <SVGPath content="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" fill="#6358ff" scaleX="1.1" scaleY="1.1" />
                                                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a3d;" text="Mes Compétences" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblCompetences" lineSpacing="5.0" style="-fx-text-fill: #5d6d7e; -fx-font-size: 15px;" text="Skills content..." wrapText="true" />
                                    </children>
                                </VBox>
                                
                                <!-- Experience (Optional, kept at bottom) -->
                                <VBox fx:id="experienceTimeline" spacing="0.0" />
                            </children>
                        </VBox>

                        <!-- Right Sidebar -->
                        <VBox spacing="20.0" minWidth="300.0">
                            <children>
                                <VBox spacing="20.0" style="-fx-background-color: #f8fbff; -fx-background-radius: 20px; -fx-border-color: #eef2f8; -fx-border-radius: 20px;">
                                    <padding>
                                        <Insets bottom="30.0" left="25.0" right="25.0" top="30.0" />
                                    </padding>
                                    <children>
                                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a3d;" text="Informations" />
                                        
                                        <VBox spacing="15.0">
                                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                <children>
                                                    <SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7v-5z" fill="#6358ff" scaleX="0.8" scaleY="0.8" />
                                                    <Label fx:id="lblDateSidebar" style="-fx-text-fill: #5d6d7e; -fx-font-size: 14px;" text="Envoyé le 13/04/2026" />
                                                </children>
                                            </HBox>
                                            
                                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                <children>
                                                    <SVGPath content="M19 2h-4.18C14.4.84 13.3 0 12 0s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z" fill="#6358ff" scaleX="0.8" scaleY="0.8" />
                                                    <Label fx:id="lblIdSidebar" style="-fx-text-fill: #5d6d7e; -fx-font-size: 14px;" text="ID : #26" />
                                                </children>
                                            </HBox>
                                            
                                            <HBox fx:id="btnViewCV" alignment="CENTER_LEFT" spacing="12.0" style="-fx-cursor: hand;">
                                                <children>
                                                    <SVGPath content="M3.9 12c.5-1.2 1.7-2 3.1-2h10c1.4 0 2.6.8 3.1 2H3.9zM18 14H6c-1.1 0-2 .9-2 2v3c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-3c0-1.1-.9-2-2-2z" fill="#6358ff" scaleX="0.8" scaleY="0.8" />
                                                    <Label style="-fx-text-fill: #6358ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="Voir mon CV" />
                                                </children>
                                            </HBox>
                                        </VBox>
                                        
                                        <Separator prefWidth="200.0" style="-fx-opacity: 0.5;">
                                            <VBox.margin>
                                                <Insets bottom="10.0" top="10.0" />
                                            </VBox.margin>
                                        </Separator>
                                        
                                        <HBox alignment="CENTER_RIGHT" spacing="5.0">
                                            <children>
                                                <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;" text="Statut actuel :" />
                                                <Label fx:id="lblStatusSidebar" style="-fx-text-fill: #1a1a3d; -fx-font-weight: bold; -fx-font-size: 11px;" text="En_attente" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
            <VBox.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </VBox.margin>
        </VBox>
    </content>
</ScrollPane>
