        margin: 0 auto;
    }
    
    .toolbar {
        flex-direction: column;
        align-items: stretch;
    }
    
    .search-box,
    .sort-dropdown select {
        min-width: 100%;
    }
    
    .graphiques-grid {
        grid-template-columns: 1fr;
    }
    
    .project-grid {
        grid-template-columns: 1fr;
        padding: 0 5% 3rem;
    }
    
    #statusTable {
        display: block;
        overflow-x: auto;
    }
    
    .modal-container {
        max-width: 95%;
        margin: 1rem;
        border-radius: 20px;
    }
    
    .modal-header,
    .modal-content,
    .modal-footer {
        padding: 1.5rem;
    }
    
    .modal-title {
        font-size: 1.5rem;
    }
    
    .info-grid {
        grid-template-columns: 1fr;
    }
    
    .modal-footer {
        flex-direction: column;
    }
}

