<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.image.ImageView?>

<ScrollPane fitToWidth="true" styleClass="main-scroll-pane" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.StagesController">
    <content>
        <VBox spacing="0.0" styleClass="home-container">
            <children>
                <!-- Hero Full Container -->
                <VBox styleClass="hero-full-container" style="-fx-background-radius: 0;">
                    <children>
                        <!-- Navigation Bar (Included) -->
                        <fx:include fx:id="navbar" source="Navbar.fxml" />

                        <!-- Hero Section -->
                        <HBox alignment="CENTER_LEFT" spacing="40.0" styleClass="hero-section">
                            <children>
                                <!-- Hero Text Content -->
                                <VBox alignment="CENTER_LEFT" spacing="20.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" maxWidth="-Infinity" styleClass="hero-badge">
                                            <children>
                                                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" text="OPPORTUNITÉS PROFESSIONNELLES" />
                                            </children>
                                            <padding>
                                                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                                            </padding>
                                            <style>-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 20px;</style>
                                        </HBox>
                                        
                                        <VBox spacing="0.0">
                                            <children>
                                                <Label styleClass="hero-title" text="Trouvez Votre" />
                                                <Label styleClass="hero-title" style="-fx-text-fill: #ffa500;" text="Stage de Rêve" />
                                            </children>
                                        </VBox>
                                        
                                        <Region prefHeight="40.0" />
                                        
                                        <!-- Hero Floating Tab Bar -->
                                        <HBox alignment="CENTER_LEFT" fillHeight="false" prefHeight="65.0" spacing="15.0" styleClass="hero-tabs-container">
                                            <children>
                                                <!-- Tab 1: Offers (Active) -->
                                                <HBox fx:id="tabOffres" alignment="CENTER" minHeight="45.0" minWidth="180.0" onMouseClicked="#handleShowOffres" spacing="12.0" styleClass="hero-tab-item hero-tab-item-active">
                                                    <children>
                                                        <SVGPath content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" styleClass="hero-tab-icon" />
                                                        <Label styleClass="hero-tab-label" text="Les offres" />
                                                    </children>
                                                </HBox>
                                                
                                                <!-- Tab 2: Demandes -->
                                                <HBox fx:id="tabDemandes" alignment="CENTER" minHeight="45.0" minWidth="240.0" onMouseClicked="#handleShowDemandes" spacing="12.0" styleClass="hero-tab-item">
                                                    <children>
                                                        <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" styleClass="hero-tab-icon" />
                                                        <Label styleClass="hero-tab-label" text="Les demandes publiées" />
                                                    </children>
                                                </HBox>

                                                <!-- Tab 3: Mon Profil -->
                                                <HBox fx:id="tabProfile" alignment="CENTER" minHeight="45.0" minWidth="200.0" onMouseClicked="#handleShowProfile" spacing="12.0" styleClass="hero-tab-item">
                                                    <children>
                                                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="hero-tab-icon" />
                                                        <Label styleClass="hero-tab-label" text="Mon Profil" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                
                                <!-- Hero 3D Illustration -->
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <children>
                                        <StackPane styleClass="hero-image-container">
                                            <children>
                                                <Circle fx:id="heroCircle" radius="240.0" styleClass="hero-circle-image" />
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets bottom="80.0" left="80.0" right="80.0" top="40.0" />
                            </padding>
                        </HBox>
                        
                        <!-- Wavy Bottom Divider -->
                        <!-- Wavy Bottom Divider (Stretched) -->
                        <Region styleClass="wavy-separator" VBox.vgrow="NEVER" />
                    </children>
                </VBox>
                
                <!-- Main Content Area -->
                <ScrollPane fx:id="scrollPaneContent" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="contentArea" hgap="30.0" rowValignment="TOP" styleClass="content-area" vgap="30.0">
                            <!-- Cards will be injected here -->
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </content>
</ScrollPane>
