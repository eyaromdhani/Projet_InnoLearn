{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des Quiz{% endblock %}
{% block page_title %}Gestion des Quiz{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/formulaire.css') }}">
{% endblock %}

{% block admin_content %}
<div class="card shadow-sm animate-fade-in-up">

    <!-- Header -->
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Liste des Quiz</h3>
        <a href="{{ path('app_formulaire_new') }}" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Ajouter Nouveau
        </a>
    </div>

    <!-- Search by Category -->
    <div class="p-3">
        <input type="text" id="category-search" class="form-control form-control-sm"
               placeholder="Rechercher par catégorie" value="{{ currentCategory|default('') }}">
    </div>

    <!-- Table -->
    <div class="table-responsive p-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th><a href="#" data-sort="id" class="text-white">ID</a></th>
                    <th><a href="#" data-sort="titre" class="text-white">Titre</a></th>
                    <th><a href="#" data-sort="description" class="text-white">Description</a></th>
                    <th><a href="#" data-sort="tempsLimite" class="text-white">Temps Limite</a></th>
                    <th><a href="#" data-sort="category" class="text-white">Catégorie</a></th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="quiz-table-body">
                {{ include('formulaire/_table_rows.html.twig') }}
            </tbody>
        </table>
    </div>
</div>

<!-- Statistics Section -->
<div class="card shadow-sm mt-4 animate-fade-in-up">
    <div class="card-header">
        <h3 class="card-title">Statistiques des Durées</h3>
    </div>
    <div class="card-body">
        <div id="quiz-duration-chart" style="min-height: 300px; display: flex; justify-content: center;"></div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var options = {
        series: [{{ countBelow10|default(0) }}, {{ countAbove10|default(0) }}],
        chart: {
            width: 380,
            type: 'donut',
        },
        labels: ['< 10 minutes', '>= 10 minutes'],
        colors: ['#f43f5e', '#10b981'], // Red/Pink for short, Green for long/standard
        plotOptions: {
            pie: {
                donut: {
                    labels: {
                        show: true,
                        total: {
                            show: true,
                            label: 'Total',
                            formatter: function (w) {
                                return w.globals.seriesTotals.reduce((a, b) => a + b, 0)
                            }
                        }
                    }
                }
            }
        },
        dataLabels: {
            enabled: true
        },
        responsive: [{
            breakpoint: 480,
            options: {
                chart: {
                    width: 200
                },
                legend: {
                    position: 'bottom'
                }
            }
        }]
    };

    var chart = new ApexCharts(document.querySelector("#quiz-duration-chart"), options);
    chart.render();
});
</script>

<!-- Dynamic search & sorting JS -->
<script>
const tableBody = document.getElementById('quiz-table-body');
const searchInput = document.getElementById('category-search');

let currentSort = 'id';
let currentDirection = 'asc';

// Fetch table rows dynamically
function fetchTable() {
    const category = encodeURIComponent(searchInput.value);

    fetch(`{{ path('app_formulaire_index') }}?category=${category}&sort=${currentSort}&direction=${currentDirection}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.text())
    .then(html => {
        tableBody.innerHTML = html;
    });
}

// Dynamic search as you type
searchInput.addEventListener('input', () => {
    fetchTable();
});

// Sorting on header click
document.querySelectorAll('thead th a').forEach(header => {
    header.addEventListener('click', e => {
        e.preventDefault();
        const sortField = header.dataset.sort;

        // Toggle direction if same column clicked
        if (currentSort === sortField) {
            currentDirection = currentDirection === 'asc' ? 'desc' : 'asc';
        } else {
            currentSort = sortField;
            currentDirection = 'asc';
        }

        fetchTable();
    });
});
</script>

{% endblock %}
