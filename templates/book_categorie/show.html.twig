{% extends 'base.html.twig' %}

{% block title %}BookCategorie{% endblock %}

{% block body %}
    <h1>BookCategorie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ book_categorie.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ book_categorie.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ book_categorie.description }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ book_categorie.date ? book_categorie.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ book_categorie.status }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_book_categorie_index') }}">back to list</a>

    <a href="{{ path('app_book_categorie_edit', {'id': book_categorie.id}) }}">edit</a>

    {{ include('book_categorie/_delete_form.html.twig') }}
{% endblock %}
