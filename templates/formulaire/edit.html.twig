{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier Quiz{% endblock %}
{% block page_title %}Modifier le Quiz{% endblock %}

{% block admin_content %}
<div class="card animate-fade-in-up" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header">
        <h3 class="card-title">Détails du Quiz</h3>
    </div>
    <div class="p-10">
        {{ form_start(form, {'attr': {'class': 'settings-form-vertical'}}) }}
        
        <!-- Titre -->
        <div class="form-group-spaced">
            {{ form_label(form.titre, 'Titre du Quiz', {'label_attr': {'class': 'form-label-spaced'}}) }}
            {{ form_widget(form.titre, {'attr': {'class': 'form-control-spaced'}}) }}
            <div class="text-danger small">
                {{ form_errors(form.titre) }}
            </div>
        </div>
        
        <!-- Description -->
        <div class="form-group-spaced">
            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label-spaced'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control-spaced', 'rows': 5}}) }}
            <div class="text-danger small">
                {{ form_errors(form.description) }}
            </div>
        </div>
        
        <!-- Grid for side-by-side fields -->
        <div class="grid-spaced">
            <div class="form-group-spaced">
                {{ form_label(form.tempsLimite, 'Temps Limite (minutes)', {'label_attr': {'class': 'form-label-spaced'}}) }}
                {{ form_widget(form.tempsLimite, {'attr': {'class': 'form-control-spaced'}}) }}
                <div class="text-danger small">
                    {{ form_errors(form.tempsLimite) }}
                </div>
            </div>
            
            <div class="form-group-spaced">
                {{ form_label(form.category, 'Catégorie', {'label_attr': {'class': 'form-label-spaced'}}) }}
                {{ form_widget(form.category, {'attr': {'class': 'form-control-spaced'}}) }}
                <div class="text-danger small">
                    {{ form_errors(form.category) }}
                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="form-actions-spaced">
            <button class="btn-primary-spaced">Mettre à jour</button>
            <a href="{{ path('app_formulaire_index') }}" class="btn-secondary-spaced">Annuler</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<style>
.form-group-spaced { margin-bottom: 2.5rem; }
.form-label-spaced { display: block; font-weight: 600; margin-bottom: 1rem; color: #1e293b; font-size: 1rem; }
.form-control-spaced { 
    width: 100%; 
    padding: 1rem 1.25rem; 
    border: 1px solid #e2e8f0; 
    border-radius: 12px; 
    background-color: #f8fafc;
    font-size: 1rem;
    transition: all 0.3s;
}
.form-control-spaced:focus {
    border-color: #3C50E0;
    background-color: white;
    box-shadow: 0 0 0 4px rgba(60, 80, 224, 0.05);
    outline: none;
}
.grid-spaced { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-bottom: 2rem; }
.form-actions-spaced { margin-top: 3rem; display: flex; gap: 1.5rem; }
.btn-primary-spaced {
    background: #3C50E0;
    color: white;
    padding: 1rem 2.5rem;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-primary-spaced:hover { background: #2d3bb1; transform: translateY(-2px); }
.btn-secondary-spaced {
    background: #f1f5f9;
    color: #475569;
    padding: 1rem 2.5rem;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
}
.btn-secondary-spaced:hover { background: #e2e8f0; }
.text-danger.small { margin-top: 8px; font-weight: 600; color: #ef4444; font-size: 0.875rem; }
</style>
{% endblock %}
