{% extends 'base.html.twig' %}

{% block title %}RPG Learning World | InnoLearn{% endblock %}

{% block body %}
<div id="game-ui-overlay" class="position-fixed w-100 h-100 p-4 d-flex flex-column justify-content-between" style="z-index: 100; pointer-events: none;">
    <!-- Top HUD: Progress & Stats -->
    <div class="d-flex justify-content-between align-items-start" style="pointer-events: all;">
        <div class="card bg-dark bg-opacity-75 text-white border-primary shadow-lg p-2" style="min-width: 250px;">
            <div class="d-flex align-items-center mb-2">
                <div class="rounded-circle overflow-hidden bg-white p-1 me-3" style="width: 50px; height: 50px;">
                    <img src="{{ asset('img/avatar-placeholder.png') }}" class="img-fluid" alt="Avatar">
                </div>
                <div>
                    <h5 class="mb-0">{{ app.user.username }}</h5>
                    <small class="text-info">LVL 1 Novice Learner</small>
                </div>
            </div>
            <div class="xp-bar-container bg-secondary rounded-pill mb-1" style="height: 6px; overflow: hidden;">
                <div class="xp-bar bg-info w-25 h-100"></div>
            </div>
            <small class="d-flex justify-content-between">
                <span>XP: {{ avatar.totalXp }} / 1000</span>
                <span>25%</span>
            </small>
        </div>

        <div class="game-menu-btns d-flex gap-2">
            <button class="btn btn-dark bg-opacity-75 border-secondary rounded-circle" title="Quest Log" style="width: 50px; height: 50px;">
                <i class="fas fa-scroll"></i>
            </button>
            <button class="btn btn-dark bg-opacity-75 border-secondary rounded-circle" title="Skill Tree" style="width: 50px; height: 50px;">
                <i class="fas fa-tree"></i>
            </button>
            <button class="btn btn-dark bg-opacity-75 border-secondary rounded-circle" title="Settings" style="width: 50px; height: 50px;">
                <i class="fas fa-cog"></i>
            </button>
        </div>
    </div>

    <!-- Center Narrator Box (Dynamic Story) -->
    <div id="narrator-box" class="mx-auto card bg-dark bg-opacity-75 text-white border-info shadow-lg p-4 mb-4 d-none" style="max-width: 600px; pointer-events: all;">
        <div class="d-flex">
            <div class="flex-grow-1">
                <h6 class="text-info text-uppercase small fw-bold mb-2 h6-title">The Narrator</h6>
                <p id="narrator-text" class="mb-0 lead fs-6">Loading the ancient scrolls of knowledge...</p>
            </div>
            <div class="ms-3 d-flex flex-column align-items-center justify-content-center">
                <button class="btn btn-sm btn-info rounded-circle mb-2" onclick="speakNarrator()"><i class="fas fa-volume-up"></i></button>
                <button id="narrator-next" class="btn btn-sm btn-outline-info rounded-circle"><i class="fas fa-chevron-right"></i></button>
            </div>
        </div>
    </div>

    <!-- Bottom Action Bar: Interactions & Inventory -->
    <div class="d-flex justify-content-center" style="pointer-events: all;">
        <div class="card bg-dark bg-opacity-75 border-secondary rounded-pill px-4 py-2 shadow-lg mb-4">
            <div class="d-flex gap-4 align-items-center">
                <div class="action-slot" title="Interact [E]"><i class="fas fa-hand-pointer text-white-50"></i> <small class="text-white-50 d-block mt-n1">E</small></div>
                <div class="vr bg-secondary mx-1"></div>
                <div class="action-slot" title="Inventory [I]"><i class="fas fa-briefcase text-white-50"></i> <small class="text-white-50 d-block mt-n1">I</small></div>
                <div class="vr bg-secondary mx-1"></div>
                <div class="action-slot" title="World Map [M]"><i class="fas fa-map-marked-alt text-white-50"></i> <small class="text-white-50 d-block mt-n1">M</small></div>
            </div>
        </div>
    </div>
</div>

<canvas id="game-canvas" class="position-fixed top-0 start-0 w-100 h-100" style="outline: none; background: #000;"></canvas>

<!-- 3D Engine Dependencies -->
<script src="https://cdn.babylonjs.com/babylon.js"></script>
<script src="https://cdn.babylonjs.com/loaders/babylonjs.loaders.min.js"></script>
<script src="{{ asset('js/avatar-builder.js') }}"></script>

<script>
document.addEventListener('DOMContentLoaded', async () => {
    const canvas = document.getElementById('game-canvas');
    const engine = new BABYLON.Engine(canvas, true);
    const scene = new BABYLON.Scene(engine);
    
    // Core Game Variables
    let currentAvatar = null;
    let currentEnv = null;
    
    // Atmosphere
    scene.clearColor = new BABYLON.Color4(0.01, 0.01, 0.05, 1);
    const hemiLight = new BABYLON.HemisphericLight("HemiLight", new BABYLON.Vector3(0, 1, 0), scene);
    hemiLight.intensity = 0.5;
    
    // Follow Camera
    const camera = new BABYLON.ArcRotateCamera("FollowCam", -Math.PI/2, Math.PI/2.5, 5, new BABYLON.Vector3(0, 1, 0), scene);
    camera.attachControl(canvas, true);
    camera.lowerRadiusLimit = 2;
    camera.upperRadiusLimit = 10;
    
    // Environment Loading (Dungeon/Library/Forest depending on Zone)
    async function initWorld() {
        // Load Avatar
        const avatarParams = {{ avatar.avatarParams|json_encode|raw }};
        const builder = new AvatarBuilder('game-canvas');
        builder.scene = scene; // Reuse the scene
        builder.engine = engine;
        await builder.applyParams(avatarParams);
        currentAvatar = builder;
        
        // Initial Story Load (Mock for first zone)
        loadZone(1);
    }
    
    async function loadZone(courseId) {
        showNarratorLoading(true);
        try {
            const res = await fetch(`/game/load-zone/${courseId}`);
            const data = await res.json();
            updateNarrator(data.story.story_text);
            // In a real implementation, we would load data.assets.environment.glb
        } catch (e) {
            updateNarrator("The mists of history shroud this area. I cannot see clearly... Proceed with caution.");
        } finally {
            showNarratorLoading(false);
        }
    }
    
    function updateNarrator(text) {
        const box = document.getElementById('narrator-box');
        const textEl = document.getElementById('narrator-text');
        box.classList.remove('d-none');
        textEl.textContent = '';
        
        // Typewriter effect
        let i = 0;
        const interval = setInterval(() => {
            textEl.textContent += text.charAt(i);
            i++;
            if (i >= text.length) clearInterval(interval);
        }, 30);
    }
    
    function showNarratorLoading(show) {
        const textEl = document.getElementById('narrator-text');
        if (show) textEl.textContent = 'Deciphering the scrolls...';
    }

    engine.runRenderLoop(() => {
        scene.render();
    });

    window.addEventListener("resize", () => {
        engine.resize();
    });
    
    initWorld();
});

function speakNarrator() {
    const text = document.getElementById('narrator-text').textContent;
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.rate = 0.9;
    window.speechSynthesis.speak(utterance);
}
</script>

<style>
.action-slot {
    text-align: center;
    cursor: pointer;
    transition: transform 0.2s;
}
.action-slot:hover {
    transform: scale(1.2);
    color: var(--bs-primary);
}
.xp-bar {
    transition: width 1s ease-in-out;
}
.bg-gradient-dark-transparent {
    background: linear-gradient(transparent, rgba(0,0,0,0.9));
}
#game-canvas {
    touch-action: none;
}
</style>
{% endblock %}
