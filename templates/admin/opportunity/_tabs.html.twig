<div class="tabs-container mb-4" style="border-bottom: 2px solid #f1f5f9; margin-bottom: 2.5rem; padding-top: 0.5rem;">
    <div style="display: flex; gap: 2.5rem;">
        <a href="{{ path('admin_opportunity_offres_index') }}" class="tab-link {{ current_tab == 'offres' ? 'active' : '' }}" 
           style="text-decoration: none; padding: 0.75rem 0.5rem 1.25rem; position: relative; color: {{ current_tab == 'offres' ? '#4f46e5' : '#64748b' }}; font-weight: 700; transition: all 0.3s ease; font-size: 1.1rem; border-radius: 8px 8px 0 0; {{ current_tab == 'offres' ? 'background: rgba(79, 70, 229, 0.05);' : '' }}">
            Offres de Stage
            {% if current_tab == 'offres' %}
                <div style="position: absolute; bottom: -2px; left: 0; right: 0; height: 4px; background: #4f46e5; border-radius: 4px 4px 0 0; box-shadow: 0 -2px 10px rgba(79, 70, 229, 0.2);"></div>
            {% endif %}
        </a>
        <a href="{{ path('admin_opportunity_applications_index') }}" class="tab-link {{ current_tab == 'applications' ? 'active' : '' }}" 
           style="text-decoration: none; padding: 0.75rem 0.5rem 1.25rem; position: relative; color: {{ current_tab == 'applications' ? '#4f46e5' : '#64748b' }}; font-weight: 700; transition: all 0.3s ease; font-size: 1.1rem; border-radius: 8px 8px 0 0; {{ current_tab == 'applications' ? 'background: rgba(79, 70, 229, 0.05);' : '' }}">
            Candidatures
            {% if current_tab == 'applications' %}
                <div style="position: absolute; bottom: -2px; left: 0; right: 0; height: 4px; background: #4f46e5; border-radius: 4px 4px 0 0; box-shadow: 0 -2px 10px rgba(79, 70, 229, 0.2);"></div>
            {% endif %}
        </a>
    </div>
</div>
