<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane styleClass="role-container" prefWidth="1000" prefHeight="700" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.innolearn.controller.RoleSelectionController">
    <VBox alignment="CENTER" spacing="50">
        <VBox alignment="CENTER" spacing="10">
            <Label text="Bienvenue sur InnoLearn" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: -fx-text-main;" />
            <Label text="Veuillez choisir votre portail pour continuer" style="-fx-font-size: 16px; -fx-text-fill: -fx-text-muted;" />
        </VBox>
        
        <HBox alignment="CENTER" spacing="40">
            <!-- Student Card -->
            <VBox fx:id="studentCard" styleClass="role-card" onMouseClicked="#handleStudentRole">
                <Label text="🎓" styleClass="role-icon" />
                <Label text="Étudiant" styleClass="role-title" />
                <Label text="Accédez à vos cours, projets et événements d'apprentissage." styleClass="role-description" wrapText="true" maxWidth="220" />
            </VBox>
            
            <!-- Admin Card -->
            <VBox fx:id="adminCard" styleClass="role-card" onMouseClicked="#handleAdminRole">
                <Label text="⚙️" styleClass="role-icon" />
                <Label text="Administrateur" styleClass="role-title" />
                <Label text="Gérez les projets, les utilisateurs et le catalogue de formation." styleClass="role-description" wrapText="true" maxWidth="220" />
            </VBox>
        </HBox>
        
        <Label text="InnoLearn v1.0 • 2026 Professional Edition" style="-fx-text-fill: -fx-text-muted; -fx-font-size: 12px;" />
    </VBox>
</StackPane>
