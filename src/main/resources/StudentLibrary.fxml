<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.StudentLibraryController"
      stylesheets="@modern_style.css"
      styleClass="main-bg"
      prefHeight="800.0" prefWidth="1200.0">

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" spacing="30" style="-fx-background-color: white; -fx-padding: 15 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
        <Label text="InnoLearn" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6366F1;"/>
        
        <HBox alignment="CENTER" spacing="20">
            <Hyperlink text="Dashboard" style="-fx-text-fill: #64748B; -fx-underline: false;" onAction="#handleGoBack"/>
            <Hyperlink text="Bibliothèque" style="-fx-text-fill: #6366F1; -fx-underline: true; -fx-font-weight: bold;"/>
            <Hyperlink text="Quiz" style="-fx-text-fill: #64748B; -fx-underline: false;" onAction="#handleGoToQuiz"/>
        </HBox>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <HBox alignment="CENTER" spacing="15">
            <Label text="Espace Étudiant" style="-fx-text-fill: #6366F1; -fx-font-weight: bold;"/>
            <Circle radius="15" fill="#E2E8F0"/>
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="0">
            <!-- Collections Section -->
            <VBox spacing="10" style="-fx-padding: 40 100 0 100;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📚" style="-fx-font-size: 24px;"/>
                    <Label text="Nos Collections" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="searchField" promptText="Rechercher..." styleClass="text-field-custom" prefWidth="250"/>
                </HBox>
            </VBox>

            <!-- Grid Section -->
            <VBox spacing="30" style="-fx-padding: 20 100;">
                <FlowPane fx:id="booksGrid" hgap="30" vgap="40" alignment="CENTER_LEFT">
                    <!-- Cards will be injected here -->
                </FlowPane>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
