<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>CV — {{ user.name }}</title>
    <style>
        /* CSS Reset and Base Styles for PDF */
        @page { margin: 0; }
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            color: #334155;
            background: #fff;
            margin: 0;
            padding: 0;
            line-height: 1.5;
            font-size: 10pt;
        }

        /* --- COLORS --- */
        .color-primary { color: #1e1b4b; }
        .color-accent  { color: #6366f1; }
        .bg-primary    { background-color: #1e1b4b; }
        .bg-accent     { background-color: #6366f1; }

        /* --- LAYOUT --- */
        .cv-wrapper {
            width: 100%;
            min-height: 297mm;
            display: table;
            table-layout: fixed;
            border-collapse: collapse;
        }

        /* Sidebar Column */
        .cv-sidebar {
            display: table-cell;
            width: 32%;
            background-color: #6d28d9;
            color: white;
            vertical-align: top;
            padding: 30px 20px;
        }

        /* Main Column */
        .cv-main {
            display: table-cell;
            width: 68%;
            background-color: #ffffff;
            vertical-align: top;
            padding: 40px;
        }

        /* --- SIDEBAR COMPONENTS --- */
        .profile-container {
            width: 140px;
            height: 140px;
            margin: 0 auto 30px;
            text-align: center;
        }
        .profile-image {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 4px solid rgba(255,255,255,0.3);
            object-fit: cover;
        }

        .side-section { margin-bottom: 35px; }
        .side-title {
            font-size: 11pt;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid rgba(255,255,255,0.15);
        }

        .side-info-item { margin-bottom: 12px; font-size: 9pt; }
        .side-info-label { font-weight: bold; display: block; margin-bottom: 2px; opacity: 0.8; font-size: 8pt; text-transform: uppercase; }
        .side-info-value { display: block; word-break: break-all; }

        .lang-item {
            margin-bottom: 8px;
            font-size: 9.5pt;
            padding: 4px 0;
        }
        .skill-item {
            display: inline-block;
            background: rgba(255,255,255,0.1);
            padding: 3px 10px;
            border-radius: 4px;
            margin: 0 4px 6px 0;
            font-size: 8.5pt;
        }

        /* --- MAIN COMPONENTS --- */
        .cv-header {
            margin-bottom: 40px;
            border-bottom: 3px solid #6366f1;
            padding-bottom: 20px;
        }
        .student-name {
            font-size: 32pt;
            font-weight: 800;
            margin: 0;
            color: #1e1b4b;
            text-transform: uppercase;
            line-height: 1;
        }
        .student-title {
            font-size: 16pt;
            font-weight: 500;
            color: #6366f1;
            margin-top: 5px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .summary-block {
            background: #f8fafc;
            border-left: 5px solid #6366f1;
            padding: 20px;
            margin-bottom: 40px;
            font-style: italic;
            color: #475569;
            font-size: 10.5pt;
            border-radius: 0 8px 8px 0;
        }

        .main-section { margin-bottom: 35px; }
        .section-title {
            font-size: 14pt;
            font-weight: 800;
            color: #1e1b4b;
            text-transform: uppercase;
            margin-bottom: 20px;
            padding-bottom: 5px;
            border-bottom: 1px solid #e2e8f0;
        }

        /* Timeline style without absolute overlapping dots */
        .timeline-item {
            margin-bottom: 25px;
            padding-left: 15px;
            border-left: 3px solid #6366f1;
        }
        .item-header {
            margin-bottom: 5px;
        }
        .item-title {
            font-size: 11.5pt;
            font-weight: bold;
            color: #1e293b;
        }
        .item-sub {
            font-size: 10pt;
            color: #6366f1;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .item-meta {
            font-size: 9pt;
            color: #94a3b8;
            font-weight: bold;
            float: right;
        }
        .item-desc {
            font-size: 9.5pt;
            color: #475569;
            white-space: pre-line;
            clear: both;
        }

        .project-details {
            margin: 5px 0 0 0;
            padding-left: 15px;
            font-size: 9pt;
            color: #64748b;
        }
    </style>
</head>
<body>

<div class="cv-wrapper">
    <!-- SIDEBAR COL -->
    <div class="cv-sidebar">
        <!-- Photo -->
        <div class="profile-container">
            <img class="profile-image" src="https://ui-avatars.com/api/?name={{ user.name|url_encode }}&background=fff&color=1e1b4b&size=200&bold=true" alt="Avatar">
        </div>

        <!-- Contact -->
        <div class="side-section">
            <div class="side-title">Contact</div>
            <div class="side-info-item">
                <span class="side-info-label">📞 Téléphone</span>
                <span class="side-info-value">{{ user.countryCode }}{{ user.phoneNumber|default('N/A') }}</span>
            </div>
            <div class="side-section">
                <span class="side-info-label">✉️ Email</span>
                <span class="side-info-value">{{ user.email }}</span>
            </div>
            <div class="side-section">
                <span class="side-info-label">📍 Adresse</span>
                <span class="side-info-value">Soukra, Tunis, Tunisie</span>
            </div>
        </div>

        <!-- Langues -->
        <div class="side-section">
            <div class="side-title">Langues</div>
            {% if profile.langues %}
                {% set langs = profile.langues|split(',') %}
                {% for lang in langs %}
                    {% if lang|trim %}
                        <div class="lang-item">• {{ lang|trim }}</div>
                    {% endif %}
                {% endfor %}
            {% else %}
                <div class="lang-item">• Français (Courant)</div>
                <div class="lang-item">• Anglais (B2)</div>
            {% endif %}
        </div>

        <!-- Compétences -->
        <div class="side-section">
            <div class="side-title">Compétences</div>
            {% set skills = profile.competences|split(',') %}
            {% for skill in skills %}
                {% if skill|trim %}
                    <span class="skill-item">{{ skill|trim }}</span>
                {% endif %}
            {% endfor %}
        </div>

        <!-- Intérêts -->
        <div class="side-section">
            <div class="side-title">Intérêts</div>
            <div style="font-size: 9pt; opacity: 0.9;">
                Technologies Web, IA, Lecture, Voyage.
            </div>
        </div>
    </div>

    <!-- MAIN COL -->
    <div class="cv-main">
        <!-- Name and Title -->
        <div class="cv-header">
            <h1 class="student-name">{{ user.name }}</h1>
            <div class="student-title">{{ profile.domaine }}</div>
        </div>

        <!-- Personal Summary -->
        {% if profile.description or aiIntro %}
        <div class="summary-block">
            {% if profile.description %}
                {{ profile.description|nl2br }}
            {% else %}
                {{ aiIntro }}
            {% endif %}
        </div>
        {% endif %}

        <!-- EDUCATION -->
        {% set formations = experiences|filter(e => e.type == 'formation') %}
        {% if formations|length > 0 %}
        <div class="main-section">
            <div class="section-title">Formation</div>
            {% for exp in formations %}
            <div class="timeline-item">
                <div class="item-header">
                    <span class="item-meta">{{ exp.annee }}</span>
                    <div class="item-title">{{ exp.etablissement }}</div>
                </div>
                <div class="item-sub">{{ exp.domaine }}{% if exp.niveau %} — {{ exp.niveau }}{% endif %}</div>
                {% if exp.description %}
                <div class="item-desc">{{ exp.description }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- EXPERIENCE & PROJECTS -->
        {% set pro_exps = experiences|filter(e => e.type == 'experience') %}
        {% if pro_exps|length > 0 or depots|length > 0 %}
        <div class="main-section">
            <div class="section-title">Expérience / Projets</div>
            
            {# Professional Experiences #}
            {% for exp in pro_exps %}
            <div class="timeline-item">
                <div class="item-header">
                    <span class="item-meta">{{ exp.annee }}</span>
                    <div class="item-title">{{ exp.etablissement }}</div>
                </div>
                <div class="item-sub">{{ exp.domaine }}{% if exp.duree %} — ({{ exp.duree }}){% endif %}</div>
                {% if exp.description %}
                <div class="item-desc">{{ exp.description }}</div>
                {% endif %}
            </div>
            {% endfor %}

            {# InnoLearn Projects #}
            {% for depot in depots %}
            <div class="timeline-item">
                <div class="item-header">
                    <span class="item-meta">{{ depot.uploadedAt ? depot.uploadedAt|date('M Y') : '2024' }}</span>
                    <div class="item-title">{{ depot.title }}</div>
                </div>
                <div class="item-sub">Projet Plateforme : {{ depot.project.title }}</div>
                {% if depot.description %}
                <div class="item-desc">{{ depot.description|striptags }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

    </div>
</div>

</body>
</html>
