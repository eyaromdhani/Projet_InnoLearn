{% extends 'student/layout.html.twig' %}

{% block title %}{{ formulaire.titre }} - Quiz{% endblock %}

{% block page_stylesheets %}
<style>
/* Transparent Header */
.dashboard-header {
    position: absolute;
    width: 100%;
    background: transparent !important;
    backdrop-filter: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
    z-index: 1000;
}

.dashboard-header .header-brand,
.dashboard-header .nav-item,
.dashboard-header .icon-btn,
.dashboard-header .search-bar-compact i {
    color: white !important;
}

.dashboard-header .nav-item.active::after {
    background: white !important;
}

.dashboard-header .search-bar-compact {
    background: rgba(255, 255, 255, 0.15) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
}

/* Quiz Header */
.quiz-hero {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    min-height: 400px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    position: relative;
    display: flex;
    align-items: center;
    padding-top: 100px;
    padding-bottom: 3rem;
    margin-bottom: 3rem;
}

.quiz-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
}

.quiz-info {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 10;
    color: white;
}

.quiz-title {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 1rem;
}

.quiz-description {
    font-size: 1.2rem;
    opacity: 0.9;
    margin-bottom: 2rem;
}

.quiz-meta {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
}

.meta-badge {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
}

.meta-badge i {
    font-size: 1.2rem;
}

/* Quiz Container */
.dashboard-main {
    padding: 0 !important;
    background: #f8fafc;
    min-height: 100vh;
}

.quiz-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
}

.question-card {
    background: white;
    border-radius: 20px;
    padding: 2.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    border: 2px solid #e5e7eb;
    transition: all 0.3s;
}

.question-card:hover {
    border-color: #667eea;
    box-shadow: 0 10px 25px -5px rgba(102, 126, 234, 0.15);
}

.question-header {
    display: flex;
    align-items: start;
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.question-number {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    min-width: 45px;
    height: 45px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
}

.question-content {
    flex: 1;
}

.question-text {
    font-size: 1.3rem;
    font-weight: 600;
    color: #1f2937;
    line-height: 1.6;
    margin-bottom: 0.75rem;
}

.question-info {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.info-badge {
    padding: 0.4rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
}

.type-badge {
    background: #e0e7ff;
    color: #4338ca;
}

.points-badge {
    background: #fef3c7;
    color: #92400e;
}

.answer-input {
    margin-top: 1.5rem;
}

.answer-input label {
    display: block;
    font-weight: 600;
    color: #374151;
    margin-bottom: 0.75rem;
    font-size: 1rem;
}

.answer-input input,
.answer-input select,
.answer-input textarea {
    width: 100%;
    padding: 0.875rem 1.25rem;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    font-size: 1rem;
    transition: all 0.3s;
}

.answer-input input:focus,
.answer-input select:focus,
.answer-input textarea:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.submit-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.btn-submit {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    padding: 1rem 3rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(102, 126, 234, 0.4);
}

.btn-back {
    background: white;
    color: #6b7280;
    border: 2px solid #e5e7eb;
    padding: 0.875rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
}

.btn-back:hover {
    border-color: #9ca3af;
    color: #374151;
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 20px;
}

.empty-state i {
    font-size: 4rem;
    color: #e5e7eb;
    margin-bottom: 1rem;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.question-card {
    animation: slideIn 0.4s ease-out;
    animation-fill-mode: both;
}

{% for i in 1..20 %}
.question-card:nth-child({{ i }}) {
    animation-delay: {{ i * 0.1 }}s;
}
{% endfor %}

/* Timer Styling */
.timer-sticky {
    position: fixed;
    top: 80px;
    right: 2rem;
    z-index: 1001;
    background: white;
    padding: 1rem 1.5rem;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    border: 2px solid #667eea;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 150px;
    animation: fadeInRight 0.5s ease-out;
}

@keyframes fadeInRight {
    from { opacity: 0; transform: translateX(50px); }
    to { opacity: 1; transform: translateX(0); }
}

.timer-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.25rem;
}

.timer-display {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1e293b;
    font-variant-numeric: tabular-nums;
}

.timer-warning {
    border-color: #ef4444;
    animation: pulse 1s infinite;
}

.timer-warning .timer-display {
    color: #ef4444;
}

@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}

@media (max-width: 1200px) {
    .timer-sticky {
        position: sticky;
        top: 100px;
        right: auto;
        margin-bottom: 2rem;
        width: 100%;
        flex-direction: row;
        justify-content: center;
        gap: 1rem;
    }
}
</style>
{% endblock %}

{% block student_content %}
<div class="dashboard-main">
    <!-- Quiz Hero -->
    <section class="quiz-hero">
        <div class="quiz-info">
            <h1 class="quiz-title">{{ formulaire.titre }}</h1>
            <p class="quiz-description">{{ formulaire.description }}</p>
            <div class="quiz-meta">
                <div class="meta-badge">
                    <i class="bi bi-list-check"></i>
                    <span>{{ questions|length }} Questions</span>
                </div>
                {% if formulaire.tempsLimite %}
                <div class="meta-badge">
                    <i class="bi bi-clock"></i>
                    <span>{{ formulaire.tempsLimite }} minutes</span>
                </div>
                {% endif %}
                <div class="meta-badge">
                    <i class="bi bi-folder"></i>
                    <span>{{ formulaire.category }}</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Quiz Questions -->
    <div class="quiz-container">
        {% if questions|length > 0 %}
            {% if formulaire.tempsLimite %}
            <!-- Sticky Timer -->
            <div class="timer-sticky" id="quizTimer">
                <span class="timer-label">Temps Restant</span>
                <span class="timer-display" id="timeDisplay">{{ '%02d'|format(formulaire.tempsLimite) }}:00</span>
            </div>
            {% endif %}

        <form method="post" id="quizForm" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('quiz_submission') }}">
            <input type="hidden" name="suspicious_data" id="suspiciousData">
            {% for question in questions %}
            <div class="question-card">
                <div class="question-header">
                    <div class="question-number">{{ loop.index }}</div>
                    <div class="question-content">
                        <div class="question-text">
                            {{ question.questionText }}
                            <small class="text-muted d-block" style="font-size: 0.7rem; opacity: 0.7;">(Question ID: #{{ question.id }})</small>
                        </div>
                        <div class="question-info">
                            <span class="info-badge type-badge">
                                {% if question.type == 'multiple_choice' %}
                                    📝 Choix Multiple
                                {% elseif question.type == 'true_false' %}
                                    ✅ Vrai/Faux
                                {% elseif question.type == 'number' %}
                                    🔢 Nombre
                                {% else %}
                                    {{ question.type }}
                                {% endif %}
                            </span>
                            <span class="info-badge points-badge">
                                🏆 {{ question.points }} points
                            </span>
                        </div>
                    </div>
                </div>
                
                <div class="answer-input">
                    <label for="answer_{{ question.id }}">Votre réponse:</label>
                    
                    {% if question.type == 'true_false' %}
                        <select name="answers[{{ question.id }}]" id="answer_{{ question.id }}" autocomplete="off">
                            <option value="">Choisir...</option>
                            <option value="true">Vrai</option>
                            <option value="false">Faux</option>
                        </select>
                    {% elseif question.type == 'number' %}
                        <input type="text" name="answers[{{ question.id }}]" id="answer_{{ question.id }}" 
                               inputmode="numeric" pattern="[0-9]*" autocomplete="off"
                               placeholder="Entrez un nombre...">
                    {% else %}
                        <input type="text" name="answers[{{ question.id }}]" id="answer_{{ question.id }}" 
                               placeholder="Entrez votre réponse..." autocomplete="off">
                    {% endif %}
                </div>
            </div>
            {% endfor %}
            
            <div class="submit-section">
                <a href="{{ path('app_student_quizzes') }}" class="btn-back">
                    <i class="bi bi-arrow-left me-1"></i>Retour aux Quiz
                </a>
                <button type="submit" class="btn-submit" id="submitQuizBtn">
                    <i class="bi bi-check-circle me-2"></i>Soumettre le Quiz
                </button>
            </div>
        </form>
        {% else %}
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h3>Aucune question disponible</h3>
            <p>Ce formulaire ne contient pas encore de questions.</p>
            <a href="{{ path('app_student_quizzes') }}" class="btn-back mt-3 d-inline-block">
                Retour aux Quiz
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block page_javascripts %}
<script>
console.log("Student quiz JS loading...");

function initQuiz() {
    console.log("Student quiz DOM ready - ensuring form connectivity");
    const quizForm = document.getElementById('quizForm');
    
    if (quizForm) {
        console.log("Form connected successfully");
    } else {
        console.error("CRITICAL: Quiz form #quizForm NOT found in DOM!");
    }

    // Logic for Timer if enabled
    {% if formulaire.tempsLimite %}
    try {
        let timeLimitMinutes = {{ formulaire.tempsLimite|default(0) }};
        let timeRemaining = timeLimitMinutes * 60;
        const timeDisplay = document.getElementById('timeDisplay');
        const timerContainer = document.getElementById('quizTimer');
        
        const updateTimer = () => {
            if (timeRemaining <= 0) {
                clearInterval(timerInterval);
                if (timeDisplay) timeDisplay.textContent = "00:00";
                autoSubmit();
                return;
            }
            const min = Math.floor(timeRemaining / 60);
            const sec = timeRemaining % 60;
            if (timeDisplay) timeDisplay.textContent = `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
            if (timeRemaining <= 30 && timerContainer) timerContainer.classList.add('timer-warning');
            timeRemaining--;
        };

        const autoSubmit = () => {
            // Only auto-submit if the quiz form is still in the current visible page
            if (!quizForm || !document.contains(quizForm)) return;
            clearInterval(timerInterval);
            alert("Le temps est écoulé ! Vos réponses vont être soumises automatiquement.");
            quizForm.querySelectorAll('input, select, textarea').forEach(i => i.removeAttribute('required'));
            quizForm.submit();
        };

        const timerInterval = setInterval(updateTimer, 1000);
        updateTimer();

        // Stop timer when navigating away (prevents bfcache timer leak)
        window.addEventListener('pagehide', () => clearInterval(timerInterval));
    } catch(e) { console.error("Timer script error:", e); }
    {% endif %}

    // --- AI Detection / Suspicious Activity Tracker ---
    const suspiciousActivity = {
        tabSwitches: 0,
        blurCount: 0,
        copyCount: 0,
        pasteCount: 0,
        contextMenuCount: 0,
        events: []
    };

    function logEvent(type, details = null) {
        const timestamp = new Date().toISOString();
        suspiciousActivity.events.push({ type, timestamp, details });
        
        if (type === 'tab_switch' || type === 'visibility_hidden') suspiciousActivity.tabSwitches++;
        if (type === 'blur') suspiciousActivity.blurCount++;
        if (type === 'copy') suspiciousActivity.copyCount++;
        if (type === 'paste') suspiciousActivity.pasteCount++;
        if (type === 'contextmenu') suspiciousActivity.contextMenuCount++;

        updateSuspiciousInput();
    }

    function updateSuspiciousInput() {
        const input = document.getElementById('suspiciousData');
        if (!input) return;
        const hasActivity = suspiciousActivity.tabSwitches > 0 ||
            suspiciousActivity.blurCount > 0 ||
            suspiciousActivity.copyCount > 0 ||
            suspiciousActivity.pasteCount > 0 ||
            suspiciousActivity.contextMenuCount > 0;
        input.value = hasActivity ? JSON.stringify(suspiciousActivity) : '';
    }

    // 1. Visibility Change (Tab Switch)
    document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
            console.warn("User switched tabs or minimized window.");
            logEvent('visibility_hidden');
            // Optional: Show warning
            // alert("Attention: Quitter la page du quiz peut être considéré comme une tentative de triche.");
        } else {
            logEvent('visibility_visible');
        }
    });

    // 2. Window Blur (Alt+Tab or clicking outside)
    window.addEventListener("blur", () => {
        console.warn("Window lost focus.");
        logEvent('blur');
    });

    // 3. Copy / Paste / Context Menu Prevention & Logging
    document.addEventListener('copy', (e) => {
        logEvent('copy');
    });

    document.addEventListener('paste', (e) => {
        logEvent('paste');
    });

    document.addEventListener('contextmenu', (e) => {
        // Optional: prevent right click
        // e.preventDefault(); 
        logEvent('contextmenu');
    });

    // Initialize the input
    updateSuspiciousInput();

} // end initQuiz

// Run immediately if DOM is ready, otherwise wait for the event
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initQuiz);
} else {
    initQuiz();
}

// Prevent mouse wheel from changing values accidentally
document.addEventListener('wheel', function(event) {
    if (document.activeElement && document.activeElement.getAttribute('inputmode') === 'numeric') {
        document.activeElement.blur();
    }
}, { passive: false });
</script>
{% endblock %}
