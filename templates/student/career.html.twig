<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    let currentTab = '{{ current_filters.tab|default("offres") }}';
    
    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const tab = btn.getAttribute('data-tab');
            currentTab = tab;
            
            tabBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            tabContents.forEach(content => {
                content.classList.remove('active');
                if (content.id === tab + '-content') {
                    content.classList.add('active');
                }
            });
            
            const url = new URL(window.location);
            url.searchParams.set('tab', tab);
            window.history.pushState({}, '', url);
        });
    });
    
    // Dropdown logic
    function setupDropdown(dropdownId, onSelect) {
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;
        
        const toggle = dropdown.querySelector('.dropdown-toggle');
        const options = dropdown.querySelectorAll('.dropdown-opt');
        const selectedSpan = toggle.querySelector('.selected-value');
        
        toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            document.querySelectorAll('.custom-dropdown').forEach(d => {
                if (d !== dropdown) d.classList.remove('active');
            });
            dropdown.classList.toggle('active');
        });
        
        options.forEach(opt => {
            opt.addEventListener('click', () => {
                const val = opt.getAttribute('data-value');
                selectedSpan.textContent = opt.textContent.trim();
                options.forEach(o => o.classList.remove('active'));
                opt.classList.add('active');
                dropdown.classList.remove('active');
                onSelect(val);
            });
        });
    }
    
    window.addEventListener('click', () => {
        document.querySelectorAll('.custom-dropdown').forEach(d => d.classList.remove('active'));
    });
    
    // Debounce function
    function debounce(func, wait) {
        let timeout;
        return function(...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(this, args), wait);
        };
    }
    
    // Format date for labels
    function formatDate(timestamp) {
        const d = new Date(timestamp * 1000);
        return d.toLocaleDateString('fr-FR');
    }

    // Apply filters for offers
    window.applyOffreFilters = function() {
        const search = document.getElementById('offreSearch').value;
        const entreprise = document.querySelector('#entrepriseDropdown .active')?.getAttribute('data-value') || 'all';
        const duree = document.querySelector('#dureeDropdown .active')?.getAttribute('data-value') || 'all';
        const sort = document.querySelector('#offreSortDropdown .active')?.getAttribute('data-value') || 'desc';
        const minDate = document.getElementById('minDateSliderOffre').value;
        const maxDate = document.getElementById('maxDateSliderOffre').value;
        
        const params = new URLSearchParams();
        params.set('tab', 'offres');
        if (search) params.set('searchbar', search);
        if (entreprise !== 'all') params.set('entreprise', entreprise);
        if (duree !== 'all') params.set('duree', duree);
        if (sort !== 'desc') params.set('sort', sort);
        params.set('min_date', minDate);
        params.set('max_date', maxDate);
        
        const url = `${window.location.pathname}?${params.toString()}`;
        window.history.pushState({}, '', url);
        
        const grid = document.getElementById('offresGrid');
        if (grid) grid.style.opacity = '0.5';
        
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(response => response.text())
            .then(html => {
                if (grid) {
                    grid.innerHTML = html;
                    grid.style.opacity = '1';
                }
            });
    }
    
    // Apply filters for candidatures
    window.applyCandidatureFilters = function() {
        const search = document.getElementById('candidatureSearch').value;
        const domaine = document.querySelector('#domaineDropdown .active')?.getAttribute('data-value') || 'all';
        const sort = document.querySelector('#candidatureSortDropdown .active')?.getAttribute('data-value') || 'desc';
        const ownership = document.querySelector('input[name="ownership"]:checked')?.value || 'all';
        const minDate = document.getElementById('minDateSliderCandidature').value;
        const maxDate = document.getElementById('maxDateSliderCandidature').value;
        
        const params = new URLSearchParams();
        params.set('tab', 'candidatures');
        if (search) params.set('searchbar', search);
        if (domaine !== 'all') params.set('domaine', domaine);
        if (sort !== 'desc') params.set('sort', sort);
        if (ownership !== 'all') params.set('ownership', ownership);
        params.set('min_date', minDate);
        params.set('max_date', maxDate);
        
        const url = `${window.location.pathname}?${params.toString()}`;
        window.history.pushState({}, '', url);
        
        const grid = document.getElementById('candidaturesGrid');
        if (grid) grid.style.opacity = '0.5';
        
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(response => response.text())
            .then(html => {
                if (grid) {
                    grid.innerHTML = html;
                    grid.style.opacity = '1';
                }
            });
    }

    const debouncedOffreFilter = debounce(applyOffreFilters, 300);
    const debouncedCandidatureFilter = debounce(applyCandidatureFilters, 300);

    // Update Slider Labels
    window.updateSliderLabels = function(type) {
        const minSlider = document.getElementById('minDateSlider' + type);
        const maxSlider = document.getElementById('maxDateSlider' + type);
        const minLabel = document.getElementById('minDateLabel' + type);
        const maxLabel = document.getElementById('maxDateLabel' + type);
        const trackFill = document.getElementById('sliderTrackFill' + type);

        if (!minSlider || !maxSlider) return;

        const valMin = parseInt(minSlider.value);
        const valMax = parseInt(maxSlider.value);
        const minLimit = parseInt(minSlider.min);
        const maxLimit = parseInt(minSlider.max);

        if (valMin > valMax) {
            minSlider.value = valMax;
        }

        // Calculate percentage for track fill
        const range = maxLimit - minLimit;
        if (trackFill) {
            if (range <= 0) {
                // If range is 0 or negative (shouldn't happen with min/max),
                // set track to a small point or full width depending on context.
                // Here, we'll make it a small point in the middle if min/max are the same.
                // Or full width if min/max are effectively the same and values are at limits.
                if (minLimit === maxLimit) { // Single day range
                    trackFill.style.left = '0%';
                    trackFill.style.width = '100%';
                } else { // Should not happen, but as a fallback
                    trackFill.style.left = '50%';
                    trackFill.style.width = '0px';
                }
            } else {
                const leftPercent = ((valMin - minLimit) / range) * 100;
                const widthPercent = ((valMax - valMin) / range) * 100;
                trackFill.style.left = leftPercent + '%';
                trackFill.style.width = widthPercent + '%';
            }
        }

        if (minLabel) minLabel.textContent = formatDate(minSlider.value);
        if (maxLabel) maxLabel.textContent = formatDate(maxSlider.value);
        
        if (type === 'Offre') {
            debouncedOffreFilter();
        } else {
            debouncedCandidatureFilter();
        }
    };

    // Slider specific constraints (overlap prevention)
    function setupSliders(type) {
        const minSlider = document.getElementById('minDateSlider' + type);
        const maxSlider = document.getElementById('maxDateSlider' + type);
        
        if (!minSlider || !maxSlider) return;

        minSlider.oninput = () => {
            if (parseInt(minSlider.value) > parseInt(maxSlider.value)) minSlider.value = maxSlider.value;
            updateSliderLabels(type);
        };

        maxSlider.oninput = () => {
            if (parseInt(maxSlider.value) < parseInt(minSlider.value)) maxSlider.value = minSlider.value;
            updateSliderLabels(type);
        };
    }

    setupSliders('Offre');
    setupSliders('Candidature');

    // Initial track fill update (using direct call to avoid initial fetch if unwanted, 
    // but here we want to sync labels and track)
    updateSliderLabels('Offre');
    updateSliderLabels('Candidature');
    
    // Setup offre filters
    const offreSearch = document.getElementById('offreSearch');
    if (offreSearch) offreSearch.addEventListener('input', debouncedOffreFilter);
    setupDropdown('entrepriseDropdown', applyOffreFilters);
    setupDropdown('dureeDropdown', applyOffreFilters);
    setupDropdown('offreSortDropdown', applyOffreFilters);
    
    // Setup candidature filters
    const candidatureSearch = document.getElementById('candidatureSearch');
    if (candidatureSearch) candidatureSearch.addEventListener('input', debouncedCandidatureFilter);
    setupDropdown('domaineDropdown', applyCandidatureFilters);
    setupDropdown('candidatureSortDropdown', applyCandidatureFilters);

    // Offer Details & Application Logic
    window.showOfferDetails = function(id) {
        const modal = document.getElementById('offerDetailsModal');
        const body = document.getElementById('offerDetailsBody');
        if (modal) modal.style.display = 'block';
        
        fetch(`/student/offer/${id}/details`)
            .then(response => response.text())
            .then(html => {
                if (body) {
                    body.innerHTML = html;
                    
                    // Add listener for CV file input in the loaded content
                    const cvInput = document.getElementById('applicationCvFile');
                    if (cvInput) {
                        cvInput.addEventListener('change', function() {
                            const file = this.files[0];
                            const box = document.getElementById('applicationCvBox');
                            const nameEl = document.getElementById('applicationCvFileName');
                            
                            if (file) {
                                if (file.type !== 'application/pdf') {
                                    alert('Veuillez sélectionner un fichier PDF.');
                                    this.value = '';
                                    return;
                                }
                                if (file.size > 5 * 1024 * 1024) {
                                    alert('Le fichier est trop volumineux. Taille max: 5 Mo.');
                                    this.value = '';
                                    return;
                                }
                                
                                if (box) {
                                    box.style.borderStyle = 'solid';
                                    box.style.borderColor = '#10b981';
                                    box.style.background = '#ecfdf5';
                                    const icon = box.querySelector('.fas.fa-file-pdf');
                                    if (icon) icon.parentNode.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
                                }
                                if (nameEl) {
                                    nameEl.textContent = file.name;
                                    nameEl.style.color = '#10b981';
                                }
                            }
                        });
                    }
                }
            })
            .catch(err => {
                if (body) body.innerHTML = '<p style="color: red; padding: 2rem; text-align: center;">Erreur lors du chargement des détails.</p>';
            });
    };

    window.closeOfferDetailsModal = function() {
        const modal = document.getElementById('offerDetailsModal');
        if (modal) modal.style.display = 'none';
    };

    window.showCandidatureDetails = function(id) {
        const modal = document.getElementById('candidatureDetailsModal');
        const body = document.getElementById('candidatureDetailsBody');
        if (modal) modal.style.display = 'block';
        
        fetch(`/student/candidature/${id}`)
            .then(response => response.text())
            .then(html => {
                if (body) body.innerHTML = html;
            })
            .catch(err => {
                if (body) body.innerHTML = '<p style="color: red; padding: 2rem; text-align: center;">Erreur lors du chargement des détails.</p>';
            });
    };

    window.closeCandidatureDetailsModal = function() {
        const modal = document.getElementById('candidatureDetailsModal');
        if (modal) modal.style.display = 'none';
    };

    window.submitApplication = function(id) {
        const titreInput = document.getElementById('applicationTitre');
        const domaineInput = document.getElementById('applicationDomaine');
        const competencesInput = document.getElementById('applicationCompetences');
        const descriptionInput = document.getElementById('applicationDescription');
        const motivationInput = document.getElementById('motivationLetter');
        const cvInput = document.getElementById('applicationCvFile');
        
        const titreError = document.getElementById('titreError');
        const domaineError = document.getElementById('domaineError');
        const competencesError = document.getElementById('competencesError');
        const descriptionError = document.getElementById('descriptionError');
        const motivationError = document.getElementById('motivationError');
        const cvError = document.getElementById('cvError');
        
        let isValid = true;
        
        // Reset errors
        [titreError, domaineError, competencesError, descriptionError, motivationError, cvError].forEach(el => {
            if (el) {
                el.style.display = 'none';
                el.textContent = '';
            }
        });
        [titreInput, domaineInput, competencesInput, descriptionInput, motivationInput].forEach(el => {
            if (el) el.style.borderColor = '#e2e8f0';
        });

        // Validation
        if (!titreInput || titreInput.value.trim().length < 5) {
            if (titreError) {
                titreError.textContent = "Le titre doit faire au moins 5 caractères.";
                titreError.style.display = 'block';
            }
            if (titreInput) titreInput.style.borderColor = '#ef4444';
            isValid = false;
        }

        if (!domaineInput || !domaineInput.value.trim()) {
            if (domaineError) {
                domaineError.textContent = "Le domaine est obligatoire.";
                domaineError.style.display = 'block';
            }
            if (domaineInput) domaineInput.style.borderColor = '#ef4444';
            isValid = false;
        }

        if (!competencesInput || !competencesInput.value.trim()) {
            if (competencesError) {
                competencesError.textContent = "Les compétences sont obligatoires.";
                competencesError.style.display = 'block';
            }
            if (competencesInput) competencesInput.style.borderColor = '#ef4444';
            isValid = false;
        }

        if (!descriptionInput || descriptionInput.value.trim().length < 20) {
            if (descriptionError) {
                descriptionError.textContent = "La description doit faire au moins 20 caractères.";
                descriptionError.style.display = 'block';
            }
            if (descriptionInput) descriptionInput.style.borderColor = '#ef4444';
            isValid = false;
        }

        const cvFile = cvInput ? cvInput.files[0] : null;
        if (!cvFile) {
            if (cvError) {
                cvError.textContent = "Le CV est obligatoire.";
                cvError.style.display = 'block';
            }
            isValid = false;
        } else if (cvFile.type !== 'application/pdf') {
            if (cvError) {
                cvError.textContent = "Le fichier doit être au format PDF.";
                cvError.style.display = 'block';
            }
            isValid = false;
        } else if (cvFile.size > 5 * 1024 * 1024) {
            if (cvError) {
                cvError.textContent = "Le fichier est trop volumineux (max 5 Mo).";
                cvError.style.display = 'block';
            }
            isValid = false;
        }
        
        const motivationValue = motivationInput ? motivationInput.value.trim() : '';
        if (motivationValue.length < 50) {
            if (motivationInput) motivationInput.style.borderColor = '#ef4444';
            if (motivationError) {
                motivationError.textContent = "Votre lettre de motivation doit faire au moins 50 caractères.";
                motivationError.style.display = 'block';
            }
            isValid = false;
        }
        
        if (!isValid) return;

        if (!confirm('Voulez-vous vraiment envoyer cette candidature ?')) return;

        // Create FormData for file upload
        const formData = new FormData();
        formData.append('titre', titreInput.value.trim());
        formData.append('domaine', domaineInput.value.trim());
        formData.append('competences', competencesInput.value.trim());
        formData.append('description', descriptionInput.value.trim());
        formData.append('cv', cvFile);
        formData.append('motivation', motivationValue);

        fetch(`/student/offer/${id}/apply`, {
            method: 'POST',
            headers: { 
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                closeOfferDetailsModal();
                if (window.applyCandidatureFilters) window.applyCandidatureFilters();
            } else {
                alert(data.message);
            }
        })
        .catch(err => {
            alert('Une erreur est survenue lors de l\'envoi de votre candidature.');
        });
    };

    window.applyToOffer = function(id) {
        // Rediriger vers les détails pour que l'étudiant puisse remplir sa lettre
        showOfferDetails(id);
    };

    // Create Candidature Modal Functions
    window.openCreateCandidatureModal = function() {
        const modal = document.getElementById('createCandidatureModal');
        if (modal) {
            modal.style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
    };

    window.closeCreateCandidatureModal = function() {
        const modal = document.getElementById('createCandidatureModal');
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = '';
            // Reset form
            const form = document.getElementById('createCandidatureForm');
            if (form) form.reset();
            // Hide all errors
            document.querySelectorAll('.form-error').forEach(el => {
                el.style.display = 'none';
                el.textContent = '';
            });
            // Reset input borders
            document.querySelectorAll('#createCandidatureForm input, #createCandidatureForm textarea').forEach(el => {
                el.style.borderColor = '#e2e8f0';
            });
        }
    };

    // Form validation helper
    function showFieldError(fieldId, message) {
        const errorEl = document.getElementById('error_' + fieldId);
        const inputEl = document.getElementById('candidature_' + fieldId);
        if (errorEl) {
            errorEl.textContent = message;
            errorEl.style.display = 'block';
        }
        if (inputEl) {
            inputEl.style.borderColor = '#ef4444';
        }
    }

    function clearFieldError(fieldId) {
        const errorEl = document.getElementById('error_' + fieldId);
        const inputEl = document.getElementById('candidature_' + fieldId);
        if (errorEl) {
            errorEl.textContent = '';
            errorEl.style.display = 'none';
        }
        if (inputEl) {
            inputEl.style.borderColor = '#e2e8f0';
        }
    }

    // File input change handler
    const cvInput = document.getElementById('candidature_cv');
    if (cvInput) {
        cvInput.addEventListener('change', function() {
            const file = this.files[0];
            const box = document.getElementById('cvUploadBox');
            const nameEl = document.getElementById('cvFileName');
            
            if (file) {
                // Validate file type
                if (file.type !== 'application/pdf') {
                    alert('Veuillez sélectionner un fichier PDF.');
                    this.value = '';
                    return;
                }
                
                // Validate file size (5MB max)
                if (file.size > 5 * 1024 * 1024) {
                    alert('Le fichier est trop volumineux. Taille max: 5 Mo.');
                    this.value = '';
                    return;
                }
                
                box.classList.add('has-file');
                nameEl.textContent = file.name;
            } else {
                box.classList.remove('has-file');
                nameEl.textContent = 'Choisir un fichier PDF';
            }
        });
    }
    
    // Remove CV file
    window.removeCvFile = function(event) {
        event.preventDefault();
        event.stopPropagation();
        const input = document.getElementById('candidature_cv');
        const box = document.getElementById('cvUploadBox');
        const nameEl = document.getElementById('cvFileName');
        
        if (input) input.value = '';
        if (box) box.classList.remove('has-file');
        if (nameEl) nameEl.textContent = 'Choisir un fichier PDF';
    };

    // Handle form submission
    const createForm = document.getElementById('createCandidatureForm');
    if (createForm) {
        createForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Clear all previous errors
            ['titre', 'domaine', 'cv', 'competences', 'description', 'lettre'].forEach(clearFieldError);
            
            // Gather form data
            const titre = document.getElementById('candidature_titre').value.trim();
            const domaine = document.getElementById('candidature_domaine').value.trim();
            const cvFile = document.getElementById('candidature_cv').files[0];
            const competences = document.getElementById('candidature_competences').value.trim();
            const description = document.getElementById('candidature_description').value.trim();
            const lettreMotivation = document.getElementById('candidature_lettre').value.trim();
            
            // Validation
            let isValid = true;
            
            if (titre.length < 5) {
                showFieldError('titre', 'Le titre doit faire au moins 5 caractères.');
                isValid = false;
            }
            
            if (!domaine) {
                showFieldError('domaine', 'Le domaine est obligatoire.');
                isValid = false;
            }
            
            if (!cvFile) {
                showFieldError('cv', 'Le CV (fichier PDF) est obligatoire.');
                isValid = false;
            } else if (cvFile.type !== 'application/pdf') {
                showFieldError('cv', 'Le fichier doit être au format PDF.');
                isValid = false;
            } else if (cvFile.size > 5 * 1024 * 1024) {
                showFieldError('cv', 'Le fichier est trop volumineux (max 5 Mo).');
                isValid = false;
            }
            
            if (!competences) {
                showFieldError('competences', 'Les compétences sont obligatoires.');
                isValid = false;
            }
            
            if (description.length < 20) {
                showFieldError('description', 'La description doit faire au moins 20 caractères.');
                isValid = false;
            }
            
            if (lettreMotivation.length < 50) {
                showFieldError('lettre', 'La lettre de motivation doit faire au moins 50 caractères.');
                isValid = false;
            }
            
            if (!isValid) return;
            
            // Disable submit button
            const submitBtn = document.getElementById('submitCandidatureBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Envoi en cours...';
            }
            
            // Create FormData for file upload
            const formData = new FormData();
            formData.append('titre', titre);
            formData.append('domaine', domaine);
            formData.append('cv', cvFile);
            formData.append('competences', competences);
            formData.append('description', description);
            formData.append('lettre_motivation', lettreMotivation);
            
            // Send request with FormData
            fetch('/student/career/create-candidature', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    closeCreateCandidatureModal();
                    alert('Votre demande a été créée avec succès !');
                    // Refresh candidatures list
                    if (window.applyCandidatureFilters) {
                        applyCandidatureFilters();
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert(data.message || 'Une erreur est survenue.');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('Une erreur est survenue lors de la création de votre demande.');
            })
            .finally(() => {
                // Re-enable submit button
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Soumettre la demande';
                }
            });
        });
    }

    // Close on click outside
    window.onclick = function(event) {
        const offerModal = document.getElementById('offerDetailsModal');
        const candModal = document.getElementById('candidatureDetailsModal');
        const createModal = document.getElementById('createCandidatureModal');
        if (event.target == offerModal) {
            closeOfferDetailsModal();
        } else if (event.target == candModal) {
            closeCandidatureDetailsModal();
        } else if (event.target == createModal) {
            closeCreateCandidatureModal();
        }
    };
});
</script>
{% endblock %}
