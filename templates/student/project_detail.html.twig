        'cloud': { label: 'Cloud Computing', icon: '☁️', skills: ['microservices', 'scalabilité', 'serverless'], goal: 'concevoir des architectures cloud évolutives' },
        'design': { label: 'Design & UX', icon: '🎨', skills: ['prototypage', 'design system', 'accessibilité'], goal: 'créer des interfaces utilisateur intuitives et esthétiques' },
        'education': { label: 'EdTech', icon: '📚', skills: ['e-learning', 'gamification', 'pédagogie numérique'], goal: 'révolutionner l\'apprentissage grâce à la technologie' }
    };

    // Technology insights
    const techInsights = {
        'php': 'un langage serveur robuste et éprouvé',
        'symfony': 'un framework PHP professionnel avec une architecture MVC solide',
        'laravel': 'un framework PHP élégant favorisant la productivité',
