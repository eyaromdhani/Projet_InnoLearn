    color: #64748b;
}

.project-meta {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #94a3b8;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
}

.project-actions {
    display: flex;
    gap: 0.75rem;
}

.btn-card {
    padding: 0.9rem 1.25rem;
    border-radius: 15px;
    font-size: 0.9rem;
    font-weight: 700;
    transition: all 0.2s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.btn-details-light {
    flex: 1;
    background: #f8fafc;
    color: #1e293b;
}

.btn-details-light:hover { background: #f1f5f9; }

.btn-action-primary {
    flex: 1.5;
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    box-shadow: 0 8px 15px rgba(99, 102, 241, 0.2);
    border: none;
    cursor: pointer;
}

.btn-action-primary:hover:not(:disabled) {
    transform: scale(1.02);
    box-shadow: 0 12px 25px rgba(99, 102, 241, 0.3);
}

.btn-action-primary:disabled {
    background: #cbd5e1;
    box-shadow: none;
    cursor: not-allowed;
}

/* Pagination */
.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 3rem auto;
    padding: 1rem;
    max-width: 1400px;
    width: 90%;
}

.page-btn {
    width: 44px;
    height: 44px;
    border: 2px solid #e5e7eb;
    background: white;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
}

.page-btn:hover:not(:disabled) {
    background: #f3f4f6;
    border-color: #6366f1;
}

.page-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.page-numbers {
    display: flex;
    gap: 0.25rem;
}

.page-number {
    width: 44px;
    height: 44px;
    border: 2px solid #e5e7eb;
    background: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s;
}

.page-number.active {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    border-color: #6366f1;
}

.page-number:hover:not(.active) {
    background: #f3f4f6;
}

/* ===================== */
/* IMPROVED DETAILS MODAL */
/* ===================== */
.modal-overlay {
    position: fixed; 
    inset: 0; 
    background: rgba(15, 23, 42, 0.7); 
    backdrop-filter: blur(12px);
    display: flex; 
    align-items: center; 
    justify-content: center; 
    z-index: 2000;
    opacity: 0; 
    visibility: hidden; 
    transition: all 0.3s ease-out;
}

.modal-overlay.active { 
    opacity: 1; 
    visibility: visible; 
}

.modal-container {
    background: white; 
    width: 100%; 
    max-width: 700px; /* Increased width for better layout */
    border-radius: 28px;
    position: relative; 
    box-shadow: 0 32px 64px -12px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    transform: translateY(20px);
    transition: transform 0.3s ease-out;
}

.modal-overlay.active .modal-container {
    transform: translateY(0);
}

.modal-close { 
    position: absolute; 
    top: 1.5rem; 
    right: 1.5rem; 
    background: #f1f5f9; 
    border: none; 
    width: 44px; 
    height: 44px; 
    border-radius: 14px; 
    cursor: pointer; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    transition: all 0.2s; 
    z-index: 10;
    font-size: 1.2rem;
}

.modal-close:hover {
    background: #e5e7eb;
    transform: rotate(90deg);
}

/* Details Modal Content Styling */
.modal-header {
    padding: 2.5rem 2.5rem 1.5rem;
    border-bottom: 1px solid #e5e7eb;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
}

.modal-title {
    font-size: 2rem;
    font-weight: 800;
    color: #1f2937;
    margin-bottom: 1rem;
    line-height: 1.2;
}

.modal-badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
}

.modal-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge-primary { background: #eef2ff; color: #4f46e5; }
.badge-success { background: #dcfce7; color: #166534; }
.badge-warning { background: #fef3c7; color: #92400e; }
.badge-danger { background: #fee2e2; color: #dc2626; }

.modal-content {
    padding: 2rem 2.5rem;
    max-height: 70vh;
    overflow-y: auto;
}

.modal-section {
    margin-bottom: 2.5rem;
}

.modal-section:last-child {
    margin-bottom: 0;
}

.modal-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #374151;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #e5e7eb;
}

.modal-section-title i {
    color: #6366f1;
    font-size: 1.1rem;
}

.modal-description {
    color: #4b5563;
    line-height: 1.7;
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
}

/* Info Grid */
.info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
}

.info-item {
    background: #f8fafc;
    padding: 1.25rem;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    transition: all 0.3s;
}

.info-item:hover {
    background: #f1f5f9;
    transform: translateY(-2px);
}

.info-label {
    font-size: 0.9rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.info-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1f2937;
}

/* Technologies List */
.technologies-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
}

.tech-tag {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s;
}

.tech-tag:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

/* Timeline */
.timeline {
    position: relative;
    padding-left: 2rem;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e5e7eb;
}

.timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
    padding-left: 1rem;
}

.timeline-item:last-child {
    margin-bottom: 0;
}

.timeline-dot {
    position: absolute;
    left: -9px;
    top: 5px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #6366f1;
    border: 3px solid white;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.timeline-date {
    font-size: 0.9rem;
    color: #6b7280;
    margin-bottom: 0.25rem;
    font-weight: 600;
}

.timeline-text {
    font-size: 1rem;
    color: #374151;
    font-weight: 500;
}

/* Modal Footer */
.modal-footer {
    padding: 1.5rem 2.5rem 2.5rem;
    border-top: 1px solid #e5e7eb;
    display: flex;
    gap: 1rem;
}

.modal-footer .btn-details {
    flex: 1;
    padding: 1rem;
    border-radius: 14px;
    font-size: 1rem;
}

.modal-footer .btn-join {
    flex: 2;
    padding: 1rem;
    border-radius: 14px;
    font-size: 1rem;
}

/* Loading Spinner */
.loading-spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem;
}

/* No projects */
.no-projects {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem;
    color: #6b7280;
    font-size: 1.1rem;
    background: white;
    border-radius: 24px;
    border: 2px dashed #e5e7eb;
}

/* Responsive */
@media (max-width: 768px) {
    .hero-content-wrapper {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
    }
    
    .hero-title {
        font-size: 2.5rem;
    }
    
    .hero-design-elements {
        justify-content: center;
    }
    
    .hero-illustration-wrapper {
        width: 300px;
