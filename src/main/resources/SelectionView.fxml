<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.SelectionController"
      alignment="CENTER"
      spacing="40"
      stylesheets="@modern_style.css"
      styleClass="main-bg"
      prefHeight="600.0" prefWidth="900.0">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <VBox alignment="CENTER" spacing="10">
        <Text text="Bienvenue sur InnoLearn" styleClass="text-title" fill="#6366F1"/>
        <Text text="Veuillez choisir votre espace pour continuer" styleClass="text-subtitle"/>
    </VBox>

    <HBox alignment="CENTER" spacing="50">
        <VBox fx:id="adminCard" alignment="CENTER" spacing="20" styleClass="selection-card" onMouseClicked="#handleAdminClick">
            <Text text="Espace Enseignant" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Text text="Gérez vos formulaires et questions" styleClass="text-subtitle"/>
            <Button text="Accéder" styleClass="button-primary" mouseTransparent="true"/>
        </VBox>

        <VBox fx:id="studentCard" alignment="CENTER" spacing="20" styleClass="selection-card" onMouseClicked="#handleStudentClick">
            <Text text="Espace Étudiant" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Text text="Consultez les quiz et apprenez" styleClass="text-subtitle"/>
            <Button text="Accéder" styleClass="button-primary" mouseTransparent="true"/>
        </VBox>
    </HBox>

</VBox>
