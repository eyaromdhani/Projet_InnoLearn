                    <div class="slider-track"></div>
                    <div class="slider-track-fill" id="sliderTrackFillOffre"></div>
                </div>
                <div class="date-labels">
                    <div class="date-label-box" id="minDateLabelOffre">{{ (current_filters.min_date ?: offerDateRange.min)|date('d/m/Y') }}</div>
                    <div class="date-label-box" id="maxDateLabelOffre">{{ (current_filters.max_date ?: offerDateRange.max)|date('d/m/Y') }}</div>
                </div>
