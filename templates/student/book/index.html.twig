{% extends 'student/layout.html.twig' %}

{% block title %}Bibliothèque InnoLearn{% endblock %}

{% block page_stylesheets %}
<style>
/* Global Header Override */
.dashboard-header {
    background: transparent !important;
    backdrop-filter: none !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    position: absolute !important;
    width: 100% !important;
    box-shadow: none !important;
    z-index: 1000 !important;
}

.dashboard-header .header-brand span,
.dashboard-header .nav-item,
.dashboard-header .icon-btn,
.dashboard-header .user-profile-toggle,
.dashboard-header #eye-nav-toggle,
.dashboard-header .toggle-arrow,
.dashboard-header .header-brand {
    color: white !important;
}

.dashboard-header .icon-btn i {
    color: white !important;
}

.dashboard-header .nav-item:hover,
.dashboard-header .nav-item.active {
    color: white !important;
}

.dashboard-header .nav-item.active::after {
    background: white !important;
    box-shadow: 0 2px 4px rgba(255, 255, 255, 0.3) !important;
}

.dashboard-header .search-bar-compact {
    background: rgba(255, 255, 255, 0.1) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
}

.dashboard-header .search-bar-compact i,
.dashboard-header .search-bar-compact input {
    color: white !important;
}

.dashboard-header .search-bar-compact input::placeholder {
    color: rgba(255, 255, 255, 0.6) !important;
}

/* Hero Section */
.books-hero {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    min-height: 550px;
    background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #6d28d9 100%);
    position: relative;
    display: flex;
    align-items: center;
    overflow: visible;
    padding-top: 100px;
    margin-bottom: 0;
}

.hero-content-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 10;
}

.hero-label {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-title {
    font-size: 4rem;
    font-weight: 900;
    color: white;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -1px;
}

.hero-title span {
    background: linear-gradient(135deg, #ffb82b 0%, #f97316 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    display: inline-block;
}

/* Waves */
.hero-waves {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 5;
    overflow: hidden;
}

.hero-waves .wave {
    position: relative;
    display: block;
    width: 200%;
    height: 70px;
    animation: waveMove 15s cubic-bezier(.55,.5,.45,.5) infinite;
}

.hero-waves .wave-1 {
    height: 90px;
    margin-bottom: -70px;
    opacity: 0.3;
    animation-duration: 7s;
    animation-direction: reverse;
}

.hero-waves .wave-2 {
    height: 80px;
    margin-bottom: -50px;
    opacity: 0.5;
    animation-duration: 10s;
}

.hero-waves .wave-3 { 
    fill: #f8fafc; 
    height: 60px;
    animation-duration: 13s;
}

@keyframes waveMove {
    0% { transform: translate3d(-50%, 0, 0); }
    50% { transform: translate3d(-25%, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
}

/* Visual Side */
.hero-visual { position: relative; display: flex; justify-content: center; align-items: center; }
.hero-illustration-wrapper {
    width: 450px;
    height: 450px;
    background: #4338ca;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    animation: float 6s ease-in-out infinite;
}

.hero-illustration-wrapper i {
    color: white;
    font-size: 8rem;
    opacity: 0.2;
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}

.hero-illustration { width: 100%; height: 100%; object-fit: cover; }
.hero-frame { position: absolute; z-index: 15; opacity: 0.6; animation: float-around 20s ease-in-out infinite; }
.frame-1 { width: 180px; height: 180px; background: radial-gradient(circle, #fbbf24 0%, transparent 70%); top: -5%; left: -5%; border-radius: 50%; filter: blur(15px); }
.frame-2 { width: 70px; height: 70px; background: radial-gradient(circle, #ddd6fe 0%, transparent 75%); top: 25%; left: 30%; border-radius: 50%; opacity: 0.8; }
.frame-3 { width: 140px; height: 140px; background: radial-gradient(circle, #a855f7 0%, transparent 70%); bottom: 5%; right: 5%; border-radius: 50%; filter: blur(15px); animation-delay: -5s; }
.frame-4 { width: 120px; height: 60px; background: #06b6d4; bottom: 15%; left: 5%; border-radius: 30px; filter: blur(20px); opacity: 0.5; animation-delay: -10s; }
.frame-5 { width: 45px; height: 45px; background: #fff; bottom: 20%; left: 40%; border-radius: 50%; filter: blur(8px); opacity: 0.7; }
.frame-6 { width: 100px; height: 100px; background: radial-gradient(circle, #0ea5e9 0%, transparent 70%); top: 10%; right: -10%; border-radius: 50%; filter: blur(10px); }

@keyframes float-around {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -40px) scale(1.05); }
    66% { transform: translate(-20px, 20px) scale(0.95); }
}

/* Fix header nav crowding */
.header-nav {
    gap: 1rem !important;
}
.nav-item {
    font-size: 0.85rem !important;
}

/* Catalog Grid */
.dashboard-main { 
    background: #f8fafc; 
    min-height: 100vh; 
    padding-bottom: 5rem;
}

.course-catalog-grid { 
    padding: 0 5%; 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); 
    gap: 2.5rem; 
    max-width: 1600px;
    margin: 0 auto;
}

/* Card Styling */
.course-card-premium {
    background: white; 
    border-radius: 20px; 
    overflow: hidden; 
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); 
    border: 1px solid #e2e8f0; 
    display: flex; 
    flex-direction: column;
    text-decoration: none !important;
    color: inherit !important;
}

.course-card-premium:hover { 
    transform: translateY(-10px); 
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1); 
    border-color: #6366f1;
}

.course-image-wrapper { 
    position: relative; 
    height: 260px; 
    overflow: hidden; 
    background: #f8fafc; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    padding: 1.5rem;
}

.course-image-wrapper img { 
    max-width: 100%; 
    max-height: 100%; 
    width: auto;
    height: auto;
    object-fit: contain; 
    transition: transform 0.6s ease; 
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    border-radius: 4px;
}

.course-card-premium:hover .course-image-wrapper img { 
    transform: scale(1.08); 
}

.course-badge { 
    position: absolute; 
    top: 1rem; 
    left: 1rem; 
    padding: 0.4rem 0.8rem; 
    background: rgba(255,255,255,0.9); 
    backdrop-filter: blur(10px); 
    border-radius: 8px; 
    font-size: 0.7rem; 
    font-weight: 800; 
    color: #4f46e5; 
    box-shadow: 0 4px 10px rgba(0,0,0,0.1); 
    z-index: 2;
}

.course-content { 
    padding: 1.5rem; 
    flex: 1; 
    display: flex; 
    flex-direction: column; 
}

.course-content h3 { 
    font-size: 1.15rem; 
    margin-bottom: 0.5rem; 
    color: #1e293b; 
    font-weight: 700; 
    line-height: 1.4;
    transition: color 0.3s;
}

.course-card-premium:hover .course-content h3 {
    color: #6366f1;
}

.course-teacher { 
    font-size: 0.85rem; 
    color: #64748b; 
    margin-bottom: 1rem; 
    display: flex; 
    align-items: center; 
    gap: 0.5rem; 
}

.course-meta { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    margin-top: auto; 
    padding-top: 1rem; 
    border-top: 1px solid #f1f5f9; 
}

.course-year { 
    font-size: 0.85rem; 
    font-weight: 600; 
    color: #94a3b8; 
}

.btn-details { 
    color: #6366f1; 
    font-weight: 700; 
    font-size: 0.85rem; 
    display: flex; 
    align-items: center; 
    gap: 0.4rem; 
}
</style>
{% endblock %}

{% block student_content %}
<div class="dashboard-main">
    <!-- Hero Section -->
    <section class="books-hero">
        <div class="hero-content-wrapper">
            <div class="hero-text-content">
                <span class="hero-label">Médiathèque</span>
                <h1 class="hero-title">
                    Bibliothèque<br>
                    <span>Numérique</span>
                </h1>
                <p class="text-white opacity-75 lead mb-4" style="font-size: 1.25rem; max-width: 500px;">Accédez à des milliers de ressources pédagogiques pour approfondir vos connaissances et booster votre apprentissage.</p>
                
                <div class="hero-actions" style="display: flex; gap: 1rem; margin-top: 2rem;">
                    <a href="#catalog" class="btn-primary-gradient" style="padding: 1rem 2rem; border-radius: 15px; text-decoration: none;">
                        <i class="fas fa-book-open"></i> Explorer le catalogue
                    </a>
                </div>
            </div>
            
            <div class="hero-visual d-none d-lg-flex">
                <div class="hero-illustration-wrapper">
                    <img src="{{ asset('images/student_hero.png') }}" class="hero-illustration" alt="Books illustration">
                </div>
                <div class="hero-frame frame-1"></div>
                <div class="hero-frame frame-2"></div>
                <div class="hero-frame frame-3"></div>
                <div class="hero-frame frame-4"></div>
                <div class="hero-frame frame-5"></div>
                <div class="hero-frame frame-6"></div>
            </div>
        </div>

        <div class="hero-waves">
            <svg class="wave wave-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
                <defs><path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" /></defs>
                <use href="#gentle-wave" x="48" y="0" fill="rgba(255,255,255,0.7" />
            </svg>
            <svg class="wave wave-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
                <use href="#gentle-wave" x="48" y="3" fill="rgba(255,255,255,0.5)" />
            </svg>
            <svg class="wave wave-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
                <use href="#gentle-wave" x="48" y="5" fill="#f8fafc" />
            </svg>
        </div>
    </section>

    <!-- Content Grid -->
    <div id="catalog" class="content-section" style="padding-top: 5rem;">
        <div class="section-header" style="max-width: 1600px; margin: 0 auto 3rem; padding: 0 5%;">
            <h2 class="section-title"><i class="fas fa-layer-group"></i> Nos Collections</h2>
        </div>
        
        <div class="course-catalog-grid">
        {% for book in books %}
            <a href="{{ path('app_book_show', {'id': book.id}) }}" class="course-card-premium">
                <div class="course-image-wrapper">
                    {% if book.coverImage %}
                        <img src="{{ asset('uploads/books/covers/' ~ book.coverImage) }}" alt="{{ book.titre }}">
                    {% else %}
                        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-light text-muted">
                            <i class="fas fa-book fa-4x mb-2 opacity-25"></i>
                            <span class="small fw-bold">No Cover</span>
                        </div>
                    {% endif %}
                    <div class="course-badge text-uppercase">{{ book.author|u.truncate(15, '...') }}</div>
                </div>
                <div class="course-content">
                    <h3>{{ book.titre }}</h3>
                    <div class="course-teacher">
                        <i class="fas fa-user-edit"></i>
                        <span>{{ book.author }}</span>
                    </div>
                    <div class="course-meta">
                        <span class="course-year">{{ book.publier ? book.publier|date('Y') : 'N/A' }}</span>
                        <div class="btn-details">
                            Détails <i class="fas fa-chevron-right small"></i>
                        </div>
                    </div>
                </div>
            </a>
        {% else %}
            <div class="col-12 text-center py-5" style="grid-column: 1/-1;">
                <div class="empty-state">
                    <i class="fas fa-books fa-4x text-muted mb-3 opacity-25"></i>
                    <h3 class="text-muted">La bibliothèque est vide</h3>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
