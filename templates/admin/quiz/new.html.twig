{% extends 'admin/layout.html.twig' %}

{% block title %}Nouveau Quiz{% endblock %}

{% block admin_content %}
<div class="card animate-fade-in-up">
    <div class="card-header">
        <h3 class="card-title">Créer un nouveau quiz</h3>
    </div>
    <div class="card-body">
        {{ include('admin/quiz/_form.html.twig', {'button_label': 'Créer'}) }}
    </div>
</div>

<a href="{{ path('admin_quiz_index') }}" class="btn-secondary" style="display: inline-block; margin-top: 1rem; text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px;">
    Retour à la liste
</a>
{% endblock %}
