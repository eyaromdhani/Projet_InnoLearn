{% extends 'student/layout.html.twig' %}

{% block title %}{{ project.title }} - Détails du Projet{% endblock %}

{% block page_stylesheets %}
<style>
/* Hero Section */
.project-detail-hero {
    background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #6d28d9 100%);
    padding: 5rem 2rem;
    color: white;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.hero-background {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(124, 58, 237, 0.4) 0%, transparent 70%);
    opacity: 0.5;
    pointer-events: none;
}

.hero-content {
    max-width: 1300px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
}

.breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    font-weight: 500;
}

.breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.breadcrumb a:hover {
    color: white;
    transform: translateX(-3px);
}

.breadcrumb span {
    color: rgba(255, 255, 255, 0.3);
}

.project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
}

.project-title-section h1 {
    font-size: 3.5rem;
    font-weight: 900;
    margin-bottom: 1.25rem;
    color: white;
    letter-spacing: -0.025em;
    line-height: 1;
}

.project-meta-badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.project-badge {
    padding: 0.6rem 1.25rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.3s;
}

.badge-category {
    background: rgba(255, 255, 255, 0.15);
    color: white;
}

.badge-status {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    border-color: rgba(52, 211, 153, 0.2);
}

.project-actions-header {
    display: flex;
    gap: 1rem;
}

.btn-back-hero {
    background: rgba(255, 255, 255, 0.05);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.85rem 1.75rem;
    border-radius: 14px;
    font-weight: 600;
    transition: all 0.3s;
    backdrop-filter: blur(10px);
}

.btn-back-hero:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: white;
}

.btn-join-hero {
    background: white;
    color: #4338ca;
    border: none;
    padding: 0.85rem 2rem;
    border-radius: 14px;
    font-weight: 800;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.btn-join-hero:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(67, 56, 202, 0.4);
}

/* Page Layout */
.project-detail-container {
    max-width: 1300px;
    margin: -3rem auto 4rem;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 2.5rem;
    position: relative;
    z-index: 20;
}

.card-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.project-info-card {
    background: white;
    border-radius: 24px;
    padding: 2.5rem;
    border: 1px solid #f1f5f9;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.04);
    transition: all 0.3s;
}

.project-info-card:hover {
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.07);
}

.section-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

.section-title i {
    width: 40px;
    height: 40px;
    background: #f1f5f9;
    color: #4338ca;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 1.1rem;
}

.project-description {
    color: #64748b;
    line-height: 1.8;
    font-size: 1.1rem;
}

/* Summary Card Special Style */
.summary-card {
    background: linear-gradient(to right, #f8fafc, #eff6ff);
    border: 1px solid #dbeafe;
}

/* Timeline */
.timeline-modern {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.timeline-modern-item {
    display: flex;
    gap: 1.5rem;
    position: relative;
}

.timeline-modern-item::after {
    content: '';
    position: absolute;
    left: 17px;
    top: 35px;
    bottom: -20px;
    width: 2px;
    background: #f1f5f9;
}

.timeline-modern-item:last-child::after {
    display: none;
}

.timeline-icon {
    width: 36px;
    height: 36px;
    background: white;
    border: 2px solid #e2e8f0;
    border-radius: 50%;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    transition: all 0.3s;
}

.timeline-modern-item.active .timeline-icon {
    border-color: #4338ca;
    color: #4338ca;
    box-shadow: 0 0 0 6px rgba(67, 56, 202, 0.05);
}

.timeline-content h4 {
    margin: 0 0 0.5rem;
    color: #334155;
    font-size: 1rem;
    font-weight: 700;
}

.timeline-content p {
    margin: 0;
    color: #94a3b8;
    font-size: 0.85rem;
}

/* Technologies */
.tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
}

.tech-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 1rem;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transition: all 0.3s;
}

.tech-item:hover {
    background: white;
    border-color: #4338ca;
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
}

.tech-item i {
    font-size: 1.5rem;
    color: #4338ca;
}

.tech-item span {
    font-weight: 700;
    font-size: 0.85rem;
    color: #1e293b;
}

/* Depot Section Redesign */
.depots-section {
    margin-top: 2rem;
}

.depots-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #f1f5f9;
}

.btn-new-depot {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: white;
    text-decoration: none;
    padding: 0.8rem 1.75rem;
    border-radius: 14px;
    font-weight: 700;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-new-depot:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(99, 102, 241, 0.3);
    color: white;
}

.depot-grid {
    display: grid;
    gap: 1.25rem;
}

.depot-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: white;
    padding: 1.25rem;
    border-radius: 20px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.depot-item:hover {
    transform: translateX(10px);
    border-color: #4338ca;
    box-shadow: 0 10px 25px rgba(67, 56, 202, 0.08);
}

.depot-info-wrapper {
    display: flex;
    align-items: center;
    gap: 1.25rem;
}

.depot-type-icon {
    width: 50px;
    height: 50px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
}

.type-code { background: #eff6ff; color: #3b82f6; }
.type-document { background: #fff1f2; color: #f43f5e; }
.type-presentation { background: #fff7ed; color: #f97316; }
.type-rapport { background: #f0fdf4; color: #22c55e; }

.depot-details-text h4 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
}

.depot-sub-info {
    font-size: 0.85rem;
    color: #94a3b8;
    display: flex;
    gap: 1rem;
    align-items: center;
}

.depot-status-pill {
    padding: 0.35rem 0.85rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
}

/* Sidebar Styling */
.sidebar-sticky {
    position: sticky;
    top: 2rem;
}

.stat-box {
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
    border-radius: 24px;
    color: white;
    margin-bottom: 2rem;
    box-shadow: 0 20px 40px rgba(67, 56, 202, 0.2);
}

.stat-number {
    font-size: 3rem;
    font-weight: 800;
    display: block;
    line-height: 1;
    margin-bottom: 0.5rem;
}

.stat-label {
    font-size: 0.9rem;
    opacity: 0.8;
    font-weight: 600;
}

.info-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.info-row {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid #f1f5f9;
}

.info-row:last-child {
    border-bottom: none;
}

.row-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #64748b;
    font-weight: 500;
}

.row-value {
    color: #0f172a;
    font-weight: 700;
}

/* Animations */
@keyframes slideUp {
    from { transform: translateY(30px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

.project-info-card {
    animation: slideUp 0.6s ease-out forwards;
}

/* Action Buttons */
.action-buttons {
    display: flex;
    gap: 0.75rem;
    align-items: center;
}

.btn-action {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: none;
    cursor: pointer;
    text-decoration: none;
}

.btn-download {
    background: #eff6ff;
    color: #3b82f6;
}

.btn-download:hover {
    background: #3b82f6;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(59, 130, 246, 0.3);
}

.btn-edit {
    background: #fff7ed;
    color: #f97316;
}

.btn-edit:hover {
    background: #f97316;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(249, 115, 22, 0.3);
}

.btn-delete {
    background: #fff1f2;
    color: #f43f5e;
}

.btn-delete:hover {
    background: #f43f5e;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(244, 63, 94, 0.3);
}

/* Responsive */
@media (max-width: 1024px) {
    .project-detail-container {
        grid-template-columns: 1fr;
        margin-top: -2rem;
    }
    .project-header {
        flex-direction: column;
        align-items: flex-start;
    }
    .project-title-section h1 {
        font-size: 2.5rem;
    }
}

@media (max-width: 640px) {
    .depot-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
    }
    .depot-actions {
        width: 100%;
        display: flex;
        justify-content: flex-end;
    }
}

</style>
{% endblock %}

{% block student_content %}
<!-- Hero Section -->
<section class="project-detail-hero">
    <div class="hero-background"></div>
    <div class="hero-content">
        <div class="breadcrumb">
            <a href="{{ path('app_student_projects') }}"><i class="fas fa-chevron-left"></i> Retour</a>
            <span>/</span>
            <a href="{{ path('app_student_projects') }}">Projets</a>
            <span>/</span>
            <span>{{ project.title }}</span>
        </div>
        
        <div class="project-header">
            <!-- AI Header Image -->
            {% if project.generatedImage %}
            <div style="margin-bottom: 2rem; border-radius: 24px; overflow: hidden; border: 2px solid rgba(255,255,255,0.2); box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
                <img src="{{ project.generatedImage }}" id="projectLogoImg" style="width: 100%; height: 250px; object-fit: cover;" alt="Project Logo">
            </div>
            {% endif %}
            
            <div class="project-title-section">
                <h1>{{ project.title }}</h1>
                <div class="project-meta-badges">
                    <span class="project-badge badge-category">
                        <i class="fas fa-folder-open"></i> {{ project.category }}
                    </span>
                    <span class="project-badge badge-status">
                        <i class="fas fa-circle-check"></i> {{ project.status }}
                    </span>
                    <span class="project-badge" title="{{ project.difficulty }}" style="background: rgba{% if project.difficulty == 'Débutant' %}4, 120, 87, 0.15{% elseif project.difficulty == 'Intermédiaire' %}29, 78, 216, 0.15{% else %}124, 58, 237, 0.15{% endif %}); color: {% if project.difficulty == 'Débutant' %}#34d399{% elseif project.difficulty == 'Intermédiaire' %}#60a5fa{% else %}#a78bfa{% endif %}; border-color: rgba(255,255,255,0.1);">
                        <i class="fas {% if project.difficulty == 'Débutant' %}fa-leaf{% elseif project.difficulty == 'Intermédiaire' %}fa-bolt{% else %}fa-trophy{% endif %}"></i>
                        {{ project.difficulty }}
                    </span>
                </div>
            </div>
            
            <div class="project-actions-header">
                <button class="btn-join-hero" {{ project.status == 'Complet' ? 'disabled' : '' }} onclick="applyToProject()">
                    <i class="fas fa-paper-plane"></i> Rejoindre l'aventure
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<div class="project-detail-container">
    <!-- Left Column -->
    <div class="card-stack">
        <!-- Automatic Summary Section (Premium Gradient) -->
        {% if project.summary or project.description %}
        <div class="project-info-card summary-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <h2 class="section-title" style="margin-bottom: 0;"><i class="fas fa-sparkles"></i> Essence du Projet</h2>
                <button onclick="generateLogo({{ project.id }})" class="btn-new-depot" id="genLogoBtn" style="background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%); font-size: 0.85rem; padding: 0.6rem 1.2rem; border: none; cursor: pointer;">
                    <i class="fas fa-paint-brush"></i> Générer Logo (IA)
                </button>
            </div>
            <div class="project-description" id="ai-summary-container" style="color: #4338ca; font-weight: 500; font-style: italic;">
                <div id="ai-summary-loading" style="display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-spinner fa-spin" style="color: #7c3aed;"></i>
                    <span style="color: #64748b;">Génération du résumé intelligent en cours...</span>
                </div>
                <div id="ai-summary-text" style="display: none;"></div>
            </div>
        </div>
        {% endif %}

        <div class="project-info-card">
            <h2 class="section-title"><i class="fas fa-align-left"></i> À propos du projet</h2>
            <div class="project-description">
                {{ project.description }}
            </div>
        </div>

        <!-- Tech Stack -->
        <div class="project-info-card">
            <h2 class="section-title"><i class="fas fa-microchip"></i> Stack Technique</h2>
            <div class="tech-grid">
                {% for tech in project.technologies %}
                <div class="tech-item">
                    <i class="fab fa-{{ tech|lower == 'php' ? 'php' : (tech|lower == 'symfony' ? 'symfony' : (tech|lower == 'js' or tech|lower == 'javascript' ? 'js' : 'terminal')) }}"></i>
                    <span>{{ tech }}</span>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Roadmap -->
        <div class="project-info-card">
            <h2 class="section-title"><i class="fas fa-route"></i> Roadmap</h2>
            <div class="timeline-modern">
                <div class="timeline-modern-item">
                    <div class="timeline-icon"><i class="fas fa-flag"></i></div>
                    <div class="timeline-content">
                        <h4>Lancement</h4>
                        <p>Initié le {{ project.created_at }}</p>
                    </div>
                </div>
                <div class="timeline-modern-item active">
                    <div class="timeline-icon"><i class="fas fa-code"></i></div>
                    <div class="timeline-content">
                        <h4>Phase active</h4>
                        <p>Débuté le {{ project.start_date }}</p>
                    </div>
                </div>
                {% if project.end_date %}
                <div class="timeline-modern-item">
                    <div class="timeline-icon"><i class="fas fa-trophy"></i></div>
                    <div class="timeline-content">
                        <h4>Livraison finale</h4>
                        <p>Prévue pour le {{ project.end_date }}</p>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Dépôts Section -->
        <div class="depots-section">
            <div class="depots-header">
                <h2 class="section-title" style="margin-bottom: 0;"><i class="fas fa-box-open"></i> Livrables & Dépôts</h2>
                <a href="{{ path('app_student_depot_new', {id: project.id}) }}" class="btn-new-depot">
                    <i class="fas fa-plus"></i> Nouveau Dépôt
                </a>
            </div>
            
            <div class="depot-grid" style="margin-top: 2rem;">
                {% for depot in depots %}
                <div class="depot-item">
                    <div class="depot-info-wrapper">
                        <div class="depot-type-icon type-{{ depot.type }}">
                            <i class="fas {{ depot.getTypeIcon() }}"></i>
                        </div>
                        <div class="depot-details-text">
                            <h4>{{ depot.title }}</h4>
                            <div class="depot-sub-info">
                                <span><i class="far fa-calendar"></i> {{ depot.uploadedAt|date('d M Y') }}</span>
                                <span><i class="far fa-user"></i> {{ depot.studentName }}</span>
                                <span><i class="fas fa-file-invoice"></i> {{ depot.getFormattedFileSize() }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="depot-actions">
                        <span class="depot-status-pill depot-status-{{ depot.type == 'rapport' ? 'valid' : 'pending' }}">
                            {{ depot.type|capitalize }}
                        </span>
                        <div class="action-buttons" style="margin-left: 1.5rem;">
                            <a href="{{ asset('uploads/depots/' ~ depot.filePath) }}" class="btn-action btn-download" title="Télécharger">
                                <i class="fas fa-download"></i>
                            </a>
                            <a href="{{ path('app_student_depot_edit', {'id': depot.id}) }}" class="btn-action btn-edit" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="POST" action="{{ path('app_student_depot_delete', {'id': depot.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depot.id) }}">
                                <button type="submit" class="btn-action btn-delete" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                {% else %}
                <div style="text-align: center; padding: 4rem; background: #fff; border-radius: 24px; border: 2px dashed #e2e8f0;">
                    <i class="fas fa-cloud-upload-alt" style="font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem;"></i>
                    <p style="color: #94a3b8; font-weight: 600;">Aucun livrable déposé pour le moment.</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Right Column (Sidebar) -->
    <div class="project-sidebar">
        <div class="sidebar-sticky">
            <div class="stat-box">
                <span class="stat-number">{{ project.members }}/{{ project.max_members }}</span>
                <span class="stat-label">Équipiers engagés</span>
            </div>

            <div class="project-info-card" style="padding: 2rem;">
                <h3 class="section-title" style="font-size: 1.1rem; margin-bottom: 1.5rem;"><i class="fas fa-info-circle"></i> Spécifications</h3>
                <div class="info-list">
                    <div class="info-row">
                        <div class="row-label"><i class="fas fa-user-tie"></i> Responsable</div>
                        <div class="row-value">{{ project.lead }}</div>
                    </div>
                    <div class="info-row">
                        <div class="row-label"><i class="far fa-calendar-check"></i> Créé le</div>
                        <div class="row-value">{{ project.created_at }}</div>
                    </div>
                    <div class="info-row">
                        <div class="row-label"><i class="far fa-clock"></i> Durée</div>
                        <div class="row-value">{{ project.duration }}</div>
                    </div>
                </div>

                <div style="margin-top: 2.5rem;">
                    <h3 class="section-title" style="font-size: 1.1rem; margin-bottom: 1rem;"><i class="fas fa-tasks"></i> Progression</h3>
                    <div style="height: 12px; background: #f1f5f9; border-radius: 6px; overflow: hidden; position: relative;">
                        <div style="width: 45%; height: 100%; background: linear-gradient(to right, #4338ca, #6d28d9); border-radius: 6px;"></div>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-top: 0.75rem; font-size: 0.85rem; font-weight: 700; color: #64748b;">
                        <span>En cours</span>
                        <span>45%</span>
                    </div>
                </div>
            </div>

            <!-- Team Section -->
            <div class="project-info-card" style="margin-top: 2rem; padding: 2rem;">
                <h3 class="section-title" style="font-size: 1.1rem; margin-bottom: 1.5rem;"><i class="fas fa-users-crown"></i> L'Équipe</h3>
                <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <img src="https://ui-avatars.com/api/?name={{ project.lead }}&background=4338ca&color=fff&bold=true" style="width: 44px; height: 44px; border-radius: 12px;" alt="">
                        <div>
                            <div style="font-weight: 700; color: #1e293b; font-size: 0.95rem;">{{ project.lead }}</div>
                            <div style="font-size: 0.8rem; color: #94a3b8;">Chef de projet</div>
                        </div>
                    </div>
                    {% if project.members < project.max_members %}
                    <div style="display: flex; align-items: center; gap: 1rem; opacity: 0.7; cursor: pointer;" onclick="applyToProject()">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #cbd5e1;">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div style="font-style: italic; color: #94a3b8; font-size: 0.9rem;">Place disponible - Rejoindre ?</div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function applyToProject() {
    const btn = document.querySelector('.btn-join-hero');
    if (btn && btn.disabled) return;

    if (confirm("Voulez-vous postuler pour rejoindre ce projet ?")) {
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Envoi...';
        }
        
        setTimeout(() => {
            alert("Votre candidature a été envoyée !");
            if (btn) {
                btn.innerHTML = '<i class="fas fa-check"></i> Postulé';
                btn.style.background = '#10b981';
                btn.style.color = 'white';
            }
        }, 1000);
    }
}

async function generateLogo(projectId) {
    const btn = document.getElementById('genLogoBtn');
    
    if (!confirm('Voulez-vous générer un logo pour ce projet via l\'IA ?')) return;
    
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Génération...';
    
    try {
        const response = await fetch(`/student/project/${projectId}/generate-logo`, {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            location.reload();
        } else {
            alert('Erreur: ' + (data.error || 'Une erreur inconnue est survenue'));
        }
    } catch (error) {
        console.error('JS Error:', error);
        alert('Erreur: ' + error.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paint-brush"></i> Générer Logo (IA)';
    }
}

// Flash messages auto-hide
setTimeout(() => {
    document.querySelectorAll('.alert').forEach(alert => {
        alert.style.opacity = '0';
        setTimeout(() => alert.remove(), 500);
    });
}, 5000);

// ============================================================
// AI-POWERED INTELLIGENT SUMMARY GENERATOR
// ============================================================
(function() {
    const projectData = {
