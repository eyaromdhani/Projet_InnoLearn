    // Find best matching link for a project title
    function findSoftwareLink(title) {
        title = title.toLowerCase().trim();
        // Exact match first
        if (softwareLinks[title]) return softwareLinks[title];
        // Partial match: check if title contains a known keyword
        for (const [key, url] of Object.entries(softwareLinks)) {
            if (title.includes(key) || key.includes(title)) return url;
        }
        // Default: Google search for download
        return 'https://www.google.com/search?q=' + encodeURIComponent(title + ' download installer');
    }

    // Assign links to all Lien buttons
    document.querySelectorAll('.lien-btn').forEach(btn => {
        const title = btn.getAttribute('data-title');
        const link = findSoftwareLink(title);
        btn.href = link;
    });
});
