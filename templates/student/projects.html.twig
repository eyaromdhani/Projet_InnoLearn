    const originalBtn = event.currentTarget;
    const originalText = originalBtn.innerHTML;
    originalBtn.disabled = true;
    originalBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Génération...';

    try {
        const response = await fetch('/student/ai/suggest-metadata', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ keywords, type })
        });
        
        const data = await response.json();
        
        if (data.error) {
            alert('Erreur: ' + data.error);
        } else {
            // Dans cette version démo/statique, on montre le résultat
            // Dans une vraie app, on remplirait les champs du formulaire réel
            alert(`✨ Suggestions de l'IA :\n\nTitre suggéré: ${data.title}\n\nDescription suggérée: ${data.description}\n\nAppliqué à la simulation !`);
        }
    } catch (error) {
        console.error('Erreur AI:', error);
        alert('Erreur lors de la communication avec le service AI.');
    } finally {
        originalBtn.disabled = false;
        originalBtn.innerHTML = originalText;
    }
}

