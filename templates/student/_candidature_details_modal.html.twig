<div class="modal-header" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;">
        <div>
            <span class="status-badge status-{{ candidature.statut }}" style="margin-bottom: 0.5rem; display: inline-flex;">
                <i class="fas fa-circle"></i> {{ candidature.statut|capitalize }}
            </span>
            <h2 style="font-size: 2rem; font-weight: 800; color: #1e293b; margin: 0;">{{ candidature.titre }}</h2>
            <p style="color: #64748b; font-size: 1.1rem; margin-top: 0.5rem;">
                <i class="fas fa-folder" style="color: #6366f1;"></i> {{ candidature.domaine }}
            </p>
        </div>
        <button class="close-modal" onclick="closeCandidatureDetailsModal()" style="background: #f1f5f9; border: none; width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #64748b; transition: all 0.2s;">
            <i class="fas fa-times"></i>
        </button>
    </div>
</div>

<div class="modal-body" style="display: grid; grid-template-columns: 2fr 1fr; gap: 3rem;">
    <!-- Left Column: Description & Competences -->
    <div class="modal-main-content">
        <div style="margin-bottom: 2.5rem;">
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #1e293b; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem;">
                <i class="fas fa-align-left" style="color: #6366f1;"></i> Ma Présentation
            </h3>
            <div style="line-height: 1.7; color: #475569; font-size: 1.05rem;">
                {{ candidature.description|nl2br }}
            </div>
        </div>

        <div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #1e293b; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem;">
                <i class="fas fa-tools" style="color: #6366f1;"></i> Mes Compétences
            </h3>
            <div style="line-height: 1.7; color: #475569; font-size: 1.05rem;">
                {{ candidature.competences|nl2br }}
            </div>
        </div>
    </div>

    <!-- Right Column: Info Sidebar -->
    <div class="modal-sidebar">
        <div style="background: #f8fafc; border-radius: 20px; padding: 1.5rem; border: 1px solid #e2e8f0;">
            <h4 style="font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: 1.25rem;">Informations</h4>
            
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem; color: #64748b;">
                    <i class="fas fa-calendar-alt" style="width: 20px; color: #6366f1;"></i>
                    <span>Envoyé le {{ candidature.datePublication|date('d/m/Y') }}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.75rem; color: #64748b;">
                    <i class="fas fa-id-card" style="width: 20px; color: #6366f1;"></i>
                    <span>ID : #{{ candidature.id }}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.75rem; color: #64748b;">
                    <i class="fas fa-paperclip" style="width: 20px; color: #6366f1;"></i>
                    <a href="#" style="color: #6366f1; text-decoration: none; font-weight: 600;">Voir mon CV</a>
                </div>
            </div>

            <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 1.5rem 0;">
            
            <div style="text-align: center;">
                <p style="font-size: 0.85rem; color: #94a3b8; font-weight: 500;">
                    Statut actuel : <span style="color: #1e293b;">{{ candidature.statut|capitalize }}</span>
                </p>
            </div>
        </div>
    </div>
</div>
