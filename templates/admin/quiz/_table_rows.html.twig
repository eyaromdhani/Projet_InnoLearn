{% for formulaire in formulaires|default([]) %}
    <tr>
        <td class="text-center text-muted">#{{ formulaire.id }}</td>
        <td>{{ formulaire.titre }}</td>
        <td>{{ formulaire.description|u.truncate(50, '...') }}</td>
        <td>{{ formulaire.tempsLimite ?: 'N/A' }}</td>
        <td>{{ formulaire.category }}</td>
        <td class="text-center">
            <!-- Manage Questions button -->
            <a href="{{ path('app_formulaire_questions', {'id': formulaire.id}) }}"
               class="btn btn-action"
               style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;"
               title="Voir / Gérer Questions"
               data-bs-toggle="tooltip">
                <i class="fas fa-list-check"></i>
            </a>

            <!-- Edit button -->
            <a href="{{ path('admin_quiz_edit', {'id': formulaire.id}) }}"
               class="btn btn-action"
               style="background: #fffbeb; color: #b45309; border: 1px solid #fde68a;"
               title="Modifier"
               data-bs-toggle="tooltip">
                <i class="fas fa-pen-to-square"></i>
            </a>

            <!-- Delete button -->
            {{ include('admin/quiz/_delete_form.html.twig', {'formulaire': formulaire}) }}
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="6" class="text-center py-3">Aucun quiz trouvé.</td>
    </tr>
{% endfor %}
