        <div class="file-upload-wrapper">
            {{ form_widget(form.cv, {'attr': {'style': 'position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 10;' }}) }}
            <div id="cv-surrogate" class="file-upload-surrogate">
                <div class="file-upload-icon">
                    <i class="fas fa-file-upload"></i>
                </div>
                <div class="file-upload-text">
                    <div id="cv-filename" class="file-upload-filename">Choisir un fichier PDF...</div>
                    <div class="file-upload-info">Taille maximale : 5 Mo</div>
