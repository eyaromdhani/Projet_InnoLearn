        'figma': 'un outil de design collaboratif en ligne',
        'arduino': 'une plateforme de prototypage électronique accessible',
        'raspberry': 'un micro-ordinateur pour les projets IoT et embarqués',
        'aws': 'la plateforme cloud leader avec 200+ services',
        'azure': 'le cloud de Microsoft pour les applications d\'entreprise',
        'firebase': 'une plateforme backend-as-a-service de Google',
        'go': 'un langage performant et concurrent de Google',
        'rust': 'un langage système alliant performance et sécurité mémoire',
        'r': 'un langage dédié à l\'analyse statistique et la visualisation'
    };

    // Difficulty descriptions
    const difficultyMap = {
        'Débutant': { emoji: '🌱', desc: 'accessible aux débutants, ce projet offre une excellente opportunité d\'apprentissage avec un accompagnement structuré' },
        'Intermédiaire': { emoji: '⚡', desc: 'conçu pour les développeurs ayant une base solide, ce projet permet d\'approfondir ses compétences techniques' },
        'Avancé': { emoji: '🏆', desc: 'destiné aux profils expérimentés, ce projet présente des défis techniques stimulants et des problématiques complexes' },
        'Expert': { emoji: '💎', desc: 'réservé aux experts, ce projet repousse les limites de l\'innovation avec des technologies de pointe' }
    };

    function detectDomain(title, desc, category) {
        const text = (title + ' ' + desc + ' ' + category).toLowerCase();
        const domainKeywords = {
            'web': ['web', 'site', 'portail', 'html', 'css', 'frontend', 'backend', 'api', 'rest', 'crud', 'application web'],
            'mobile': ['mobile', 'android', 'ios', 'smartphone', 'appli', 'application mobile', 'tablette'],
            'data': ['data', 'données', 'analyse', 'dashboard', 'statistique', 'bi', 'reporting', 'visualisation'],
            'ia': ['ia', 'intelligence artificielle', 'machine learning', 'deep learning', 'nlp', 'chatbot', 'prediction', 'neural'],
            'iot': ['iot', 'capteur', 'embarqué', 'arduino', 'raspberry', 'connecté', 'domotique', 'sensor'],
            'securite': ['sécurité', 'securite', 'cyber', 'cryptage', 'firewall', 'authentification', 'pentest'],
            'devops': ['devops', 'ci/cd', 'docker', 'kubernetes', 'deploy', 'pipeline', 'automatisation'],
            'jeux': ['jeu', 'game', 'unity', 'unreal', 'godot', '3d', '2d', 'joueur', 'gaming'],
            'blockchain': ['blockchain', 'smart contract', 'crypto', 'decentralis', 'ethereum', 'solidity', 'nft'],
            'cloud': ['cloud', 'aws', 'azure', 'gcp', 'serverless', 'microservice', 'saas'],
            'design': ['design', 'ui', 'ux', 'maquette', 'figma', 'prototype', 'interface', 'graphisme'],
            'education': ['education', 'éducatif', 'educatif', 'apprentissage', 'e-learning', 'formation', 'tutoriel', 'cours', 'pédagogique']
        };

        let bestDomain = null;
        let bestScore = 0;
        for (const [domain, keywords] of Object.entries(domainKeywords)) {
            let score = 0;
            keywords.forEach(kw => { if (text.includes(kw)) score++; });
            if (score > bestScore) { bestScore = score; bestDomain = domain; }
        }
        return bestDomain || 'web';
    }

    function extractKeyActions(desc) {
        const actionPatterns = [
            { pattern: /crud/i, action: 'la gestion complète des données (CRUD)' },
            { pattern: /authentification|login|connexion/i, action: 'un système d\'authentification sécurisé' },
            { pattern: /api|rest|graphql/i, action: 'des services API modernes' },
            { pattern: /dashboard|tableau de bord/i, action: 'un tableau de bord interactif' },
            { pattern: /chat|messagerie|message/i, action: 'un système de messagerie en temps réel' },
            { pattern: /recherche|search|filtre/i, action: 'un moteur de recherche intelligent' },
            { pattern: /paiement|payment|stripe/i, action: 'l\'intégration de paiements en ligne' },
            { pattern: /notification|alerte/i, action: 'un système de notifications' },
            { pattern: /upload|fichier|import/i, action: 'la gestion de fichiers et uploads' },
            { pattern: /rapport|report|pdf|export/i, action: 'la génération de rapports' },
            { pattern: /carte|map|géolocalisation/i, action: 'l\'intégration cartographique' },
            { pattern: /image|photo|galerie|média/i, action: 'la gestion multimédia' },
            { pattern: /email|mail|newsletter/i, action: 'l\'envoi d\'emails automatisés' },
            { pattern: /blog|article|contenu/i, action: 'un système de gestion de contenu' },
            { pattern: /commentaire|avis|review/i, action: 'un système de commentaires et avis' },
            { pattern: /reservation|booking|rendez/i, action: 'un système de réservation' },
            { pattern: /stock|inventaire|produit/i, action: 'la gestion d\'inventaire' },
            { pattern: /metier|métier/i, action: 'la modélisation de processus métier' }
        ];
        return actionPatterns.filter(p => p.pattern.test(desc)).map(p => p.action);
    }

    function generateSummary() {
        const { title, description, category, status, difficulty, technologies, lead } = projectData;
        const domain = detectDomain(title, description, category);
        const domainInfo = domainKnowledge[domain];
        const diffInfo = difficultyMap[difficulty] || difficultyMap['Intermédiaire'];
        const keyActions = extractKeyActions(description);

        // Build tech insights
        let techParts = [];
        if (technologies && technologies.length > 0) {
            technologies.forEach(tech => {
                const key = tech.toLowerCase().trim();
                if (techInsights[key]) {
                    techParts.push(`<strong>${tech}</strong> (${techInsights[key]})`);
                } else {
                    techParts.push(`<strong>${tech}</strong>`);
                }
            });
        }

        // Compose the summary paragraphs
        let paragraphs = [];

        // §1 — Opening: Domain + Goal
        paragraphs.push(
            `${domainInfo.icon} <strong>"${title}"</strong> est un projet de <strong>${domainInfo.label}</strong> ` +
            `dans la catégorie <em>${category}</em>, piloté par <strong>${lead}</strong>. ` +
            `Son objectif principal : ${domainInfo.goal}.`
        );

        // §2 — Difficulty + Pedagogical value
        paragraphs.push(
            `${diffInfo.emoji} <strong>Niveau ${difficulty}</strong> — ${diffInfo.desc}.`
        );

        // §3 — Tech stack analysis
        if (techParts.length > 0) {
            paragraphs.push(
                `🛠️ <strong>Stack technique :</strong> Ce projet s'appuie sur ${techParts.join(', ')}, ` +
                `offrant une expérience pratique avec des outils utilisés en production.`
            );
        }

        // §4 — Key features detected
        if (keyActions.length > 0) {
            const featureList = keyActions.slice(0, 5).join(', ');
            paragraphs.push(
                `🎯 <strong>Fonctionnalités clés identifiées :</strong> ${featureList}. ` +
                `Ces éléments constituent le cœur fonctionnel du projet.`
            );
        }

        // §5 — Competencies gained
        if (domainInfo.skills.length > 0) {
            paragraphs.push(
                `📈 <strong>Compétences développées :</strong> ${domainInfo.skills.join(', ')}. ` +
                `Ce projet est une opportunité concrète pour enrichir son portfolio professionnel.`
            );
        }

        return paragraphs.map(p => `<p style="margin-bottom: 0.85rem; line-height: 1.7;">${p}</p>`).join('');
    }

    // Simulate AI generation with typewriter-like reveal
    setTimeout(() => {
        const loading = document.getElementById('ai-summary-loading');
        const textEl = document.getElementById('ai-summary-text');
        if (!loading || !textEl) return;

        const summary = generateSummary();
        loading.style.display = 'none';
        textEl.innerHTML = summary;
        textEl.style.display = 'block';
        textEl.style.opacity = '0';
        textEl.style.transform = 'translateY(10px)';
        textEl.style.transition = 'all 0.6s ease-out';
