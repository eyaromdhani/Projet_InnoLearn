            <div class="custom-dropdown" id="candidatureSortDropdown">
                <div class="dropdown-toggle">
                    <i class="fas fa-sort-amount-down"></i>
                    <span class="selected-value">{{ current_filters.sort == 'asc' ? 'Plus anciens' : 'Plus récents' }}</span>
                    <i class="fas fa-chevron-down arrow"></i>
                </div>
                <div class="dropdown-options">
                    <div class="dropdown-opt {{ current_filters.sort == 'desc' or current_filters.sort is empty ? 'active' : '' }}" data-value="desc">Plus récents</div>
                    <div class="dropdown-opt {{ current_filters.sort == 'asc' ? 'active' : '' }}" data-value="asc">Plus anciens</div>
